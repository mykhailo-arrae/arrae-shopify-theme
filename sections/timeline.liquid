{% liquid
  assign blocks = section.blocks
  assign block_count = blocks.size
  assign heading = section.settings.heading

  assign default_position_raw = section.settings.default_expanded_card_position
  assign default_active = 0
  if default_position_raw != blank
    assign default_position = default_position_raw | plus: 0
    if default_position >= 1 and default_position <= block_count
      assign default_active = default_position | minus: 1
    endif
  endif
%}

{% unless heading == blank %}
  <div
    class="tvg_timeline_3Iv5NG_root"
    data-timeline
    data-default-active="{{ default_active }}"
  >
    <div class="tvg_timeline_3Iv5NG_intro">
      <div class="tvg_timeline_3Iv5NG_heading" role="heading" aria-level="2">
        {{ heading }}
