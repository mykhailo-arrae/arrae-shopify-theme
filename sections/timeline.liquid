      {% endif %}
    </div>

    <div
      class="tvg_timeline_3Iv5NG_timeline"
      data-timeline-track
      data-stack="false"
      data-card-count="{{ block_count }}"
    >
      {% for block in blocks %}
        {% liquid
          assign is_active = false
          if forloop.index0 == default_active
            assign is_active = true
          endif

          assign desktop_image = block.settings.image_desktop
          assign mobile_image = block.settings.image_mobile
          assign hover_image = block.settings.image_hover

          assign has_image = false
          if desktop_image != blank or mobile_image != blank
            assign has_image = true
          endif
        %}

        <div
          class="tvg_timeline_3Iv5NG_card"
          data-timeline-card
          data-index="{{ forloop.index0 }}"
          {% if is_active %}
            data-active="true"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <h3 class="tvg_timeline_3Iv5NG_card-heading">
            <div class="tvg_timeline_3Iv5NG_trigger">
              <span class="tvg_timeline_3Iv5NG_header-row">
                <span class="tvg_timeline_3Iv5NG_step-group">
                  {% if block.settings.step_indicator != blank %}
                    <span class="tvg_timeline_3Iv5NG_step-indicator" aria-hidden="true">
                      {{- block.settings.step_indicator -}}
                    </span>
                  {% endif %}
                  {% if block.settings.period != blank %}
                    <span class="tvg_timeline_3Iv5NG_period">{{ block.settings.period }}</span>
                  {% endif %}
                </span>
                {% if block.settings.eyebrow != blank %}
                  <span class="tvg_timeline_3Iv5NG_eyebrow">{{ block.settings.eyebrow }}</span>
                {% endif %}
              </span>
            </div>
