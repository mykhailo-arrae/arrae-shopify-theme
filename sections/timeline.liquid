                    data-has-hover="true"
                  {% endif %}
                >
                  {% render 'core-image',
                    image: desktop_image,
                    image_mobile: mobile_image,
                    mode: 'cover',
                    object_fit: 'cover',
                    lazyload: true,
                    sizes: '(min-width: 1280px) 30vw, 90vw',
                    srcset_print_sizes: '320,480,640',
                    mobile_srcset_print_sizes: '320,480,640'
