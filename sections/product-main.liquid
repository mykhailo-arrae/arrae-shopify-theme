{% liquid
  # Mirror product-gallery initial resolution for the images-column gate.
  assign gallery_initial_variant = product.selected_variant | default: null

  if gallery_initial_variant == null
    for variant in product.variants reversed
      assign hide_on_front_end = variant.metafields.custom.hide_on_front_end.value | default: false, allow_false: true
      unless hide_on_front_end
        if variant.available
          assign gallery_initial_variant = variant
          break
        endif
      endunless
    endfor
  endif

  if gallery_initial_variant == null
    assign gallery_initial_variant = product.selected_or_first_available_variant
  endif

  assign gallery_default_images = product.metafields.custom.pdp_gallery_images.value

  if gallery_default_images == blank
    assign gallery_default_images = product.images
  endif

  assign gallery_initial_override = null
  if gallery_initial_variant != blank
    assign gallery_initial_override = gallery_initial_variant.metafields.custom.variant_gallery_set.value | default: null
  endif

  assign product_gallery_has_media = false
  if gallery_initial_override != blank or gallery_default_images.size > 0 or product.metafields.custom.pdp_gallery_featured_media.value != blank
    assign product_gallery_has_media = true
  endif

  # Buy-box overrides: section settings win when non-blank; else product / metafield.
  # Defaults are not wired via product.json dynamic sources — several setting types
  # (metaobject_list, nested metaobject fields) reject those bindings.
  assign resolved_title = section.settings.title | default: product.title

  assign resolved_description = product.description
  if section.settings.description != blank and section.settings.description != '<p></p>'
    assign resolved_description = section.settings.description
  endif

  assign resolved_pdp_subtitle = blank
  if section.settings.pdp_subtitle != blank and section.settings.pdp_subtitle != '<p></p>'
    assign resolved_pdp_subtitle = section.settings.pdp_subtitle
  elsif product.metafields.custom.pdp_subtitle != blank
    assign resolved_pdp_subtitle = product.metafields.custom.pdp_subtitle | metafield_tag
  endif

  assign resolved_hide_reviews = product.metafields.custom.hide_reviews_summary.value | default: false, allow_false: true
  if section.settings.review_summary_visibility == 'show'
    assign resolved_hide_reviews = false
  elsif section.settings.review_summary_visibility == 'hide'
    assign resolved_hide_reviews = true
  endif

  assign resolved_benefits = null
  if section.settings.benefits_list != blank
    assign resolved_benefits = section.settings.benefits_list | newline_to_br | split: '<br />'
  else
    assign resolved_benefits = product.metafields.custom.pdp_benefits_list.value | default: null
  endif

  assign resolved_accordions = section.settings.product_accordions | default: product.metafields.custom.pdp_product_accordions

  assign resolved_upsell_title = section.settings.upsell_title | default: blank
  if resolved_upsell_title == '<p></p>'
    assign resolved_upsell_title = blank
  endif
  assign resolved_upsell_products = section.settings.upsell_products | default: blank
  assign resolved_upsell_info_label = section.settings.upsell_info_label | default: blank
  assign resolved_upsell_info_text = section.settings.upsell_info_text | default: blank
%}

<div class="tvg_product_main_8lGbjW_Product-container">
  <div class="tvg_product_main_8lGbjW_Product-sections {% unless product_gallery_has_media %}  {% endunless %}">
    {% if product_gallery_has_media %}
      <section class=" tvg_product_main_8lGbjW_Product-section--images">
        {% render 'product-gallery' %}
      </section>
    {% endif %}

    <section class=" tvg_product_main_8lGbjW_Product-section--details">
      {% render 'product-details',
        title: resolved_title,
        description: resolved_description,
        pdp_subtitle: resolved_pdp_subtitle,
        hide_reviews: resolved_hide_reviews,
        benefits_list: resolved_benefits
      %}
      {% render 'product-accordion', items: resolved_accordions %}
      {% render 'product-upsells',
        title: resolved_upsell_title,
        products: resolved_upsell_products,
        info_label: resolved_upsell_info_label,
        info_text: resolved_upsell_info_text,
        content: product.metafields.custom.pdp_product_upsells
      %}
    </section>
