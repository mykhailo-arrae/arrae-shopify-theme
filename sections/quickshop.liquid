{% liquid
  assign has_product = false
  if product != blank and product.id != blank
    assign has_product = true
  endif

  if has_product
    assign resolved_title = product.title

    assign collection_display = product.metafields.custom.smp_display_override.value | default: null
    assign resolved_description = collection_display.short_description | default: product.metafields.custom.product_card_marketing_copy.value | default: product.metafields.custom_fields.collection_short_description.value | default: product.description
    assign resolved_description = resolved_description | strip_html

    assign resolved_hide_reviews = product.metafields.custom.hide_reviews_summary.value | default: false, allow_false: true
  endif
%}

