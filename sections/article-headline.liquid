{% liquid
  assign subtitle = article.metafields.custom.subtitle.value | default: null
  assign tag = article.tags | first | default: null
  assign title_split = article.title | split: '|'
  assign title_first = title_split[0]
  assign title_second = title_split[1] | default: null

  if article.excerpt != blank
    assign excerpt = article.excerpt
  endif
%}

<div class="tvg_article_headline_Kuo1xa_breadcrumbs">
  {% render 'breadcrumbs' %}
</div>

<div class="tvg_article_headline_Kuo1xa_section">
  <div class="tvg_article_headline_Kuo1xa_container">
    {% if article.image != blank %}
      <div class="tvg_article_headline_Kuo1xa_media">
        {% render 'core-image',
          image: article.image,
          mode: 'cover',
          object_fit: 'cover',
          preload: true,
          lazyload: false,
          class: 'tvg_article_headline_Kuo1xa_image',
          srcset_print_sizes: '480,640,800,960,1024,1280,1440',
          mobile_srcset_print_sizes: '320,480,640'
        %}
      </div>
    {% endif %}

    <div class="tvg_article_headline_Kuo1xa_content">
      {% if article.title != blank %}
        <h1 class="tvg_article_headline_Kuo1xa_title">
          {{ title_first }}
          {% if title_second != blank %}
            <span class="tvg_article_headline_Kuo1xa_title__second">
              {{ title_second }}
            </span>
          {% endif %}
        </h1>
      {% endif %}

      {% if subtitle != blank %}
        <p class="tvg_article_headline_Kuo1xa_subtitle">
          {{ subtitle }}
        </p>
      {% endif %}

      {% if excerpt != blank %}
        <div class="tvg_article_headline_Kuo1xa_excerpt">
          {{ excerpt }}
        </div>
      {% endif %}

      <div class="tvg_article_headline_Kuo1xa_meta">
        <div class="tvg_article_headline_Kuo1xa_metaAuthorDate">
          {% if article.author != blank %}
            <p class="tvg_article_headline_Kuo1xa_author">
              {{ article.author }}
            </p>
          {% endif %}

          <time
            class="tvg_article_headline_Kuo1xa_date"
            datetime="{{ article.published_at | date: '%Y-%m-%d' }}"
          >
            {{ article.published_at | date: format: 'month_day_year' }}
          </time>
        </div>

        {% if tag != blank %}
          <span class="tvg_article_headline_Kuo1xa_tag" data-tag="{{ tag }}">
            {{ tag }}
          </span>
        {% endif %}
      </div>
    </div>
  </div>
</div>

