{% liquid
  assign heading = section.settings.heading | default: null
  assign subheading = section.settings.subheading | default: null
  assign cta_label = section.settings.cta_label | default: null
  assign cta_url = section.settings.cta_url | default: null
  assign articles = section.settings.articles | default: null
  assign articles_count = section.settings.articles.count

  assign show_arrows = section.settings.show_arrows | default: true, allow_false: true
  assign show_pagination = section.settings.show_pagination | default: true, allow_false: true

  assign use_filtered_carousel = false
  if current_tags.size > 0 and articles_count > 1
    assign use_filtered_carousel = true
  endif

  assign show_carousel = false
  if use_filtered_carousel
    assign show_carousel = true
  elsif articles != blank and articles_count > 0
    assign show_carousel = true
  endif

  render 'article-card-stylesheet'
%}

<div class="tvg_journal_article_highlight_gtyUgq_container">
  {% if heading != blank or subheading != blank %}
    <div class="tvg_journal_article_highlight_gtyUgq_section--header">
      {% if heading != blank %}
        <h2 class="tvg_journal_article_highlight_gtyUgq_heading">
          {{ heading }}
        </h2>
      {% endif %}
      {% if subheading != blank %}
        <p class="tvg_journal_article_highlight_gtyUgq_subheading">
          {{ subheading }}
        </p>
      {% endif %}
    </div>
  {% endif %}

  {% if show_carousel %}
    <div class="tvg_journal_article_highlight_gtyUgq_section--content">
      <div class="tvg_journal_article_highlight_gtyUgq_carousel swiper">
        <div class="swiper-wrapper">
          {% if use_filtered_carousel %}
            {% for article in blog.articles limit: 4 %}
              {% if forloop.index > 1 %}
                <div class="tvg_journal_article_highlight_gtyUgq_card swiper-slide">
                  {% render 'article-card', article: article %}
                </div>
              {% endif %}
            {% endfor %}
          {% else %}
            {% for article in articles %}
              <div class="tvg_journal_article_highlight_gtyUgq_card swiper-slide">
                {% render 'article-card', article: article %}
              </div>
            {% endfor %}
          {% endif %}
        </div>
        {% if show_pagination %}
          <div class="tvg_journal_article_highlight_gtyUgq_carousel-pagination swiper-pagination"></div>
        {% endif %}

        {% if show_arrows %}
          <div class="tvg_journal_article_highlight_gtyUgq_carousel-nav--arrows swiper-navigation-arrows js-nav-arrows">
            <button
              type="button"
              class="swiper-button-prev tvg_journal_article_highlight_gtyUgq_arrow"
              title="{{ 'accessibility.previous_slide' | t }}"
              aria-label="{{ 'accessibility.previous_slide' | t }}"
            >
              <span aria-hidden="true">{%- render 'icon-arrow-left' -%}</span>
            </button>

            <button
              type="button"
              class="swiper-button-next tvg_journal_article_highlight_gtyUgq_arrow"
              title="{{ 'accessibility.next_slide' | t }}"
              aria-label="{{ 'accessibility.next_slide' | t }}"
            >
              <span aria-hidden="true">{%- render 'icon-arrow-right' -%}</span>
            </button>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if cta_label != blank and cta_url != blank %}
    <div class="tvg_journal_article_highlight_gtyUgq_section--footer">
      {% render 'core-button', label: cta_label, url: cta_url, type: 'button', style: 'primary' %}
    </div>
  {% endif %}
</div>

