{% liquid
  assign department = section.settings.department
  assign default_open = section.settings.default_open

  assign job_count = 0
  for block in section.blocks
    if block.type == 'job'
      assign job_count = job_count | plus: 1
    endif
  endfor

  assign button_id = 'careers-dept-button-' | append: section.id
  assign panel_id = 'careers-dept-panel-' | append: section.id
%}

<div class="tvg_careers_department_ZWoMxG_CareersDepartment">
  <div class="tvg_careers_department_ZWoMxG_CareersDepartment__item">
    <h3 class="tvg_careers_department_ZWoMxG_CareersDepartment__itemTitle">
      <button
        id="{{ button_id }}"
        class="tvg_careers_department_ZWoMxG_CareersDepartment__trigger js-careers-department-trigger"
        type="button"
        aria-expanded="{% if default_open %}true{% else %}false{% endif %}"
        aria-controls="{{ panel_id }}"
      >
        <span class="tvg_careers_department_ZWoMxG_CareersDepartment__triggerLabel">{{ department }} ({{ job_count }})</span>
        <span class="tvg_careers_department_ZWoMxG_CareersDepartment__icon" aria-hidden="true"></span>
      </button>
    </h3>
    <div
      id="{{ panel_id }}"
      class="tvg_careers_department_ZWoMxG_CareersDepartment__panel js-careers-department-panel"
      role="region"
      aria-labelledby="{{ button_id }}"
      {% unless default_open %}
        hidden
      {% endunless %}
    >
      <ul class="tvg_careers_department_ZWoMxG_CareersDepartment__panelWrapper">
        {% for block in section.blocks %}
          {% if block.type == 'job' %}
            <li class="tvg_careers_department_ZWoMxG_CareersDepartment__job" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <p class="tvg_careers_department_ZWoMxG_CareersDepartment__jobTitle">{{ block.settings.title }}</p>
              {% endif %}
              {% if block.settings.tags != blank %}
                <p class="tvg_careers_department_ZWoMxG_CareersDepartment__jobTags">{{ block.settings.tags }}</p>
              {% endif %}
              {% if block.settings.apply_url != blank %}
                <div class="tvg_careers_department_ZWoMxG_CareersDepartment__actions">
                  {% render 'core-button',
                    label: 'Apply',
                    url: block.settings.apply_url,
                    style: 'primary',
                    class: 'tvg_careers_department_ZWoMxG_CareersDepartment__apply'
                  %}
                </div>
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</div>

