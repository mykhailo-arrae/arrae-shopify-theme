{% # DO NOT EDIT: This file is auto-generated and will be overwritten. [build-fingerprint:assets:source={_js/sections/page-header/section.liquid}] %}

<style>
.tvg_page_header_j1bpBG_root,.tvg_page_header_j1bpBG_breadcrumbs{width:100%}
.tvg_page_header_j1bpBG_header{color:oklch(34.85% 0 0);width:100%;position:relative;overflow:hidden}
.tvg_page_header_j1bpBG_header--light{color:#fff}
.tvg_page_header_j1bpBG_header__media{z-index:0;width:100%;height:100%;position:absolute;inset:0}
.tvg_page_header_j1bpBG_header__overlay{z-index:1;width:100%;height:100%;position:absolute;inset:0}
.tvg_page_header_j1bpBG_header__inner{z-index:1;text-align:center;flex-direction:column;align-items:center;gap:1.375rem;width:100%;max-width:94.5rem;margin-inline:auto;padding:1.5rem 1rem;display:flex;position:relative}
.tvg_page_header_j1bpBG_title{letter-spacing:-.045rem;letter-spacing:-.03em;color:inherit;font-family:Cardinal Fruit,Georgia,Book Antiqua,Times New Roman,serif;font-size:2rem;font-weight:400;line-height:1.12}
.tvg_page_header_j1bpBG_subheading{letter-spacing:-.01em;color:inherit;margin:0;font-family:proxima-nova,-apple-system,blinkmacsystemfont,Segoe UI,roboto,oxygen-sans,ubuntu,cantarell,Helvetica Neue,sans-serif;font-size:1.25rem;font-weight:500;line-height:1.2}
@media print,screen and (width>=64em){.tvg_page_header_j1bpBG_header__inner{gap:1.25rem;padding:3rem 3rem 2.5rem}
.tvg_page_header_j1bpBG_title{font-size:3.5rem;line-height:.98}
.tvg_page_header_j1bpBG_subheading{letter-spacing:-.02em;font-size:1.5rem}
}
</style>

{% liquid
  assign is_first_section = false
  if section.index == 1
    assign is_first_section = true
  endif

  assign show_breadcrumbs = section.settings.show_breadcrumbs
  assign subheading = section.settings.subheading
  assign bg_desktop = section.settings.background_image_desktop
  assign bg_mobile = section.settings.background_image_mobile
  # Text color can be driven by a collection metafield when present, otherwise
  # it falls back to the section setting, then to 'dark'.
  assign text_color = collection.metafields.custom.header_banner_text_color.value | default: section.settings.text_color | default: 'dark' | downcase
  assign overlay_color = section.settings.overlay_color
  assign overlay_opacity = section.settings.overlay_opacity | default: 25 | at_least: 0 | at_most: 100
  assign overlay = ''
  if overlay_color != blank
    assign overlay_alpha = overlay_opacity | times: 1.0 | divided_by: 100.0
    assign overlay = overlay_color | color_modify: 'alpha', overlay_alpha
  endif

  assign heading = section.settings.heading | replace: '[br]', '<br>' | default: null

  assign has_bg = false
  if bg_desktop != blank or bg_mobile != blank
    assign has_bg = true
  endif
%}

{% if show_breadcrumbs %}
  {% comment %}
    Rendered as a direct, full-width child (no container) so the breadcrumb
    snippet's own border bar can span the whole viewport while its inner
    container keeps the content aligned with the page.
  {% endcomment %}
  <div class="tvg_page_header_j1bpBG_breadcrumbs">
    {% render 'breadcrumbs' %}
  </div>
{% endif %}

<div class="tvg_page_header_j1bpBG_header{% if text_color == 'light' %} tvg_page_header_j1bpBG_header--light{% endif %}">
  {%- if has_bg -%}
    <div class="tvg_page_header_j1bpBG_header__media">
      {% render 'core-image',
        image: bg_desktop,
        image_mobile: bg_mobile,
        mode: 'cover',
        object_fit: 'cover',
        preload: true,
        lazyload: false,
        srcset_print_sizes: '480,640,800,960,1024,1280,1440,1800,2000',
        mobile_srcset_print_sizes: '320,480,640,800'
      %}
    </div>
  {%- endif -%}

  {%- if overlay != blank and has_bg -%}
    <div
      class="tvg_page_header_j1bpBG_header__overlay"
      style="background:{{ overlay }}"
    ></div>
  {%- endif -%}

  {% if heading != blank %}
    <div class="tvg_page_header_j1bpBG_header__inner">
      {% if is_first_section %}
        <h1
          class="tvg_page_header_j1bpBG_title"
          {% if section.settings.heading == blank %}
            data-dynamic-title="true"
          {% endif %}
        >
          {{- heading -}}
        </h1>
      {% else %}
        <h2
          class="tvg_page_header_j1bpBG_title"
          {% if section.settings.heading == blank %}
            data-dynamic-title="true"
          {% endif %}
        >
          {{- heading -}}
        </h2>
      {% endif %}

      {% if subheading != blank %}
        <p class="tvg_page_header_j1bpBG_subheading">{{ subheading }}</p>
      {% endif %}
    </div>
  {% endif %}
</div>

