{% liquid
  assign desktop_image = section.settings.desktop_image | default: null
  assign mobile_image = section.settings.mobile_image | default: null
  assign mobile_image = mobile_image | default: desktop_image
  assign desktop_image = desktop_image | default: mobile_image

  assign text_color = section.settings.text_color | default: '#fffef7'
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign large_heading = section.settings.large_heading | default: false, allow_false: true
  assign alternate_heading_placement = section.settings.alternate_heading_placement | default: false, allow_false: true

  assign cta_primary_label = section.settings.cta_primary_label
  assign cta_primary_url = section.settings.cta_primary_url
  assign cta_secondary_label = section.settings.cta_secondary_label
  assign cta_secondary_url = section.settings.cta_secondary_url

  assign overlay_enabled = section.settings.overlay_enabled
  assign overlay_color = section.settings.overlay_color | default: '#21180e'
  assign overlay_opacity = section.settings.overlay_opacity | default: 50
  assign overlay_alpha = overlay_opacity | times: 1.0 | divided_by: 100.0
  assign overlay_desktop_fill = overlay_color | color_modify: 'alpha', overlay_alpha

  assign is_first_section = false
  if section.index == 1
    assign is_first_section = true
  endif

  assign image_lazyload = true
  assign image_preload = false
  if is_first_section
    assign image_lazyload = false
    assign image_preload = true
  endif

  assign image_alt_text_param = heading | strip
  if image_alt_text_param == blank
    assign image_alt_text_param = desktop_image.alt | default: ''
  endif
%}
<section
  class="tvg_value_propositions_JKFDsW_section"
  data-section-id="{{ section.id }}"
  style="color: {{ text_color }};"
>
  <div class="tvg_value_propositions_JKFDsW_frame">
    <div class="tvg_value_propositions_JKFDsW_media">
      {% if desktop_image != blank %}
        {% liquid
          assign fetch_priority = 'low'
          if is_first_section
            assign fetch_priority = 'high'
          endif
        %}
        {% render 'core-image',
          image: desktop_image,
          image_mobile: mobile_image,
          image_alt_text: image_alt_text_param,
          object_fit: 'cover',
          class: '',
          fetchpriority: fetch_priority,
          lazyload: image_lazyload,
          preload: image_preload,
          srcset_print_sizes: '480,640,800,960,1024,1280,1440,1600,2000',
          mobile_srcset_print_sizes: '375,480,640,768'
        %}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: ' tvg_value_propositions_JKFDsW_picture--placeholder' }}
      {% endif %}

      {% if overlay_enabled %}
        <div
          class="tvg_value_propositions_JKFDsW_overlay"
          style="--value-propositions-overlay-desktop-fill: {{ overlay_desktop_fill }};"
          aria-hidden="true"
        ></div>
      {% endif %}
    </div>

    <div class="tvg_value_propositions_JKFDsW_body{% if alternate_heading_placement %} tvg_value_propositions_JKFDsW_body--alternate-heading{% endif %}">
      <div class="tvg_value_propositions_JKFDsW_main{% if large_heading %} tvg_value_propositions_JKFDsW_main--unbounded{% endif %}">
        {% if heading != blank %}
          {% if section.index == 1 %}
            <h1 class="tvg_value_propositions_JKFDsW_heading{% if large_heading %} tvg_value_propositions_JKFDsW_heading--large{% endif %}">
              {{ heading | newline_to_br }}
            </h1>
          {% else %}
            <h2 class="tvg_value_propositions_JKFDsW_heading{% if large_heading %} tvg_value_propositions_JKFDsW_heading--large{% endif %}">
              {{ heading | newline_to_br }}
            </h2>
          {% endif %}
        {% endif %}

        {% if description != blank %}
          <p class="tvg_value_propositions_JKFDsW_description">{{ description | newline_to_br }}</p>
        {% endif %}

        {%- if cta_primary_label != blank
          and cta_primary_url != blank
          or cta_secondary_label != blank
          and cta_secondary_url != blank
        -%}
          <div class="tvg_value_propositions_JKFDsW_buttons-wrapper">
            {% if cta_primary_label != blank and cta_primary_url != blank %}
              {% render 'core-button',
                label: cta_primary_label,
                url: cta_primary_url,
                style: 'secondary',
                class: 'tvg_value_propositions_JKFDsW_button-1'
              %}
            {% endif %}
            {% if cta_secondary_label != blank and cta_secondary_url != blank %}
              {% render 'core-button',
                label: cta_secondary_label,
                url: cta_secondary_url,
                style: 'text-link',
                class: 'tvg_value_propositions_JKFDsW_button-2'
              %}
            {% endif %}
          </div>
        {%- endif -%}
      </div>

      {% if section.blocks.size > 0 %}
        <hr class="tvg_value_propositions_JKFDsW_divider">

        <div class="tvg_value_propositions_JKFDsW_propositions-body">
          <div class="tvg_value_propositions_JKFDsW_benefits">
            <ul class="tvg_value_propositions_JKFDsW_benefits-list" role="list">
              {% for block in section.blocks %}
                {% if block.settings.text == blank and block.settings.icon == blank %}
                  {% continue %}
                {% endif %}
                <li
                  class="tvg_value_propositions_JKFDsW_benefits-item"
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.icon != blank %}
                    <span class="tvg_value_propositions_JKFDsW_benefits-icon" aria-hidden="true">
                      {{
                        block.settings.icon
                        | image_url: width: 64
                        | image_tag:
                          loading: 'lazy',
                          class: 'tvg_value_propositions_JKFDsW_benefits-icon-img',
                          widths: '24, 32, 48, 64',
                          sizes: '(min-width: 900px) 26px, 24px'
                      }}
                    </span>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p class="tvg_value_propositions_JKFDsW_benefits-text">{{ block.settings.text | truncate: 80, '...' }}</p>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
