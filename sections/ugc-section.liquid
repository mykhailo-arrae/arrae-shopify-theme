{% liquid
  assign heading = section.settings.heading
  assign show_arrows = section.settings.show_arrows | default: true, allow_false: true
  assign show_pagination = section.settings.show_pagination | default: true, allow_false: true

  render 'ugc-card-stylesheet'
%}

<div class="">
  <div class="tvg_ugc_section_AvJFlq_container">
    {% if heading != blank %}
      <h2 class="tvg_ugc_section_AvJFlq_heading">
        {{ heading }}
      </h2>
    {% endif %}

    <div class="tvg_ugc_section_AvJFlq_carousel swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% if block.settings.media_image != blank
            or block.settings.media_video != blank
            or block.settings.main_text != blank
            or block.settings.secondary_text != blank
            or block.settings.tertiary_text != blank
          %}
            <div class="tvg_ugc_section_AvJFlq_card swiper-slide" {{ block.shopify_attributes }}>
              {%
                render 'ugc-card',
                main_text: block.settings.main_text | default: null,
                secondary_text: block.settings.secondary_text | default: null,
                tertiary_text: block.settings.tertiary_text | default: null,
                small_main_text: block.settings.small_main_text,
                media_type: block.settings.media_type,
                media_image: block.settings.media_image,
                media_video: block.settings.media_video,
                image_alt_text: block.settings.image_alt_text | default: null,
                video_uid: block.id,
              %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
      {% if show_pagination %}
        <div class="tvg_ugc_section_AvJFlq_carousel-pagination swiper-pagination"></div>
      {% endif %}
    </div>

    {% if section.blocks.size > 1 and show_arrows %}
      <div class="tvg_ugc_section_AvJFlq_carousel-nav--arrows swiper-navigation-arrows js-nav-arrows">
        <button
          type="button"
          class="swiper-button-prev tvg_ugc_section_AvJFlq_arrow"
