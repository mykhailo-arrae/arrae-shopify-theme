{% liquid
  render 'product-card-stylesheet'
  render 'product-review-ratings-stylesheet'

  assign products = article.metafields.custom.products.value | default: null
  assign products_title = article.metafields.custom.products_title.value | default: null
  assign back_label = 'back_to_journal' | t

  capture article_video_markup
    render 'article-media', uid: 'article'
  endcapture

  assign article_content = article.content | replace: '[article-media-block]', article_video_markup
%}

{% paginate article.comments by 100 %}
