          {{ article_content }}
        </div>

        {% comment %} {% render 'social-sharing' %} {% endcomment %}
      </div>

      {% comment %}
        {% if blog.comments_enabled? %}
          {% render 'comments' %}
        {% endif %}
      {% endcomment %}
    </div>

    {% if products != blank %}
      <aside class="tvg_article_3bq3TG_sidebar">
        {% if products_title != blank %}
          <h2 class="tvg_article_3bq3TG_productsTitle">
            {{ products_title }}
          </h2>
        {% endif %}

        <div class="tvg_article_3bq3TG_productsList">
          {% for sidebar_product in products %}
            <div class="tvg_article_3bq3TG_productCard">
              {% render 'product-card', product: sidebar_product %}
