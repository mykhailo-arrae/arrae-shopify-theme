{% comment %}
  Create Your Routine — multi-step quiz section.

  - Steps 1..N are rendered server-side from the routine_creator_questions
    metaobject (sorted by order). Vanilla JS handles step navigation,
    answer selection, and forwards the final selections to the React app
    rendered by the routine-results snippet.
  - The results view is mounted only after the last step is submitted. It
    reads the routine_creator_results metaobject (serialized to JSON below)
    and shows the matching product list inside a drawer.
{% endcomment %}

{% liquid
  # Loads the external CSS for the rating snippet that we render server-side
  # for each routine result and ship inside js-routine-results-data.
  render 'product-review-ratings-stylesheet'

  assign section_name = 'create_your_routine'

  assign image_desktop = section.settings.image_desktop
  assign image_mobile = section.settings.image_mobile
  assign title = section.settings.title
  assign subtitle = section.settings.subtitle

  # Translation defaults — settings can override per merchant, otherwise
  # fall back to localized strings.
  assign t_next = 'sections.create_your_routine.next' | t
  assign t_back = 'sections.create_your_routine.back' | t
  assign t_submit = 'sections.create_your_routine.submit' | t
  assign t_step_template = 'sections.create_your_routine.step_template' | t
  assign t_add_all = 'sections.create_your_routine.add_all_to_cart' | t
  assign t_add_to_cart = 'sections.create_your_routine.add_to_cart' | t
  assign t_adding_to_cart = 'sections.create_your_routine.adding_to_cart' | t
  assign t_sold_out = 'sections.create_your_routine.sold_out' | t
  assign t_results_title = 'sections.create_your_routine.results_title' | t
  assign t_error_message = 'sections.create_your_routine.error_message' | t
  assign t_close = 'sections.create_your_routine.close' | t

  assign next_label = section.settings.next_label | default: t_next
  assign back_label = t_back
  assign submit_label = section.settings.submit_label | default: t_submit
  assign step_label_template = section.settings.step_label | default: t_step_template

  assign quiz_questions = shop.metaobjects.routine_creator_questions.values | sort: 'order'
  assign total_steps = quiz_questions.size

  # Step 1 always renders with the submit label (e.g. "Find your routine")
  # while no answer is selected. The JS runtime swaps it to `next_label`
  # once the user picks an option on step 1, and back to submit on the
  # last step.
  assign initial_next_label = submit_label
%}

<script type="application/json" class="js-routine-results-data">
  [
    {%- for entry in shop.metaobjects.routine_creator_results.values -%}
      {%- assign products = entry.results.value -%}
      {
        "internalName": {{ entry.internal_name | json }},
        "question_1": {{ entry.question_1 | json }},
        "question_2": {{ entry.question_2 | json }},
        "results": [
          {%- for product in products -%}
            {%- assign variant = product.selected_or_first_available_variant -%}
            {%- assign collection_display = product.metafields.custom.smp_display_override.value | default: null -%}
            {%- assign product_title = collection_display.title | default: product.title -%}
            {%- assign featured_image = collection_display.image | default: product.metafields.custom.product_card_image.value | default: product.featured_image -%}
            {%- assign description = collection_display.short_description | default: product.metafields.custom.product_card_marketing_copy.value | default: product.metafields.custom_fields.collection_short_description.value -%}

            {%- liquid
              capture reviews_html_raw
                render 'product-review-ratings', product: product
              endcapture
              assign review_label = 'products.reviews.reviews' | t
              assign spaced_label = ' ' | append: review_label
              assign reviews_html = reviews_html_raw | strip_newlines | strip | replace: review_label, spaced_label
            -%}
            {
              "productId": {{ product.id | plus: 0 | json }},
              "variantId": {{ variant.id | plus: 0 | json }},
              "title": {{ product_title | json }},
              "vendor": {{ product.vendor | json }},
              "url": {{ product.url | json }},
              "price": {{ variant.price | plus: 0 | json }},
              "compareAtPrice": {{ variant.compare_at_price | json }},
              "featuredImage": {{ featured_image | image_url: width: 560 | json }},
              "description": {{ description | strip_html | truncate: 140, '' | json }},
              "routineTitle": {{ product.metafields.custom.routine_title.value | default: '' | json }},
              "routineDescription": {{ product.metafields.custom.routine_description.value | default: '' | json }},
              "reviewsHtml": {{ reviews_html | json }},
              "availableForSale": {{ product.available | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

<script type="application/json" class="js-routine-settings">
  {
    "moneyFormat": {{ shop.money_format | json }},
    "totalSteps": {{ total_steps | json }},
    "labels": {
      "next": {{ next_label | json }},
      "back": {{ back_label | json }},
      "submit": {{ submit_label | json }},
      "stepTemplate": {{ step_label_template | json }},
      "addAllToCart": {{ section.settings.add_all_label | default: t_add_all | json }},
      "addToCart": {{ section.settings.add_to_cart_label | default: t_add_to_cart | json }},
      "addingToCart": {{ t_adding_to_cart | json }},
      "soldOut": {{ section.settings.sold_out_label | default: t_sold_out | json }},
      "resultsTitle": {{ section.settings.results_title | default: t_results_title | json }},
      "errorMessage": {{ section.settings.error_message | default: t_error_message | json }},
      "close": {{ t_close | json }}
    }
  }
</script>

<div
  class="tvg_create_your_routine_z-Kr-G_root js-create-your-routine-root"
  data-section-id="{{ section.id }}"
  data-section-name="{{ section_name }}"
  data-tvg-track-section-name="{{ section_name }}"
  data-current-step="1"
  data-total-steps="{{ total_steps }}"
>
  <div class="tvg_create_your_routine_z-Kr-G_media">
    {% if image_desktop != blank or image_mobile != blank %}
      {% render 'core-image',
        image: image_desktop,
        image_mobile: image_mobile,
        object_fit: 'cover',
        sizes: '(min-width: 768px) 50vw, 100vw'
      %}
    {% else %}
      {{ 'collection-2' | placeholder_svg_tag: '' }}
    {% endif %}
  </div>

  <div class="tvg_create_your_routine_z-Kr-G_content">
    {% if title != blank %}
      <h2 class="tvg_create_your_routine_z-Kr-G_title">{{ title }}</h2>
    {% endif %}

    {% if subtitle != blank %}
      <p class="tvg_create_your_routine_z-Kr-G_subtitle">{{ subtitle }}</p>
    {% endif %}

    {% if total_steps == 0 %}
      <p class="tvg_create_your_routine_z-Kr-G_empty">{{ 'sections.create_your_routine.no_questions' | t }}</p>
    {% else %}
      <form class="tvg_create_your_routine_z-Kr-G_form js-routine-form" novalidate>
        {% for question in quiz_questions %}
          {% liquid
            assign step_index = forloop.index
            assign question_id = 'cyr-question-' | append: section.id | append: '-' | append: step_index
            assign group_name = 'routine-answer-' | append: section.id | append: '-' | append: step_index
            assign answers_raw = question.answers.value
          %}

          <fieldset
            class="tvg_create_your_routine_z-Kr-G_step"
            data-step="{{ step_index }}"
            {% if step_index > 1 %}
              hidden aria-hidden="true"
            {% endif %}
            aria-labelledby="{{ question_id }}-label"
          >
            <legend id="{{ question_id }}-label" class="tvg_create_your_routine_z-Kr-G_step__legend">
              {{ question.question_text }}
            </legend>

            <div class="tvg_create_your_routine_z-Kr-G_answers" role="radiogroup" aria-labelledby="{{ question_id }}-label">
              {% if answers_raw != blank %}
                {% for answer in answers_raw %}
                  {% liquid
                    # Supports answers as objects ({ "label": "...", "value": "..." })
                    # or as plain strings (then label and value share the same text).
                    assign answer_label = answer.label | default: answer.value | default: answer
                    assign answer_value = answer.value | default: answer.label | default: answer
                    assign answer_id = question_id | append: '-answer-' | append: forloop.index
                  %}
                  <label
                    class="tvg_create_your_routine_z-Kr-G_answer js-routine-answer-label"
                    for="{{ answer_id }}"
                    data-answer-value="{{ answer_value | escape }}"
                    data-selected="false"
                  >
                    <input
                      class="tvg_create_your_routine_z-Kr-G_answer__input js-routine-answer"
                      type="radio"
                      id="{{ answer_id }}"
                      name="{{ group_name }}"
                      value="{{ answer_value | escape }}"
                      data-step="{{ step_index }}"
                      data-answer-label="{{ answer_label | escape }}"
                    >
                    <span class="tvg_create_your_routine_z-Kr-G_answer__label">{{ answer_label }}</span>
                  </label>
                {% endfor %}
              {% else %}
                <p class="tvg_create_your_routine_z-Kr-G_empty">
                  {{ 'sections.create_your_routine.no_answers_for_question' | t }}
                </p>
              {% endif %}
            </div>
          </fieldset>
        {% endfor %}

        <div class="tvg_create_your_routine_z-Kr-G_controls">
          <button
            type="button"
            class="tvg_create_your_routine_z-Kr-G_back js-routine-back"
            aria-label="{{ back_label }}"
            disabled
          >
            {% render 'icon-chevron-left', width: 16, height: 16, stroke: 'currentColor' %}
          </button>

          <div class="tvg_create_your_routine_z-Kr-G_next__container">
            <button
              type="button"
              class="tvg_create_your_routine_z-Kr-G_next js-routine-next"
              aria-label="{{ initial_next_label }}"
              disabled
            >
              <span class="js-routine-next-label">{{ initial_next_label }}</span>
            </button>
            <p class="tvg_create_your_routine_z-Kr-G_step__indicator" aria-live="polite">
              <span class="js-routine-step-text">
                {{ step_label_template | replace: '%current%', '1' | replace: '%total%', total_steps }}
              </span>
            </p>
          </div>
        </div>
      </form>
    {% endif %}
  </div>

  {% if total_steps > 0 %}
    <div
      class="tvg_create_your_routine_z-Kr-G_results js-routine-results-host"
      data-expanded="false"
      aria-hidden="true"
      hidden
    >
      {% render 'routine-results' %}
    </div>
  {% endif %}
</div>

