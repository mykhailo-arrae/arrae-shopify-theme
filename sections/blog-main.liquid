{% liquid
  assign featured_article = section.settings.featured_article | default: null
  assign highlight_articles = section.settings.highlight_articles | default: null
  assign excluded_highlight_1 = null
  assign excluded_highlight_2 = null
  assign excluded_highlight_3 = null
  assign excluded_article_1 = null
  assign excluded_article_2 = null
  assign excluded_article_3 = null
  assign excluded_article_4 = null
  assign is_filtered = false
  assign per_page = section.settings.articles_per_page | default: 6
  assign initial_count = section.settings.initial_articles_count | default: 6

  if current_tags.size > 0
    assign is_filtered = true
  endif

  if is_filtered and blog.articles.size > 0
    assign featured_article = blog.articles.first

    for article in blog.articles limit: 4
      case forloop.index
        when 1
          assign excluded_article_1 = article
        when 2
          assign excluded_article_2 = article
        when 3
          assign excluded_article_3 = article
        when 4
          assign excluded_article_4 = article
      endcase
    endfor
  elsif highlight_articles != blank
    for highlight in highlight_articles
      case forloop.index
        when 1
          assign excluded_highlight_1 = highlight
        when 2
          assign excluded_highlight_2 = highlight
        when 3
          assign excluded_highlight_3 = highlight
      endcase
    endfor
  endif

  render 'blog-grid-article-stylesheet'
%}

{% paginate blog.articles by 50 %}
  {% liquid
    assign excluded_count = 0
    if is_filtered
      if paginate.items >= 4
        assign excluded_count = 4
      else
        assign excluded_count = paginate.items
      endif
    else
      if featured_article != blank
        assign excluded_count = excluded_count | plus: 1
      endif
      if excluded_highlight_1 != blank
        if featured_article == blank or excluded_highlight_1.id != featured_article.id
          assign excluded_count = excluded_count | plus: 1
        endif
      endif
      if excluded_highlight_2 != blank
        if featured_article == blank or excluded_highlight_2.id != featured_article.id
          assign excluded_count = excluded_count | plus: 1
        endif
      endif
      if excluded_highlight_3 != blank
        if featured_article == blank or excluded_highlight_3.id != featured_article.id
          assign excluded_count = excluded_count | plus: 1
        endif
      endif
    endif

    assign grid_total_count = paginate.items | minus: excluded_count
    if grid_total_count < 0
      assign grid_total_count = 0
    endif

    assign total_count = grid_total_count
    assign native_pages = paginate.pages
    assign native_page = paginate.current_page

    if request.parameters.page != blank
      assign url_page = request.parameters.page | plus: 0
      if url_page > 0
        assign native_page = url_page
      endif
    endif

    assign is_initial_native_page = false
    if native_page == 1
      assign is_initial_native_page = true
    endif

    assign visible_index = 0
    assign loaded_count = 0
  %}

  {% if grid_total_count > 0 %}
    <div
      class="js-blog-results"
      id="blog-results-{{ section.id }}"
