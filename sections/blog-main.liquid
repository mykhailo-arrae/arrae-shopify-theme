      data-rendered-native-page="{{ native_page }}"
      aria-busy="false"
    >
      <div class="Grid tvg_blog_main_aLIsJq_grid js-blog-grid">
        {% for article in blog.articles %}
          {% liquid
            assign skip_article = false

            if is_filtered
              if excluded_article_1 != blank and article.id == excluded_article_1.id
                assign skip_article = true
              endif
              if skip_article == false and excluded_article_2 != blank and article.id == excluded_article_2.id
                assign skip_article = true
              endif
              if skip_article == false and excluded_article_3 != blank and article.id == excluded_article_3.id
                assign skip_article = true
              endif
              if skip_article == false and excluded_article_4 != blank and article.id == excluded_article_4.id
                assign skip_article = true
              endif
            else
              if featured_article != blank and article.id == featured_article.id
                assign skip_article = true
              endif
              if skip_article == false and excluded_highlight_1 != blank and article.id == excluded_highlight_1.id
                assign skip_article = true
              endif
              if skip_article == false and excluded_highlight_2 != blank and article.id == excluded_highlight_2.id
                assign skip_article = true
              endif
              if skip_article == false and excluded_highlight_3 != blank and article.id == excluded_highlight_3.id
                assign skip_article = true
              endif
            endif
          %}

          {% if skip_article %}
            {% continue %}
          {% endif %}

          {% assign visible_index = visible_index | plus: 1 %}
          {% assign item_hidden = false %}

          {% if is_initial_native_page %}
            {% if visible_index > initial_count %}
              {% assign item_hidden = true %}
            {% endif %}
          {% else %}
            {% assign item_hidden = true %}
          {% endif %}

          {% unless item_hidden %}
            {% assign loaded_count = loaded_count | plus: 1 %}
          {% endunless %}

          <div
            class="tvg_blog_main_aLIsJq_item{% if item_hidden %} js-blog-grid-item--hidden{% endif %}"
            data-article-id="{{ article.id }}"
            {% if item_hidden %}
              hidden
            {% endif %}
          >
            {% render 'blog-grid-article', article: article %}
          </div>
        {% endfor %}
      </div>

      {% render 'blog-load-more',
        paginate: paginate,
        section: section,
        loaded_count: loaded_count,
        total_count: total_count,
