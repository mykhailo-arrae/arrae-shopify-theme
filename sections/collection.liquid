{% liquid
  assign per_page = section.settings.products_per_view | default: 18
  assign show_filters = section.settings.show_filters
  assign show_sort_by = section.settings.show_sort_by
  assign show_grid_layout = section.settings.show_grid_layout

  # Promo block placement is fixed to slot 5 for both mobile and desktop.
  # Mobile drives the grid `order`; desktop drives the explicit grid row.
  assign promo_position_mobile = 5
  # Position N means the promo occupies slot N (i.e. right after product N - 1),
  # so it takes `order: N` and products from N onward shift down by one (mobile).
  assign promo_mobile_order = promo_position_mobile
  # 3-column desktop grid (promo spans 2 cols): row R holds 3 * (R - 1) + 1
  # product cells before the promo, so position N sits in row (N + 1) / 3.
  # Slot 5 sits in row (5 + 1) / 3 = 2.
  assign promo_desktop_row = 2

  render 'product-card-stylesheet'
  render 'product-review-ratings-stylesheet'

  # Promo block content is sourced from the collection's `custom.promo_block`
  # metafield, a "Collection Promo Block" metaobject reference. When the
  # metafield is empty the promo block is not rendered.
  assign promo_object = collection.metafields.custom.promo_block.value
  assign has_promo = false
  if promo_object != blank
    assign has_promo = true
  endif

  # The tag nav lists every Product Section block that has a tag name.
  assign has_tags = false
  for block in section.blocks
    if block.type == 'product_section'
      if block.settings.tag_name != blank and block.settings.collection != blank
        assign has_tags = true
      endif
    endif
  endfor

  # Count active filters so the filter button can show a badge.
  assign filters_count = 0
  assign has_active_filters = false
  for filter in collection.filters
    assign filters_count = filters_count | plus: filter.active_values.size
    if filter.active_values.size > 0
      assign has_active_filters = true
    endif
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign has_active_filters = true
      endif
    endif
  endfor

  # Promo is shown only on the default, unfiltered listing (page 1).
  assign show_promo = false
  if has_promo and has_active_filters == false
    assign show_promo = true
  endif

  # The category bar renders when there is at least one control to show.
  assign show_controls_bar = false
  if has_tags or show_filters or show_sort_by or show_grid_layout
    assign show_controls_bar = true
  endif
%}

{%- if show_controls_bar -%}
  <div class="tvg_collection_XWIrfq_category-bar">
    {%- if has_tags -%}
      <nav class="tvg_collection_XWIrfq_tag-nav" aria-label="{{ 'tags_label' | t }}">
        <ul class="tvg_collection_XWIrfq_tag-nav__list">
          {%- assign current_sort = request.query_parameters.sort_by -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'product_section'
              and block.settings.tag_name != blank
              and block.settings.collection != blank
            -%}
              {%- assign tag_collection = block.settings.collection -%}
              {%- assign tag_url = tag_collection.url -%}
              {%- if current_sort != blank -%}
                {%- assign tag_url = tag_url | append: '?sort_by=' | append: current_sort -%}
              {%- endif -%}
              {%- assign is_current_tag = false -%}
              {%- if tag_collection.handle == collection.handle -%}
                {%- assign is_current_tag = true -%}
              {%- endif -%}
              <li class="tvg_collection_XWIrfq_tag-nav__item" {{ block.shopify_attributes }}>
                <a
                  href="{{ tag_url }}"
                  class="{% if block.settings.use_pill_style %}tvg_collection_XWIrfq_tag-pill{% else %}tvg_collection_XWIrfq_tag{% endif %}"
                  {% if is_current_tag %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ block.settings.tag_name }}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="tvg_collection_XWIrfq_controls">
      {%- if show_filters or show_sort_by -%}
        <div class="tvg_collection_XWIrfq_controls__actions">
          <button
            class="tvg_collection_XWIrfq_filters js-offcanvas-trigger"
            type="button"
            data-drawer-name="filters"
            aria-label="{{ 'collections.filter.button' | t }}{% if filters_count > 0 %}, {{ 'collections.accessibility.filters_applied' | t: count: filters_count }}{% endif %}"
          >
            <span class="tvg_collection_XWIrfq_filters__label">{{ 'collections.filter.button' | t }}</span>
            <span class="tvg_collection_XWIrfq_filters__icon">{%- render 'icon-filters', width: 20, height: 20 -%}</span>
            <span
              class="tvg_collection_XWIrfq_filters__qty js-collection-filter-count{% if filters_count == 0 %} hidden{% endif %}"
            >
              {%- if filters_count > 0 -%}{{ filters_count }}{%- endif -%}
            </span>
          </button>
        </div>
      {%- endif -%}

      {%- if show_grid_layout -%}
        {%- comment -%}
          Mobile-only single toggle. The visible icon represents the CURRENT
          view; clicking it switches to the other view. CSS hides the
          button matching the active `data-grid-view`, so only the opposite
          button shows. `data-view` is the view a button activates.
        {%- endcomment -%}
        <div
          class="tvg_collection_XWIrfq_view-switch js-collection-view"
          data-grid-view="2-column"
        >
          <button
            class="tvg_collection_XWIrfq_view-switch__btn"
            type="button"
            data-view="2-column"
            aria-label="{{ 'collections.view.two_columns' | t }}"
          >
            <img
              class="tvg_collection_XWIrfq_view-switch__icon"
              src="{{ '1-column-layout-icon.png' | asset_url }}"
              alt=""
              width="14"
              height="20"
              loading="lazy"
            >
          </button>
          <button
            class="tvg_collection_XWIrfq_view-switch__btn"
            type="button"
            data-view="1-column"
            aria-label="{{ 'collections.view.one_column' | t }}"
          >
            <img
              class="tvg_collection_XWIrfq_view-switch__icon"
              src="{{ '2-columns-layout-icon.png' | asset_url }}"
              alt=""
              width="15"
              height="20"
              loading="lazy"
            >
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{%- paginate collection.products by per_page -%}
  {%- assign promo_card = '' -%}
  {%- if show_promo and paginate.current_page == 1 -%}
    {%- capture promo_card -%}
      <div
        class="tvg_collection_XWIrfq_item tvg_collection_XWIrfq_item--promo"
        style="--promo-order: {{ promo_mobile_order }}; --promo-row: {{ promo_desktop_row }};"
      >
        {% render 'promo-block',
          promo_object: promo_object,
          uid: collection.id
        %}
      </div>
    {%- endcapture -%}
  {%- endif -%}

  {%- comment -%}
    Everything inside `.js-collection-results` is swapped in place when filters
    or sort change on the same collection (see `collection-results-refresh.ts`).
    Category tag clicks perform a full page navigation so page-header
    metafields, SEO, and breadcrumbs re-render for the target collection.
    Keep the tag nav, filters and sort drawers OUTSIDE this region so their
    DOM identity is preserved across filter/sort refreshes.
  {%- endcomment -%}
  <div
    class="js-collection-results"
    id="collection-results-{{ section.id }}"
    data-section-id="{{ section.id }}"
    data-collection-title="{{ collection.title | escape }}"
    data-loading-label="{{ 'loading_label' | t }}"
    data-error-label="{{ 'load_error' | t }}"
    aria-busy="false"
  >
    <p class="u-vhide js-collection-status" role="status" aria-live="polite"></p>

    <section class="tvg_collection_XWIrfq_root">
      {%- if collection.products.size > 0 -%}
        <div class="Grid tvg_collection_XWIrfq_grid js-collection-grid" data-layout="2-column">
          {% for product in collection.products %}
            {%- liquid
              # The promo occupies slot N (`promo_position_mobile`); products from
              # that slot onward shift down by one so `order` leaves a gap for it
              # (mobile sorts by `--grid-order`).
              assign item_grid_order = forloop.index
              if show_promo and forloop.index >= promo_position_mobile
                assign item_grid_order = forloop.index | plus: 1
              endif
            -%}
            <div
              class="tvg_collection_XWIrfq_item"
              data-product-id="{{ product.id }}"
              style="--grid-order: {{ item_grid_order }}"
            >
              {% render 'product-card', product: product %}
            </div>
          {% endfor %}
          {%- if promo_card != blank -%}
            {{ promo_card }}
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="tvg_collection_XWIrfq_empty">
          {{ 'empty_html' | t: url: '/collections/all' }}
        </div>
      {%- endif -%}
    </section>

    {%- render 'collection-load-more', paginate: paginate, section: section -%}
  </div>
{%- endpaginate -%}

{%- if show_filters or show_sort_by -%}
  {%- render 'collection-filters', show_filters: show_filters, show_sort: show_sort_by, ajax: true -%}
{%- endif -%}

{% schema %}
{
