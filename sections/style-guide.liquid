<aside class="tvg_style_guide_UaSs5a_drawer js-drawer" data-drawer-names="style-guide">
  <div
    class="tvg_style_guide_UaSs5a_drawer__wrapper js-drawer-content"
    role="dialog"
    aria-labelledby="drawer-title"
    tabindex="-1"
  >
    <div class="tvg_style_guide_UaSs5a_drawer__container">
      <div class="tvg_style_guide_UaSs5a_drawer__logo">
        {% render 'core-brand' %}
      </div>
      <h2 class="tvg_style_guide_UaSs5a_drawer__title">
        {{ 'styleguide_first_title' | t }}
      </h2>
      <a
        href="#overview"
        class="tvg_style_guide_UaSs5a_drawer__nav__action js-section-link is-active"
      >
        {{ 'overview_title' | t }}
      </a>
      <h2 class="tvg_style_guide_UaSs5a_drawer__title">
        {{ 'title' | t }}
      </h2>
      <div class="tvg_style_guide_UaSs5a_drawer__main">
        <ul class="tvg_style_guide_UaSs5a_drawer__nav">
          {% liquid
            assign typography_title = 'typography_title' | t
            assign colors_title = 'colors_title' | t
            assign spacing_title = 'spacing_title' | t
            assign icons_title = 'icons_title' | t
            assign buttons_title = 'buttons_title' | t
            assign forms_title = 'forms_title' | t
            assign components_title = 'components_title' | t
          %}
          {% for section in sections_list_array %}
            <li class="tvg_style_guide_UaSs5a_drawer__nav__item">
              <a
                href="#{{ section }}"
                class="tvg_style_guide_UaSs5a_drawer__nav__action js-section-link"
              >
                {% case section %}
                  {% when 'typography' -%}
                    {{- typography_title }}
                  {% when 'colors' -%}
                    {{- colors_title }}
                  {% when 'spacing' -%}
                    {{- spacing_title }}
                  {% when 'icons' -%}
                    {{- icons_title }}
                  {% when 'buttons' -%}
                    {{- buttons_title }}
                  {% when 'forms' -%}
                    {{- forms_title }}
                  {% when 'components' -%}
                    {{- components_title }}
                  {% else -%}
                    {{- section }}
                {% endcase %}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</aside>

<div class="tvg_style_guide_UaSs5a_drawer__trigger">
  <button
    class="tvg_style_guide_UaSs5a_nav js-drawer-trigger"
    role="button"
    aria-expanded="false"
    aria-controls="drawer-content"
    data-drawer-name="style-guide"
  >
    {% render 'icon-menu' %}
    <span>
      {{ 'nav_label' | t }}
    </span>
  </button>
</div>

