{% liquid
  render 'product-card-stylesheet'
  render 'product-review-ratings-stylesheet'

  assign title = section.settings.title
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign show_arrows = section.settings.show_arrows | default: true
  assign show_pagination = section.settings.show_pagination | default: false

  assign tabs = section.blocks | where: 'type', 'tab'
  assign tabs_count = tabs | size
  assign products_qty = 9
%}

<div
  class="tvg_featured_collections_6qrTAq_container js-featured-collection-a11y-context"
  data-a11y-prev-slide="{{ 'accessibility.previous_slide' | t | escape }}"
  data-a11y-next-slide="{{ 'accessibility.next_slide' | t | escape }}"
>
  {% if title != blank %}
    <div class="tvg_featured_collections_6qrTAq_title-row">
      <h2 class="tvg_featured_collections_6qrTAq_title">{{ title }}</h2>
    </div>
  {% endif %}

  <div class="tvg_featured_collections_6qrTAq_header">
    <div class="tvg_featured_collections_6qrTAq_tabs-strip {% if tabs_count <= 1%}tvg_featured_collections_6qrTAq_tabs-strip--single{% endif %}">
      <div
        class="tvg_featured_collections_6qrTAq_tabs"
        role="tablist"
        aria-label="{{ 'accessibility.featured_collections_tablist' | t }}"
      >
        {% for tab in tabs %}
          {% liquid
            assign label = tab.settings.tab_label
            assign id = label | handleize
          %}
          {% if label != blank and id != blank %}
            <button
              class="js-tab tvg_featured_collections_6qrTAq_tab"
              role="tab"
              id="tab-{{ id }}"
              aria-controls="panel-{{ id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-tab="{{ id }}"
            >
              {{ label }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
      {% if cta_label != blank and cta_link != blank %}
        <div class="tvg_featured_collections_6qrTAq_header-cta">
          {% render 'core-button', label: cta_label, url: cta_link, style: 'primary', class: 'tvg_featured_collections_6qrTAq_cta' %}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="tvg_featured_collections_6qrTAq_carousel-outer-wrapper">
    {% if tabs_count > 0 %}
      {% for tab in tabs %}
        {% liquid
          assign label = tab.settings.tab_label
          assign id = label | handleize

          assign cards_collection = tab.settings.collection
          assign cards_products = tab.settings.products

          if cards_products != blank
            assign cards = cards_products
          else
            assign cards = cards_collection.products
          endif
        %}

        <div
          class="js-panel tvg_featured_collections_6qrTAq_panel"
          role="tabpanel"
          id="panel-{{ id }}"
          aria-labelledby="tab-{{ id }}"
          {% unless forloop.first %}
            hidden
          {% endunless %}
        >
          <div class="tvg_featured_collections_6qrTAq_cards swiper">
            <div class="swiper-wrapper">
              {% for card in cards limit: products_qty %}
                <div class="tvg_featured_collections_6qrTAq_card swiper-slide js-product-card">
                  {% render 'product-card', product: card %}
                </div>
              {% endfor %}
            </div>
            {% if show_pagination %}
              <div class="tvg_featured_collections_6qrTAq_carousel-pagination swiper-pagination"></div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    {% endif %}

    {% if show_arrows %}
      <div class="tvg_featured_collections_6qrTAq_carousel-nav--arrows swiper-navigation-arrows js-nav-arrows">
        <button
          type="button"
          class="swiper-button-prev tvg_featured_collections_6qrTAq_arrow"
          title="{{ 'accessibility.previous_slide' | t }}"
          aria-label="{{ 'accessibility.previous_slide' | t }}"
        >
          <span aria-hidden="true">{%- render 'icon-arrow-left' -%}</span>
        </button>

        <button
          type="button"
          class="swiper-button-next tvg_featured_collections_6qrTAq_arrow"
          title="{{ 'accessibility.next_slide' | t }}"
          aria-label="{{ 'accessibility.next_slide' | t }}"
        >
          <span aria-hidden="true">{%- render 'icon-arrow-right' -%}</span>
        </button>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Featured Collections",
  "tag": "section",
