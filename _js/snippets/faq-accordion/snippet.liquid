{% doc %}
  FAQ Accordion Item

  Renders a single expandable FAQ question and answer.

  @param {string} title - Question title (required)
  @param {string} content - Answer content (required)
  @param {number} question_index - Index within the category accordion (required)
  @param {string} section_id - Parent section ID for unique element IDs (required)
  @param {string} category_id - Category ID for unique element IDs (required)
  @param {boolean} expanded - Whether the item is expanded by default (default: false)
  @param {string} shopify_attributes - Optional Shopify block attributes
  @param {string} element_class - Optional class to add to the element

  @example
  {% render 'faq-accordion',
    title: block.settings.title,
    content: block.settings.content,
    question_index: question_index,
    section_id: section.id,
    category_id: category.id,
    expanded: expand_question,
    shopify_attributes: block.shopify_attributes,
    element_class: 'custom-class'
  %}
{% enddoc %}

{% liquid
  assign title = title | default: ''
  assign content = content | default: ''
  assign question_index = question_index | default: 0
  assign section_id = section_id | default: ''
  assign category_id = category_id | default: ''
  assign expanded = expanded | default: false
  assign shopify_attributes = shopify_attributes | default: ''
  assign element_class = element_class | default: ''
%}

{% if title != blank and content != blank and question_index > 0 and section_id != blank and category_id != blank %}
  {% liquid
    assign accordion_button_id = 'faq-button-' | append: section_id | append: '-' | append: category_id | append: '-' | append: question_index
    assign accordion_panel_id = 'faq-answer-' | append: section_id | append: '-' | append: category_id | append: '-' | append: question_index
  %}

  <div class="{# style FaqAccordion__item #} {{ element_class }}" {{ shopify_attributes }}>
    <h3 class="{# style FaqAccordion__itemTitle #}">
      <button
        id="{{ accordion_button_id }}"
        class="{# style FaqAccordion__trigger #} js-faq-accordion-trigger"
        type="button"
        aria-expanded="{% if expanded %}true{% else %}false{% endif %}"
        aria-controls="{{ accordion_panel_id }}"
        data-faq-accordion-trigger="{{ question_index }}"
      >
        <span class="{# style FaqAccordion__question #}">{{ title }}</span>
        <span class="{# style FaqAccordion__icon #}" aria-hidden="true">
          <span class="{# style iconPlus #}">
            {% render 'icon-plus' %}
          </span>
          <span class="{# style iconMinus #}">
            {% render 'icon-minus' %}
          </span>
        </span>
      </button>
    </h3>
    <div
      id="{{ accordion_panel_id }}"
      class="{# style FaqAccordion__answer #} js-faq-accordion-panel"
      role="region"
      aria-labelledby="{{ accordion_button_id }}"
      data-faq-accordion-panel="{{ question_index }}"
      {% unless expanded %}
        hidden
      {% endunless %}
    >
      <div class="{# style FaqAccordion__answerInner #}">
        {{ content }}
      </div>
    </div>
  </div>
{% endif %}
