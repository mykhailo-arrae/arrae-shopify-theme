{% doc %}
  Product Upsells

  Renders PDP upsell products and an optional info accordion from a product
  metafield that references a `pdp_upsell_dynamic_content` metaobject, or from
  flat section-setting overrides passed by product-main.

  Expected metaobject fields (content path):
  - title (rich text) — section heading
  - upsell_products (list of product references)
  - info_label (single line text) — accordion trigger
  - info_text (multiline text) — accordion panel body

  Product row presentation and add-to-cart variant/selling-plan resolution mirror
  product-card. The info accordion mirrors product-accordion and is always closed
  by default.

  Nothing is rendered when there are no upsell products.

  Flat params override the matching content metaobject fields when non-blank.
  Defaults come from `content` (product metafield) when a setting is blank.

  @param {metafield|metaobject} [content] - The product metafield or unwrapped metaobject.
  @param {string} [title] - Override heading (richtext HTML from section settings).
  @param {product[]} [products] - Override upsell product list.
  @param {string} [info_label] - Override info accordion label.
  @param {string} [info_text] - Override info accordion body.
  @param {string} [id] - Base id for accordion element ids (default: 'product-upsells').

  @example
  {% render 'product-upsells',
    content: product.metafields.custom.pdp_product_upsells
  %}
{% enddoc %}

{% liquid
  assign content = content | default: blank

  if content.value != blank
    assign content = content.value
  endif

  assign base_id = id | default: 'product-upsells'

  assign content_products = blank
  assign content_info_label = blank
  assign content_info_text = blank
  if content != blank
    assign content_products = content.upsell_products.value | default: content.upsell_products
    assign content_info_label = content.info_label.value | default: content.info_label
    assign content_info_text = content.info_text.value | default: content.info_text
  endif

  assign upsell_products = products | default: content_products
  assign info_label = info_label | default: content_info_label
  assign info_text = info_text | default: content_info_text

  assign heading_from_settings = false
  if title != blank and title != '<p></p>'
    assign heading_from_settings = true
  endif

  assign has_upsells = false
  if upsell_products != blank and upsell_products.size > 0
    assign has_upsells = true
  endif

  assign show_info = false
  if info_label != blank and info_text != blank
    assign show_info = true
  endif

  assign atc_label = 'products.product.add_to_cart' | t
%}

{% if has_upsells %}
  {% render 'product-upsells-stylesheet' %}

  <div class="{# style root #}">
    {% if heading_from_settings %}
      <div class="{# style title #} o-rte">
        {{ title }}
      </div>
    {% elsif content.title != blank %}
      <div class="{# style title #} o-rte">
        {{ content.title | metafield_tag }}
      </div>
    {% endif %}

    <ul class="{# style list #}">
      {% for upsell_product in upsell_products %}
        {% liquid
          assign collection_display = upsell_product.metafields.custom.smp_display_override.value | default: null
          assign card_title = collection_display.title | default: upsell_product.title
          assign image = collection_display.image.value | default: collection_display.image | default: upsell_product.metafields.custom.product_card_image.value | default: upsell_product.featured_image | default: null
          assign image_alt = image.alt | default: card_title
          assign subtitle = collection_display.short_description | default: upsell_product.metafields.custom.product_card_marketing_copy.value | default: upsell_product.metafields.custom_fields.collection_short_description.value | default: blank

          assign card_variant = null
          assign card_selling_plan_id = ''
          assign min_allocation_price = ''

          for v in upsell_product.variants
            assign hide_on_front_end = v.metafields.custom.hide_on_front_end.value | default: false, allow_false: true
            if hide_on_front_end
              continue
            endif
            if v.available and v.selling_plan_allocations.size > 0
              assign card_variant = v
              assign min_allocation_price = ''
              for alloc in v.selling_plan_allocations
                if min_allocation_price == blank or alloc.price < min_allocation_price
                  assign min_allocation_price = alloc.price
                  assign card_selling_plan_id = alloc.selling_plan.id
                endif
              endfor
              break
            endif
          endfor

          if card_variant == null
            for v in upsell_product.variants
              assign hide_on_front_end = v.metafields.custom.hide_on_front_end.value | default: false, allow_false: true
              unless hide_on_front_end
                if v.available
                  assign card_variant = v
                  break
                endif
              endunless
            endfor
          endif

          if card_variant == null
            for v in upsell_product.variants
              assign hide_on_front_end = v.metafields.custom.hide_on_front_end.value | default: false, allow_false: true
              unless hide_on_front_end
                assign card_variant = v
                break
              endunless
            endfor
          endif

          if card_variant == null
            assign card_variant = upsell_product.selected_or_first_available_variant
          endif

          assign product_url_with_variant = upsell_product.url | append: '?variant=' | append: card_variant.id
          assign card_url = product_url_with_variant
          if collection_display.cta_link != blank
            assign card_url = collection_display.cta_link
          endif
        %}

        <li class="{# style item #}">
          <a href="{{ card_url }}" class="{# style imageLink #}">
            <div class="{# style image #}">
              {% if image != blank %}
                {% render 'core-image',
                  image: image,
                  image_alt_text: image_alt,
                  mode: 'cover',
                  object_fit: 'cover',
                  force_aspect_ratio: 1,
                  lazyload: true,
                  srcset_print_sizes: '160,240,320',
                  sizes: '100px'
                %}
              {% endif %}
            </div>
          </a>

          <div class="{# style body #}">
            <div class="{# style details #}">
              <h3 class="{# style productTitle #}">
                <a href="{{ card_url }}">{{ card_title }}</a>
              </h3>

              {% if subtitle != blank %}
                <p class="{# style marketingCopy #}">{{ subtitle }}</p>
              {% endif %}

              <div class="{# style price #}">
                {% render 'product-price-html',
                  product: upsell_product,
                  variant: card_variant,
                  selling_plan_id: card_selling_plan_id,
                  from_prefix: false
                %}
              </div>
            </div>

            <button
              type="button"
              class="js-product-upsells-add-to-cart {# style cta #}"
              aria-label="{{ atc_label | escape }} — {{ card_title | escape }}"
              data-variant-id="{{ card_variant.id }}"
              {% if card_selling_plan_id != blank %}
                data-selling-plan-id="{{ card_selling_plan_id }}"
              {% endif %}
              {% unless card_variant.available %}
                disabled
              {% endunless %}
            >
              {{ atc_label }}
            </button>
          </div>
        </li>
      {% endfor %}
    </ul>

    {% if show_info %}
      {% liquid
        assign button_id = base_id | append: '-info-button'
        assign panel_id = base_id | append: '-info-panel'
      %}
      <div class="{# style info #}">
        <h3 class="{# style infoTitle #}">
          <button
            id="{{ button_id }}"
            class="{# style infoTrigger #} js-product-upsells-info-trigger"
            type="button"
            aria-expanded="false"
            aria-controls="{{ panel_id }}"
            data-product-upsells-info-trigger
          >
            <span class="{# style infoLabel #}">{{ info_label }}</span>
            <span class="{# style infoIcon #}" aria-hidden="true">
              {% render 'svg-accordion-chevron' %}
            </span>
          </button>
        </h3>
        <div
          id="{{ panel_id }}"
          class="{# style infoPanel #} js-product-upsells-info-panel"
          role="region"
          aria-labelledby="{{ button_id }}"
          data-product-upsells-info-panel
          hidden
        >
          <div class="{# style infoDescription #}">
            <div class="{# style infoBody #}">
              {{ info_text | newline_to_br }}
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
{% endif %}
