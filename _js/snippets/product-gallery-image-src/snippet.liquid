{% doc %}
  Resolves a storefront URL for a product image, media image, file_reference,
  metaobject-wrapped image, or raw URL string.

  Metaobject entries (e.g. list.metaobject_reference galleries) are unwrapped via
  common file/image field handles before URL resolution.

  @param {object} image - Image, media, file, metaobject drop, or URL string
  @param {number} width - Target width for image_url (default 1280)
{% enddoc %}

{% liquid
  assign image = image | default: null
  assign width = width | default: 1280
  assign resolved_src = ''
  assign media = image

  if image != blank
    # list.metaobject_reference items are MetaobjectDrops — pull nested file/image
    assign nested_media = null

    if image.image != blank
      assign nested_media = image.image.value | default: image.image
    endif
    if nested_media == blank and image.file != blank
      assign nested_media = image.file.value | default: image.file
    endif
    if nested_media == blank and image.media != blank
      assign nested_media = image.media.value | default: image.media
    endif
    if nested_media == blank and image.gallery_image != blank
      assign nested_media = image.gallery_image.value | default: image.gallery_image
    endif
    if nested_media == blank and image.photo != blank
      assign nested_media = image.photo.value | default: image.photo
    endif
    if nested_media == blank and image.src != blank
      assign nested_media = image.src.value | default: image.src
    endif
    if nested_media == blank and image.desktop_image != blank
      assign nested_media = image.desktop_image.value | default: image.desktop_image
    endif
    if nested_media == blank and image.mobile_image != blank
      assign nested_media = image.mobile_image.value | default: image.mobile_image
    endif
    if nested_media == blank and image.featured_image != blank
      assign nested_media = image.featured_image.value | default: image.featured_image
    endif
    if nested_media == blank and image.image_file != blank
      assign nested_media = image.image_file.value | default: image.image_file
    endif
    if nested_media == blank and image.asset != blank
      assign nested_media = image.asset.value | default: image.asset
    endif
    if nested_media == blank and image.picture != blank
      assign nested_media = image.picture.value | default: image.picture
    endif
    if nested_media == blank and image.img != blank
      assign nested_media = image.img.value | default: image.img
    endif
    if nested_media == blank and image.thumbnail != blank
      assign nested_media = image.thumbnail.value | default: image.thumbnail
    endif

    if nested_media != blank
      assign media = nested_media
    endif

    # Nested field might itself be a list — use the first renderable item
    if media != blank and media.first != blank and media.aspect_ratio == blank and media.width == blank
      assign media = media.first
      if media.value != blank
        assign media = media.value | default: media
      endif
    endif

    assign candidate = media | image_url: width: width | strip
    if candidate != blank and candidate contains 'Liquid error'
      assign candidate = ''
    endif
    if candidate != blank and candidate contains 'MetaobjectDrop'
      assign candidate = ''
    endif
    if candidate != blank
      assign resolved_src = candidate
    endif

    if resolved_src == blank and media.preview_image != blank
      assign candidate = media.preview_image | image_url: width: width | strip
      if candidate != blank and candidate contains 'Liquid error'
        assign candidate = ''
      endif
      if candidate != blank and candidate contains 'MetaobjectDrop'
        assign candidate = ''
      endif
      if candidate != blank
        assign resolved_src = candidate
      endif
    endif

    if resolved_src == blank and media.url != blank
      assign candidate = media.url | strip
      if candidate != blank and candidate contains 'Liquid error'
        assign candidate = ''
      endif
      if candidate != blank and candidate contains 'MetaobjectDrop'
        assign candidate = ''
      endif
      if candidate != blank
        if candidate contains 'http' or candidate contains '//'
          assign resolved_src = candidate
        endif
      endif
    endif

    # Raw URL strings from some metafield types
    if resolved_src == blank
      assign candidate = media | append: '' | strip
      if candidate contains 'Liquid error' or candidate contains 'MetaobjectDrop'
        assign candidate = ''
      endif
      if candidate contains 'https://' or candidate contains 'http://'
        assign resolved_src = candidate
      endif
    endif
  endif

  if resolved_src contains 'MetaobjectDrop' or resolved_src contains 'Liquid error'
    assign resolved_src = ''
  endif
%}
{{- resolved_src -}}
