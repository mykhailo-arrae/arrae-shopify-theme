{% doc %}
  @description
  Promotional block for the PLP (and other product grids). Renders a rounded
  media tile (image or video) with a light gradient overlay, an overlaid
  content block (headline, body, CTA) anchored to the top, and optional video
  controls anchored to the bottom. Fills its container (100% width and height).
  Desktop and mobile media are configured independently. Reuses `core-image`,
  `core-video`, `core-video-controls` and `core-button` so it inherits the
  theme's existing responsive, performance and accessibility behaviour.

  @param {object} promo_object - Collection Promo Block metaobject. When set, fields are read from this object (metafield `.value` unwrapping included). Individual params below are optional overrides or for non-metaobject usage.
  @param {string} headline - Heading text, rendered as an <h2>.
  @param {string} body - Supporting copy. Richtext/HTML is allowed.
  @param {string} cta_label - Button label. The CTA only renders when both label and url are set.
  @param {string} cta_url - Button link. Supports internal pages and external URLs.
  @param {boolean} cta_open_in_new_tab - Opens the CTA in a new tab (adds rel="noopener noreferrer"). Defaults to false.
  @param {string} text_color - 'dark' (default) or 'light'.
  @param {string} overlay - Optional solid overlay color (typically an rgba value from `overlay_color` + `overlay_opacity` metafields). Overrides the default gradient when set; when empty the built-in gradient is used.
  @param {string} background_type - 'image' or 'video'. Defaults to 'image'.
  @param {object} desktop_image - Image used at >=1024px when background_type is 'image'.
  @param {object} desktop_video - Video used at >=1024px when background_type is 'video'.
  @param {object} mobile_image - Image used below 1024px. Falls back to desktop_image.
  @param {object} mobile_video - Video used below 1024px. Falls back to desktop_video.
  @param {boolean} show_play_button - Renders the play/pause control (video only). Defaults to false.
  @param {boolean} show_mute_button - Renders the mute/unmute control (video only). Defaults to false.
  @param {string} content_position_desktop - Corner for the content on desktop: 'top_left' (default), 'top_right', 'bottom_left', 'bottom_right'.
  @param {string} content_position_mobile - Corner for the content on mobile. Same values as desktop. Defaults to 'top_left'.
  @param {string} video_controls_position_desktop - Horizontal side for the video controls on desktop: 'left' (default) or 'right'. Controls always sit at the bottom. Automatically flips to the opposite side if it would collide with bottom-anchored content.
  @param {string} video_controls_position_mobile - Horizontal side for the video controls on mobile. Same values/behaviour as desktop. Defaults to 'left'.
  @param {string} uid - Unique suffix for the video control wiring. Pass a unique value when more than one promo-block renders on a page.

  @example
  {% render 'promo-block',
    promo_object: collection.metafields.custom.promo_block.value,
    uid: collection.id
  %}
  @example
  {% render 'promo-block',
    headline: 'Create Your Routine',
    body: '<p>Meet our co-founders, Siff and Nish.</p>',
    cta_label: 'Find your routine',
    cta_url: '/pages/quiz',
    background_type: 'video',
    desktop_video: section.settings.desktop_video,
    mobile_video: section.settings.mobile_video,
    show_play_button: true,
    show_mute_button: true,
    uid: 'plp-1'
  %}
{% enddoc %}

{% liquid
  assign promo_object = promo_object | default: null

  if promo_object != blank
    assign headline = promo_object.headline
    assign body = promo_object.body
    assign cta_label = promo_object.cta_label
    assign cta_url = promo_object.cta_link
    assign cta_open_in_new_tab = promo_object.open_cta_in_new_tab
    assign background_type = promo_object.background_type.value | default: promo_object.background_type | default: 'image' | downcase
    assign desktop_image = promo_object.desktop_image.value | default: promo_object.desktop_image
    assign mobile_image = promo_object.mobile_image.value | default: promo_object.mobile_image
    assign desktop_video = promo_object.desktop_video.value | default: promo_object.desktop_video
    assign mobile_video = promo_object.mobile_video.value | default: promo_object.mobile_video
    assign show_play_button = promo_object.show_play_pause_button.value | default: promo_object.show_play_pause_button
    assign show_mute_button = promo_object.show_mute_unmute_button.value | default: promo_object.show_mute_unmute_button
    assign text_color = promo_object.text_color.value | default: promo_object.text_color | default: 'dark' | downcase
    assign promo_overlay_color = promo_object.overlay_color.value | default: promo_object.overlay_color
    assign promo_overlay_opacity = promo_object.overlay_opacity.value | default: promo_object.overlay_opacity | default: 50
    assign overlay = ''
    if promo_overlay_color != blank
      assign promo_overlay_alpha = promo_overlay_opacity | times: 1.0 | divided_by: 100.0
      assign overlay = promo_overlay_color | color_modify: 'alpha', promo_overlay_alpha
    endif
    assign content_position_desktop = promo_object.content_position_desktop.value | default: promo_object.content_position_desktop | default: 'top_left' | downcase
    assign content_position_mobile = promo_object.content_position_mobile.value | default: promo_object.content_position_mobile | default: 'top_left' | downcase
    assign video_controls_position_desktop = promo_object.video_controls_position_desktop.value | default: promo_object.video_controls_position_desktop | default: 'left' | downcase
    assign video_controls_position_mobile = promo_object.video_controls_position_mobile.value | default: promo_object.video_controls_position_mobile | default: 'left' | downcase
  endif

  assign headline = headline | default: ''
  assign body = body | default: ''
  assign body_plain = body | strip_html | strip
  assign body_display = body_plain | truncate: 165, '...'

  assign cta_label = cta_label | default: ''
  assign cta_url = cta_url | default: ''
  assign cta_open_in_new_tab = cta_open_in_new_tab | default: false, allow_false: true
  assign text_color = text_color | default: 'dark'
  assign overlay = overlay | default: ''
  assign cta_target = '_self'
  assign cta_attributes = ''
  if cta_open_in_new_tab
    assign cta_target = '_blank'
    assign cta_attributes = 'rel="noopener noreferrer"'
  endif

  assign background_type = background_type | default: 'image'
  assign desktop_image = desktop_image | default: null
  assign desktop_video = desktop_video | default: null
  assign mobile_image = mobile_image | default: desktop_image
  assign mobile_video = mobile_video | default: desktop_video

  assign show_play_button = show_play_button | default: false, allow_false: true
  assign show_mute_button = show_mute_button | default: false, allow_false: true

  assign image_alt_text = headline | strip_html | strip

  assign uid = uid | default: 'promo'
  assign video_class = 'js-promo-block-video-' | append: uid

  assign has_content = false
  if headline != blank or body_display != blank
    assign has_content = true
  endif
  if cta_label != blank and cta_url != blank
    assign has_content = true
  endif

  assign is_video = false
  if background_type == 'video'
    assign is_video = true
  endif

  assign show_controls = false
  if is_video
    if show_play_button or show_mute_button
      assign show_controls = true
    endif
  endif

  assign content_position_desktop = content_position_desktop | default: 'top_left'
  assign content_position_mobile = content_position_mobile | default: 'top_left'
  assign video_controls_position_desktop = video_controls_position_desktop | default: 'left'
  assign video_controls_position_mobile = video_controls_position_mobile | default: 'left'

  # Keep the controls off the same bottom corner as the content: if they'd
  # collide, flip them to the opposite side. Evaluated per breakpoint.
  assign controls_position_desktop = video_controls_position_desktop
  if content_position_desktop == 'bottom_left' and controls_position_desktop == 'left'
    assign controls_position_desktop = 'right'
  elsif content_position_desktop == 'bottom_right' and controls_position_desktop == 'right'
    assign controls_position_desktop = 'left'
  endif

  assign controls_position_mobile = video_controls_position_mobile
  if content_position_mobile == 'bottom_left' and controls_position_mobile == 'left'
    assign controls_position_mobile = 'right'
  elsif content_position_mobile == 'bottom_right' and controls_position_mobile == 'right'
    assign controls_position_mobile = 'left'
  endif
%}

<div
  class="{# style root #}{% if text_color == 'light' %} {# style root--light #}{% endif %}"
  data-content-position-mobile="{{ content_position_mobile }}"
  data-content-position-desktop="{{ content_position_desktop }}"
  data-controls-position-mobile="{{ controls_position_mobile }}"
  data-controls-position-desktop="{{ controls_position_desktop }}"
>
  <div class="{# style media #}">
    {% if is_video %}
      <div class="{# style media__video #}">
        {% render 'core-video',
          video: desktop_video,
          video_mobile: mobile_video,
          class: video_class,
          autoplay: false,
          loop: true,
          muted: true,
          playsinline: true,
          lazyload: true
        %}
      </div>
    {% else %}
      {% render 'core-image',
        image: desktop_image,
        image_mobile: mobile_image,
        image_alt_text: image_alt_text,
        object_fit: 'cover',
        class: '{# style media__image #}',
        srcset_print_sizes: '480,640,800,960,1280,1600',
        mobile_srcset_print_sizes: '320,480,640,768'
      %}
    {% endif %}
  </div>

  <div
    class="{# style overlay #}"
    {% if overlay != blank %}
      style="background:{{ overlay }}"
    {% endif %}
    aria-hidden="true"
  ></div>

  {% if has_content %}
    <div class="{# style content #}">
      {% if headline != blank %}
        <h2 class="{# style headline #}">{{ headline | newline_to_br }}</h2>
      {% endif %}

      {% if body_display != blank %}
        <div class="{# style body #}" data-body>{{ body_display }}</div>
      {% endif %}

      {% if cta_label != blank and cta_url != blank %}
        {% render 'core-button',
          url: cta_url,
          label: cta_label,
          target: cta_target,
          style: 'secondary',
          class: '{# style cta #}',
          attributes: cta_attributes
        %}
      {% endif %}
    </div>
  {% endif %}

  {% if show_controls %}
    <div class="{# style controls #}">
      {% render 'core-video-controls',
        video_class: video_class,
        has_pause: show_play_button,
        has_mute: show_mute_button,
        scroll_autoplay: true,
        pause_page_videos_on_play: false
      %}
    </div>
  {% endif %}
</div>
