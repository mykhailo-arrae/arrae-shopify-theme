{%- render 'search-results-stylesheet' -%}

{%- for item in search.results -%}
  <article class="{# style SearchResult #} {% if forloop.last %}is-last{% endif %}">
    {%- if item.featured_image -%}
      <div class="{# style SearchResult-image #}">
        <a href="{{ item.url }}" class="{# style SearchResult-imageLink #}" title="{{ item.title | escape }}">
          <div class="{# style SearchResult-imagePlaceholder #} o-placeholder" {% if item.featured_image %} style="background-image: url('{{ item.featured_image.src | image_url: width: 480 }}');"{% endif %}>
          </div>
        </a>
      </div>
    {%- endif -%}

    <div class="{# style SearchResult-info #}">
      <h4 class="{# style SearchResult-title #}">
        {{ item.title | link_to: item.url }}
      </h4>

      {%- assign result_excerpt = item.content | default: '' | strip_html | truncatewords: 50 -%}
      {%- if result_excerpt != blank -%}
        <div class="{# style SearchResult-excerpt #}">
            {{ result_excerpt }}
        </div>
      {% endif %}
    </div>
  </article>
{%- endfor -%}
