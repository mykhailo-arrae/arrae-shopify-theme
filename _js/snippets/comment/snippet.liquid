
<div class="{# style Comment #} {# style Comment #}_{{ comment.status | prepend: 'is-' }}">
  {% if forloop.first %}
    <style>
    .{# style Comment_is-spam #}::after {
      content: "{{ 'blogs.comments.spam' | t }}";
    }
    .{# style Comment_is-unapproved #}::after {
      content: "{{ 'blogs.comments.unapproved' | t }}";
    }
    </style>

    {% render 'comment-stylesheet' %}
  {% endif %}
  
  <div class="{# style Comment-info #}">
    <div class="{# style Comment-author #}">
      <strong>{{ comment.author }}</strong>
    </div>
    <div class="{# style Comment-createdAt #}">
      <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
        {{ comment.created_at | date: format: 'month_day_year' }}
      </time>
    </div>
  </div>

  <div class="{# style Comment-content #} o-rte">
    {{ comment.content }}
  </div>
</div>
