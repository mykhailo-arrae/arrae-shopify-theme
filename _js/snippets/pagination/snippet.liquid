{% comment %}Snippet Parameters -->{% endcomment %}
{%- assign paginate = paginate -%}
{% comment %}<-- Snippet Parameters{% endcomment %}

{% if paginate.pages > 1 %}
  <div class="{# style Pagination #}">
    {% render 'pagination-stylesheet' %}
    <ul class="{# style Pagination-items #}" role="menubar" aria-label="{{ 'general.pagination.title' | t }}">
      {% if paginate.previous.is_link %}
        <li class="{# style Pagination-arrow #}">
          <a class="{# style Pagination-arrowLink #}" href="{{ paginate.previous.url }}" rel="prev">
            <div class="u-vhide">
              {{ 'general.pagination.previous' | t }}
            </div>
            <div class="{# style Pagination-arrowLeft #}">
              {% render 'icon-arrow-left' %}
            </div>
          </a>
        </li>
      {% endif %}

      {% for part in paginate.parts %}
        {% assign item_class = '' %}

        {% if paginate.current_page == part.title %}
          {% assign item_class = 'current' %}
        {% elsif part.is_link == false %}
          {% assign item_class = 'dimmed' %}
        {% elsif part.url == paginate.previous.url %}
          {% assign item_class = 'prev' %}
        {% elsif part.url == paginate.next.url %}
          {% assign item_class = 'next' %}
        {% endif %}

        <li class="{# style Pagination-item #} {% if item_class != blank %}{# style Pagination-item #}_{{ item_class | prepend: 'is-' }}{% endif %}">
          {% if part.is_link or item_class == 'current' %}
            <a
              class="{# style Pagination-itemLink #}"
              href="{{ part.url | default: '#' }}"
              {% if item_class == 'current' %}
                aria-disabled="true"
              {% endif %}
            >
              <div class="u-vhide">
                {% if item_class == 'current' %}
                  {{ 'general.pagination.you_are_here' | t: page_number: part.title }}
                {% else %}
                  {{ 'general.pagination.page' | t: page_number: part.title, pages: paginate.pages }}
                {% endif %}
              </div>
              <span aria-hidden="true">
                {{ part.title }}
              </span>
            </a>
          {% else %}
            <div role="button" class="{# style Pagination-itemLink #}" aria-hidden="true">
              {{ part.title }}
            </div>
          {% endif %}
        </li>
      {% endfor %}

      {% if paginate.next.is_link %}
        <li class="{# style Pagination-arrow #}">
          <a class="{# style Pagination-arrowLink #}" href="{{ paginate.next.url }}" rel="next">
            <div class="u-vhide">
              {{ 'general.pagination.next' | t }}
            </div>
            <div class="{# style Pagination-arrowRight #}">
              {% render 'icon-arrow-right' %}
            </div>
          </a>
        </li>
      {% endif %}
    </ul>
  </div>
{% endif %}
