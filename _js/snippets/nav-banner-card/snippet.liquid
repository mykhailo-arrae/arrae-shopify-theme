{% doc %}
  Visual card used by mega-menu banners — the desktop `nav-banner`
  block and the mobile-only banner inside `nav-item` both render this
  snippet so the hover treatment, typography, and aspect ratio stay
  in sync between the two surfaces.

  Parent context controls layout (grid placement on desktop, drawer
  order/margin on mobile); this snippet owns the card visual itself.

  @param {image} image - Background image for the card.
  @param {string} title - Optional title rendered over the image.
  @param {string} url - Optional URL. When set, the card renders

  as an `<a>` and the chevron animates on hover; otherwise the card renders as a non-interactive `<div>`.

  @param {string} sizes - Optional `sizes` attribute for the

  underlying responsive image.

  @example
  {% render 'nav-banner-card',
    image: block.settings.image,
    title: block.settings.title,
    url: block.settings.url
  %}
{% enddoc %}

{% liquid
  assign image = image | default: null
  assign title = title | default: ''
  assign url = url | default: ''
  assign sizes = sizes | default: '(min-width: 1024px) 480px, 100vw'

  assign has_link = false
  if url != blank
    assign has_link = true
  endif

  assign aria_label = title | strip | escape
%}

{% if has_link %}
  <a
    class="{# style root #}"
    href="{{ url }}"
    {% if aria_label != blank %}
      aria-label="{{ aria_label }}"
    {% endif %}
  >
{% else %}
  <div class="{# style root #}" role="group">
{% endif %}

{% if image != blank %}
  <div class="{# style media #}">
    <div class="{# style media__base #}">
      {% render 'core-image',
        image: image,
        image_alt_text: title,
        object_fit: 'cover',
        sizes: sizes,
        srcset_print_sizes: '320,480,640,800,1024'
      %}
    </div>
    <div class="{# style overlay #}" aria-hidden="true"></div>
  </div>
{% endif %}

{% if title != blank %}
  <div class="{# style inner #}">
    <span class="{# style label #}">{{ title }}</span>
    {% if has_link %}
      <span class="{# style chevron #}" aria-hidden="true">
        {% render 'icon-chevron-left', width: 18, height: 18 %}
      </span>
    {% endif %}
  </div>
{% endif %}

{% if has_link %}
  </a>
{% else %}
  </div>
{% endif %}
