{% liquid
  # Initial variant mirrors product-details / product-options:
  # URL selected_variant → first available non-hidden in reversed order
  # (largest subscription first) → Shopify fallback.
  # Note: bundle v2 JS may refine this further after hydrate via
  # notification:selected-variant; keep JSON variantGalleries accurate so swaps work.
  assign gallery_initial_variant = product.selected_variant | default: null

  if gallery_initial_variant == null
    for variant in product.variants reversed
      assign hide_on_front_end = variant.metafields.custom.hide_on_front_end.value | default: false, allow_false: true
      unless hide_on_front_end
        if variant.available
          assign gallery_initial_variant = variant
          break
        endif
      endunless
    endfor
  endif

  if gallery_initial_variant == null
    assign gallery_initial_variant = product.selected_or_first_available_variant
  endif

  assign gallery_default_images = product.metafields.custom.pdp_gallery_images.value

  if gallery_default_images == blank
    assign gallery_default_images = product.images
  endif

  assign gallery_initial_override = null
  if gallery_initial_variant != blank
    assign gallery_initial_override = gallery_initial_variant.metafields.custom.variant_gallery_set.value | default: null
  endif

  assign gallery_is_variant_override = false
  assign gallery_initial_key = 'default'
  assign gallery_images = gallery_default_images
%}

{% assign gallery_override_has_renderable = false %}
{% if gallery_initial_override != blank %}
  {% for entry in gallery_initial_override %}
    {% capture entry_json %}
      {% render 'product-gallery-entry-json', entry: entry %}
    {% endcapture %}
    {% if entry_json contains '"src"' %}
      {% assign gallery_override_has_renderable = true %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

{% liquid
  if gallery_override_has_renderable
    assign gallery_images = gallery_initial_override
    assign gallery_is_variant_override = true
    assign gallery_initial_key = 'variant:' | append: gallery_initial_variant.id
  endif

  assign gallery_featured_media = product.metafields.custom.pdp_gallery_featured_media.value
  assign gallery_featured_index = 2
  assign gallery_featured_injected = false
  assign gallery_featured_is_video = false
  assign gallery_featured_video_class = 'js-product-gallery-featured-' | append: product.id
  assign gallery_show_featured = false

  if gallery_is_variant_override == false and gallery_featured_media != blank
    assign gallery_show_featured = true
  endif

  if gallery_featured_media != blank and gallery_featured_media.sources != blank
    assign gallery_featured_is_video = true
  endif
%}

{% capture gallery_slide_class %}{# style gallery--slide #}{% endcapture %}
{% capture gallery_image_class %}{# style gallery--image #}{% endcapture %}

{% assign gallery_renderable_count = 0 %}
{% for entry in gallery_images %}
  {% capture entry_json %}
    {% render 'product-gallery-entry-json', entry: entry %}
  {% endcapture %}
  {% assign entry_src_count = entry_json | split: '"src"' | size | minus: 1 %}
  {% if entry_src_count > 0 %}
    {% assign gallery_renderable_count = gallery_renderable_count | plus: entry_src_count %}
  {% endif %}
{% endfor %}

{% capture default_gallery_images %}
  [
    {%- assign default_image_first = true -%}
    {%- for entry in gallery_default_images -%}
      {%- capture entry_json -%}
        {%- render 'product-gallery-entry-json', entry: entry -%}
      {%- endcapture -%}
      {%- assign entry_json = entry_json | strip -%}
      {%- if entry_json != blank -%}
        {%- unless default_image_first -%},{%- endunless -%}
        {{ entry_json }}
        {%- assign default_image_first = false -%}
      {%- endif -%}
    {%- endfor -%}
  ]
{% endcapture %}

{% capture variant_gallery_sets %}
  {
    {%- assign variant_gallery_first = true -%}
    {%- for variant in product.variants -%}
      {%- assign variant_gallery = variant.metafields.custom.variant_gallery_set.value | default: null -%}
      {%- if variant_gallery != blank -%}
        {%- capture variant_gallery_images_json -%}
          [
            {%- assign variant_image_first = true -%}
            {%- for entry in variant_gallery -%}
              {%- capture entry_json -%}
                {%- render 'product-gallery-entry-json', entry: entry -%}
              {%- endcapture -%}
              {%- assign entry_json = entry_json | strip -%}
              {%- if entry_json != blank -%}
                {%- unless variant_image_first -%},{%- endunless -%}
                {{ entry_json }}
                {%- assign variant_image_first = false -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        {%- endcapture -%}
        {%- if variant_gallery_images_json contains '"src"' -%}
          {%- unless variant_gallery_first -%},{%- endunless -%}
          "{{ variant.id }}": {{ variant_gallery_images_json }}
          {%- assign variant_gallery_first = false -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  }
{% endcapture %}

{%- capture gallery_featured_markup -%}
  {%- if gallery_featured_media != blank -%}
    <div class="js-product-gallery-featured {# style gallery--featured #}">
      {%- if gallery_featured_is_video -%}
        {% render 'core-video',
          video: gallery_featured_media,
          class: gallery_featured_video_class,
          autoplay: false,
          muted: true,
          loop: true,
          controls: false,
          lazyload: true,
          playsinline: true
        %}
        <div class="{# style gallery--featured-controls #}">
          {% render 'core-video-controls',
            class: '{# style gallery--featured-video-controls #}',
            has_pause: true,
            has_mute: true,
            video_class: gallery_featured_video_class,
            scroll_autoplay: false,
            play_on_click_video: true
          %}
        </div>
      {%- else -%}
        {% capture featured_src %}
          {% render 'product-gallery-image-src', image: gallery_featured_media, width: 1600 %}
        {% endcapture %}
        {% assign featured_src = featured_src | strip %}
        {% if featured_src != blank %}
          <div class="{{ gallery_image_class }}">
            {% render 'product-gallery-img',
              src: featured_src,
              alt: gallery_featured_media.alt | default: '',
              lazyload: true
            %}
          </div>
        {% endif %}
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<script type="application/json" class="js-product-gallery-props">
  {
    "defaultImages": {{ default_gallery_images }},
    "variantGalleries": {{ variant_gallery_sets }},
    "initialGalleryKey": {{ gallery_initial_key | json }}
  }
</script>

<div
  class="{# style gallery #}"
  data-product-id="{{ product.id }}"
>
  <div class="{# style gallery--carousel #}">
    <div class="{# style gallery--carousel-outer #}">
      <div class="swiper js-product-gallery-swiper">
        <div class="swiper-wrapper">
          {%- for entry in gallery_images -%}
            {% render 'product-gallery-entry-markup',
              entry: entry,
              layout: 'carousel',
              slide_class: gallery_slide_class,
              image_class: gallery_image_class,
              lazyload: true
            %}
          {%- endfor -%}
        </div>
        {%- if gallery_renderable_count > 1 -%}
          <div class="{# style gallery--carousel-pagination #} swiper-pagination"></div>
        {%- endif -%}
      </div>

      {%- if gallery_renderable_count > 1 -%}
        <div class="{# style gallery--carousel-nav #} swiper-navigation-arrows js-nav-arrows">
          <button
            type="button"
            class="swiper-button-prev {# style gallery--arrow #}"
            title="{{ 'accessibility.previous_slide' | t }}"
            aria-label="{{ 'accessibility.previous_slide' | t }}"
          >
            <span aria-hidden="true">{%- render 'icon-arrow-left' -%}</span>
          </button>

          <button
            type="button"
            class="swiper-button-next {# style gallery--arrow #}"
            title="{{ 'accessibility.next_slide' | t }}"
            aria-label="{{ 'accessibility.next_slide' | t }}"
          >
            <span aria-hidden="true">{%- render 'icon-arrow-right' -%}</span>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="{# style gallery--images #} js-product-gallery-desktop">
    {%- assign gallery_desktop_index = 0 -%}
    {%- for entry in gallery_images -%}
      {%- if gallery_show_featured and gallery_desktop_index == gallery_featured_index -%}
        {{ gallery_featured_markup }}
        {%- assign gallery_featured_injected = true -%}
      {%- endif -%}
      {%- capture entry_markup -%}
        {% render 'product-gallery-entry-markup',
          entry: entry,
          layout: 'desktop',
          slide_class: gallery_slide_class,
          image_class: gallery_image_class,
          lazyload: true
        %}
      {%- endcapture -%}
      {{ entry_markup }}
      {%- if entry_markup contains '<img' -%}
        {%- assign gallery_desktop_index = gallery_desktop_index | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if gallery_show_featured and gallery_featured_injected == false -%}
      {{ gallery_featured_markup }}
    {%- endif -%}
  </div>

  {%- if gallery_is_variant_override -%}
    {%- assign gallery_default_featured_injected = false -%}
    <template class="js-product-gallery-default-carousel">
      {%- for entry in gallery_default_images -%}
        {% render 'product-gallery-entry-markup',
          entry: entry,
          layout: 'carousel',
          slide_class: gallery_slide_class,
          image_class: gallery_image_class,
          lazyload: false
        %}
      {%- endfor -%}
    </template>

    <template class="js-product-gallery-default-desktop">
      {%- assign gallery_default_desktop_index = 0 -%}
      {%- for entry in gallery_default_images -%}
        {%- if gallery_featured_media != blank and gallery_default_desktop_index == gallery_featured_index -%}
          {{ gallery_featured_markup }}
          {%- assign gallery_default_featured_injected = true -%}
        {%- endif -%}
        {%- capture entry_markup -%}
          {% render 'product-gallery-entry-markup',
            entry: entry,
            layout: 'desktop',
            slide_class: gallery_slide_class,
            image_class: gallery_image_class,
            lazyload: false
          %}
        {%- endcapture -%}
        {{ entry_markup }}
        {%- if entry_markup contains '<img' -%}
          {%- assign gallery_default_desktop_index = gallery_default_desktop_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if gallery_featured_media != blank and gallery_default_featured_injected == false -%}
        {{ gallery_featured_markup }}
      {%- endif -%}
    </template>
  {%- endif -%}

  <template class="js-product-gallery-carousel-slide-template">
    <div class="swiper-slide {{ gallery_slide_class }}">
      <div class="{{ gallery_image_class }}">
        <img src="" alt="" loading="lazy" decoding="async" width="1280" height="1707">
      </div>
    </div>
  </template>

  <template class="js-product-gallery-desktop-image-template">
    <div class="{{ gallery_image_class }}">
      <img src="" alt="" loading="lazy" decoding="async" width="1280" height="1707">
    </div>
  </template>
</div>
