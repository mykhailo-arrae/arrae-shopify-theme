{% doc %}
  @description
  A snippet to display an image
  - Supports separate desktop and mobile images
  - Accessibility: alt text is required for both images, with a fallback from mobile to desktop
  - Supports lazy loading and preloading for performance optimization


  @param {object} image - The image object to render
  @param {object} image_mobile - The mobile image object to render
  @param {string} image_alt_text - The alt text for the desktop image
  @param {string} image_mobile_alt_text - The alt text for the mobile image (defaults to image_alt_text)
  @param {string} mode - The image mode for the wrapper (e.g., 'cover', 'contain'). Defaults to 'cover'.
  @param {string} object_fit - The `object-fit` CSS property for the image (e.g., 'cover', 'contain'). Defaults to 'cover'.
  @param {boolean} force_aspect_ratio - Overrides the default aspect ratio of the image (if null, defaults to natural image aspect ratio).
  @param {boolean} lazyload - Set to "false" to disable lazy loading. Defaults to "true".
  @param {string} sizes - The `sizes` attribute for the image, controlling responsive image behavior. Defaults to '100vw'.
  @param {boolean} srcset_print_sizes - Custom sizes for the `srcset` attribute, passed to 'core-image-print-sizes' partial. Defaults to false.
  @param {boolean} mobile_srcset_print_sizes - Custom sizes for the mobile `srcset` attribute, passed to 'core-image-print-sizes' partial. Defaults to false.
  @param {boolean} preload - Set to "true" to preload the images, useful for above-the-fold images. Defaults to "false".
  @param {string} class - Additional classes to add to the image element
  @param {string} decoding - "sync" or "async". Defaults to "async".
  @param {string} fetchpriority - "high" or "low". Defaults to "low" (automatically set to "high" if lazyload is false).

  @example
  {% render 'core-image',
    image: image,
    image_mobile: image_mobile,
    image_alt_text: 'Alt text',
    object_fit: 'cover',
    force_aspect_ratio: 1,
    preload: true
  %}
{% enddoc %}

{% liquid
  assign image = image | default: null
  assign image_focal_point = image.presentation.focal_point | default: null
  assign image_alt_text = image_alt_text | default: image.alt | default: 'Alt text not provided for this image'
  assign image_mobile = image_mobile | default: null
  assign image_mobile_focal_point = image_mobile.presentation.focal_point | default: null
  assign image_mobile_alt_text = image_mobile_alt_text | default: image_mobile.alt | default: image_alt_text | default: 'Alt text not provided for this image'
  assign mode = mode | default: 'cover'
  assign object_fit = object_fit | default: 'cover'
  assign force_aspect_ratio = force_aspect_ratio | default: null
  assign lazyload = lazyload | default: true, allow_false: true
  assign sizes = sizes | default: '100vw'
  assign fetchpriority = fetchpriority | default: 'low'
  assign srcset_print_sizes = srcset_print_sizes | default: false
  assign mobile_srcset_print_sizes = mobile_srcset_print_sizes | default: false
  assign preload = preload | default: false
  assign class = class | default: null
  assign decoding = decoding | default: 'async'
  assign fetchpriority = fetchpriority | default: 'low'
%}

{%- capture large_image_markup -%}
  {%- if image -%}
    {%- capture image_sizes -%}
      {%- render 'core-image-print-sizes', image: image, sizes: srcset_print_sizes -%}
    {%- endcapture -%}

    {%- capture image_spacing -%}
      {%- render 'core-image-spacer', image: image, aspect_ratio: force_aspect_ratio -%}
    {%- endcapture -%}

    {%- if preload -%}
      <link rel="preload" fetchpriority="high" as="image" href="{{ image | image_url: width: 320 }}" imagesrcset="{{ image_sizes }}" imagesizes="{{ sizes }}">
    {%- endif -%}

    <div
      class="{# style container #} {# style container #}--{{ mode }} {% if image_mobile %} {# style container--desktop #}{% endif %}">
      <div class="{# style spacer #}" style="{{ image_spacing }}"></div>
      <img
        class="{# style image #} {{ class }}"
        src="{{ image | image_url: width: 320 }}"
        decoding="{{ decoding }}"
        sizes="{{ sizes }}"
        alt="{{ image_alt_text }}"
        fetchpriority="{{ fetchpriority }}"
        loading="{% if lazyload %}lazy{% else %}eager{% endif %}"
        srcset="{{ image_sizes }}"
        {% if image.width != blank %}
        width="{{ image.width }}"
        {% endif %}
        {% if image.height != blank %}
        height="{{ image.height }}"
        {% endif %}
        style="object-fit: {{ object_fit }};{% if image_focal_point %} object-position: {{ image_focal_point }};{% endif %}"
      >
    </div>
  {% endif %}
{%- endcapture -%}
{%- capture image_mobile_markup -%}
  {%- if image_mobile -%}
    {%- capture image_mobile_sizes -%}
      {%- render 'core-image-print-sizes', image: image_mobile, sizes: mobile_srcset_print_sizes -%}
    {%- endcapture -%}

    {%- capture image_mobile_spacing -%}
      {%- render 'core-image-spacer', image: image_mobile, aspect_ratio: force_aspect_ratio -%}
    {%- endcapture -%}

    {%- if preload -%}
      <link rel="preload" as="image" href="{{ image_mobile | image_url: width: 320 }}" imagesrcset="{{ image_mobile_sizes }}" imagesizes="{{ sizes }}">
    {%- endif -%}

    <div class="{# style container #} {# style container #}--{{ mode }} {# style container--mobile #}">
      <div class="{# style spacer #}" style="{{ image_mobile_spacing }}"></div>
      <img
        class="{# style image #} {{ class }}"
        src="{{ image_mobile | image_url: width: 320 }}"
        decoding="{{ decoding }}"
        sizes="{{ sizes }}"
        alt="{{ image_mobile_alt_text }}"
        fetchpriority="{{ fetchpriority }}"
        loading="{% if lazyload %}lazy{% else %}eager{% endif %}"
        srcset="{{ image_mobile_sizes }}"
        {% if image_mobile.width != blank %}
        width="{{ image_mobile.width }}"
        {% endif %}
        {% if image_mobile.height != blank %}
        height="{{ image_mobile.height }}"
        {% endif %}
        style=" object-fit: {{ object_fit }};{% if image_mobile_focal_point %}object-position: {{ image_mobile_focal_point }};{% endif %}"
        >
    </div>
  {%- endif -%}
{%- endcapture -%}

