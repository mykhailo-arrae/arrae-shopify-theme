{% comment %}
  Comparison chart for the Science section. Renders a single accessible
  canvas (driven by Chart.js in _js/sections/science-chart/index.ts) plus a custom
  HTML legend and a visually-hidden data table fallback.

  Every value is settings-driven: the parent Science section passes these
  params from the Theme Editor. The defaults below keep the snippet usable on its own.

  Params (all optional, with defaults):
    chart_title      - Chart title.
    footnote         - Chart footnote.
    chart_type       - 'bar' or 'line'.
    primary_label    - Legend + label for the primary dataset.
    secondary_label  - Legend + label for the secondary dataset.
    color_primary    - Color for the primary dataset.
    color_secondary  - Color for the secondary dataset.
    line_color_primary - Color for the primary dataset line.
    line_color_secondary - Color for the secondary dataset line.
    axis_labels      - Comma-separated x-axis category labels.
    primary_values   - Comma-separated primary dataset values.
    secondary_values - Comma-separated secondary dataset values.
    axis_x_title     - X-axis title.
    axis_y_title     - Y-axis title.
    y_min            - Lower bound of the y-axis.
    y_max            - Upper bound of the y-axis.
    y_step           - Interval between y-axis ticks.
    aria_label       - Accessible summary for the chart canvas.
{% endcomment %}

{% liquid
  assign chart_title = chart_title | default: null
  assign footnote = footnote | default: null
  assign chart_type = chart_type | default: 'bar'
  assign primary_label = primary_label | default: 'MB-1'
  assign secondary_label = secondary_label | default: 'Other'
  assign color_primary = color_primary | default: '#f8a28c'
  assign color_secondary = color_secondary | default: '#efe7da'
  assign line_color_primary = line_color_primary | default: '#23180C'
  assign line_color_secondary = line_color_secondary | default: '#23180C'
  assign axis_x_title = axis_x_title | default: 'Weeks'
  assign axis_y_title = axis_y_title | default: '% Body Fat Reduction'
  assign y_min = y_min | default: 0
  assign y_max = y_max | default: 40
  assign y_step = y_step | default: 10

  assign axis_labels = axis_labels | default: '2,4,6,8,10'
  assign primary_values = primary_values | default: '8,19,24,28,37'
  assign secondary_values = secondary_values | default: '6,17,19,22,31'

  assign labels_arr = axis_labels | split: ','
  assign primary_arr = primary_values | split: ','
  assign secondary_arr = secondary_values | split: ','

  if aria_label == blank
    assign aria_label = primary_label | append: ' vs ' | append: secondary_label | append: ', ' | append: axis_y_title | append: ' by ' | append: axis_x_title
  endif
%}

<figure class="{# style chart #} js-chart" data-chart-type="{{ chart_type }}">
  <figcaption class="{# style caption #}">
    {% if chart_title != blank %}
      <p class="{# style title #}">{{ chart_title }}</p>
    {% endif %}

    <div class="{# style buttons #}">
      <button
        type="button"
        class="{# style button #} js-chart-legend-item"
        data-dataset-key="primary"
        aria-pressed="true"
      >
        <span
          class="{# style button__dot #}"
          style="background-color: {{ color_primary }};"
          aria-hidden="true"
        ></span>
        {{ primary_label }}
      </button>
      <button
        type="button"
        class="{# style button #} js-chart-legend-item"
        data-dataset-key="secondary"
        aria-pressed="true"
      >
        <span
          class="{# style button__dot #}"
          style="background-color: {{ color_secondary }};"
          aria-hidden="true"
        ></span>
        {{ secondary_label }}
      </button>
    </div>
  </figcaption>

  <div class="{# style canvas-wrap #}">
    <canvas
      class="{# style canvas #} js-chart-canvas"
      role="img"
      aria-label="{{ aria_label | strip | escape }}"
    >
      {%- comment -%} Screen-reader / no-JS fallback {%- endcomment -%}
      <table class="{# style sr-table #}">
        <caption>
          {{ aria_label | strip | escape }}
        </caption>
        <thead>
          <tr>
            <th scope="col">{{ axis_x_title }}</th>
            <th scope="col">{{ primary_label }}</th>
            <th scope="col">{{ secondary_label }}</th>
          </tr>
        </thead>
        <tbody>
          {% for label in labels_arr %}
            <tr>
              <th scope="row">{{ label | strip }}</th>
              <td>{{ primary_arr[forloop.index0] | strip }}</td>
              <td>{{ secondary_arr[forloop.index0] | strip }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </canvas>
  </div>

  {% if footnote != blank %}
    <div class="{# style footnote #}">
      {{ footnote }}
    </div>
  {% endif %}

  <script type="application/json" class="js-chart-data">
    {
      "type": {{ chart_type | json }},
      "labels": {{ axis_labels | json }},
      "yMin": {{ y_min | json }},
      "yMax": {{ y_max | json }},
      "yStep": {{ y_step | json }},
      "axisX": {{ axis_x_title | json }},
      "axisY": {{ axis_y_title | json }},
      "datasets": [
        {
          "key": "primary",
          "label": {{ primary_label | json }},
          "color": "{{ color_primary }}",
          "lineColor": "{{ line_color_primary }}",
          "values": {{ primary_values | json }}
        },
        {
          "key": "secondary",
          "label": {{ secondary_label | json }},
          "color": "{{ color_secondary }}",
          "lineColor": "{{ line_color_secondary }}",
          "values": {{ secondary_values | json }}
        }
      ]
    }
  </script>
</figure>
