{% liquid
  assign headline = section.settings.headline | default: ''
  assign body = section.settings.body | default: ''

  assign cta_label = section.settings.cta_label
  assign cta_url = section.settings.cta_url
  assign cta_open_in_new_tab = section.settings.cta_open_in_new_tab
  assign cta_target = '_self'
  if cta_open_in_new_tab
    assign cta_target = '_blank'
  endif

  assign reverse_columns = section.settings.reverse_columns

  assign background_type = section.settings.background_type | default: 'image'
  assign desktop_image = section.settings.desktop_image
  assign desktop_video = section.settings.desktop_video
  assign mobile_image = section.settings.mobile_image | default: desktop_image
  assign mobile_video = section.settings.mobile_video | default: desktop_video
  assign image_alt_text = headline | strip_html | strip

  assign signature_video = section.settings.signature_video

  assign show_play_button = section.settings.show_play_button
  assign show_mute_button = section.settings.show_mute_button

  assign video_class = 'js-section-70-30-video-' | append: section.id

  assign is_first_section = false
  if section.index == 1
    assign is_first_section = true
  endif

  assign image_lazyload = true
  assign image_preload = false
  assign image_fetchpriority = 'low'
  if is_first_section
    assign image_lazyload = false
    assign image_preload = true
    assign image_fetchpriority = 'high'
  endif
%}

<div
  class="{# style root #}"
  data-section-id="{{ section.id }}"
  data-reverse="{{ reverse_columns }}"
>
  <div class="{# style container #}">
    <div class="{# style media-column #}">
      <div class="{# style media #}">
        {% if background_type == 'image' %}
          {% render 'core-image',
            image: desktop_image,
            image_mobile: mobile_image,
            image_alt_text: image_alt_text,
            object_fit: 'cover',
            class: '{# style media__image #}',
            lazyload: image_lazyload,
            preload: image_preload,
            fetchpriority: image_fetchpriority,
            srcset_print_sizes: '480,640,800,960,1280,1600',
            mobile_srcset_print_sizes: '320,480,640,768'
          %}
        {% elsif background_type == 'video' %}
          <div class="{# style media__video #}">
            {% render 'core-video',
              video: desktop_video,
              video_mobile: mobile_video,
              class: video_class,
              autoplay: false,
              loop: true,
              muted: true,
              playsinline: true,
              lazyload: true
            %}
          </div>
          <div class="{# style media__controls #}">
            {%- comment -%}
              `pause_page_videos_on_play: false` keeps the decorative signature
              video alongside this one running. Both videos in this section are
              muted (autoplay requires it), so there is no audio collision to
              guard against.
            {%- endcomment -%}
            {% render 'core-video-controls',
              video_class: video_class,
              has_pause: show_play_button,
              has_mute: show_mute_button,
              scroll_autoplay: true,
              pause_page_videos_on_play: false
            %}
          </div>
        {% elsif background_type == 'embedded_video' %}
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?enablejsapi=1"
              class="{# style media__embed #} js-youtube"
              title="{{ image_alt_text | default: 'Embedded video' | escape }}"
              allow="autoplay; encrypted-media; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          {%- else -%}
            <iframe
              src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}"
              class="{# style media__embed #} js-vimeo"
              title="{{ image_alt_text | default: 'Embedded video' | escape }}"
              allow="autoplay; encrypted-media; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          {%- endif -%}
        {% endif %}
      </div>
    </div>

    <div class="{# style content-column #}">
      <div class="{# style content #}">
        {% if headline != blank or body != blank %}
          <div class="{# style content__copy #}">
            {% if headline != blank %}
              {% if is_first_section %}
                <h1 class="{# style headline #}">{{ headline | newline_to_br }}</h1>
              {% else %}
                <h2 class="{# style headline #}">{{ headline | newline_to_br }}</h2>
              {% endif %}
            {% endif %}

            {% if body != blank %}
              <div class="{# style body #}">{{ body }}</div>
            {% endif %}
          </div>
        {% endif %}

        {% if signature_video != blank %}
          {%- comment -%}
            Decorative animated signature — autoplay + muted + loop is enough
            for native browser autoplay; no controls needed.
          {%- endcomment -%}
          <div class="{# style signature #}" aria-hidden="true">
            {% render 'core-video',
              video: signature_video,
              autoplay: true,
              loop: true,
              loop_count: section.settings.signature_video_loop_count,
              muted: true,
              playsinline: true,
              lazyload: true,
              skip_focus: true
            %}
          </div>
        {% endif %}

        {% if cta_label != blank and cta_url != blank %}
          {% render 'core-button',
            url: cta_url,
            label: cta_label,
            target: cta_target,
            style: 'secondary',
            class: '{# style cta #}'
          %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Section 70/30",
  "tag": "section",
  "class": "{# style section #}",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "reverse_columns",
      "label": "Reverse columns on desktop",
      "info": "On mobile the media column is always shown first.",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "The Visionary Minds Behind Arrae's Success and Innovation"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>Meet our co-founders, Siff and Nish, a husband and wife duo who set out in 2020 to redefine holistic wellness, for themselves and for you.</p>"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link",
      "info": "Supports both internal pages and external URLs."
    },
    {
      "type": "checkbox",
      "id": "cta_open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        },
        {
          "value": "embedded_video",
          "label": "Embedded Video (YouTube or Vimeo)"
        }
      ],
      "default": "image"
    },
    {
      "type": "header",
      "content": "Desktop media",
      "info": "Used on screens 1024px and wider."
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Image",
      "info": "Used when the background type is set to image.",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "desktop_video",
      "label": "Video",
      "info": "When set, autoplays muted and loops. Recommended aspect ratio: 5:3.",
      "visible_if": "{{ section.settings.background_type == 'video' }}"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "label": "Video URL",
      "placeholder": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "info": "Supports both YouTube and Vimeo. It is used for desktop and mobile.",
      "visible_if": "{{ section.settings.background_type == 'embedded_video' }}"
    },
    {
      "type": "header",
      "content": "Mobile media",
      "info": "Used on screens below 1024px. Falls back to the desktop image if left blank."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image",
      "visible_if": "{{ section.settings.background_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Video",
      "info": "Recommended aspect ratio: 4:5.",
      "visible_if": "{{ section.settings.background_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "Video controls",
      "info": "Only shown when a video is set."
    },
    {
      "type": "checkbox",
      "id": "show_play_button",
      "label": "Show play / pause button",
      "default": true,
      "visible_if": "{{ section.settings.background_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "show_mute_button",
      "label": "Show mute / unmute button",
      "default": true,
      "visible_if": "{{ section.settings.background_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "Animated signature",
      "info": "Optional small looping video shown above the CTA button (e.g. an animated handwritten signature)."
    },
    {
      "type": "video",
      "id": "signature_video",
      "label": "Signature video"
    },
    {
      "type": "number",
      "id": "signature_video_loop_count",
      "label": "Signature video loop count",
      "info": "How many times the signature video plays before stopping on its final frame. Leave blank for continuous looping.",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Section 70/30",
      "category": "Content"
    }
  ]
}
{% endschema %}
