{%- liquid
  assign autoplay_delay = section.settings.autoplay_delay

  assign previous_slide_title = 'accessibility.previous_slide' | t
  assign next_slide_title = 'accessibility.next_slide' | t
  assign region_label = 'sections.announcement_bar.region_label' | t

  assign transparent_header_paths = settings.transparent_header_paths | split: ','
  assign is_transparent = false
  if template == 'index' or transparent_header_paths contains request.path
    assign is_transparent = true
  endif
-%}

{% if section.blocks.size > 0 %}
  <div
    class="{# style root #} js-announcement-bar-container"
    data-transparent="{% if is_transparent %}true{% else %}false{% endif %}"
    data-scrolled="false"
  >
    <div
      class="{# style swiper #} swiper js-slider"
      data-item-count="{{ section.blocks.size }}"
      data-autoplay-delay="{{ autoplay_delay }}"
      role="region"
      aria-label="{{ region_label }}"
    >
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {%- liquid
            assign announcement = block.settings.announcement
            assign link = block.settings.link
            assign link_opens_in_new_tab = block.settings.link_opens_in_new_tab
          -%}

          <div
            class="{# style slide #} swiper-slide"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ 'sections.announcement_bar.slide_label' | t: index: forloop.index, total: section.blocks.size }}"
            {{ block.shopify_attributes }}
          >
            {% if announcement != blank %}
              {% if link != blank %}
                <a
                  href="{{ link }}"
                  class="{# style text #} js-announcement-text"
                  {% if link_opens_in_new_tab %}
                    target="_blank"
                    rel="noopener noreferrer"
                  {% endif %}
                >
                  {{ announcement }}
                </a>
              {% else %}
                <p class="{# style text #} js-announcement-text">
                  {{ announcement }}
                </p>
              {% endif %}
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    {% if section.blocks.size > 1 %}
      <button
        type="button"
        aria-label="{{ previous_slide_title }}"
        class="{# style arrow #} {# style arrow--prev #} js-slider-prev"
      >
        {% render 'icon-arrow-left', width: 32, height: 32, title: previous_slide_title %}
      </button>
      <button
        type="button"
        aria-label="{{ next_slide_title }}"
        class="{# style arrow #} {# style arrow--next #} js-slider-next"
      >
        {% render 'icon-arrow-right', width: 32, height: 32, title: next_slide_title %}
      </button>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "class": "{# style section #} js-announcement-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay Delay",
      "default": 4,
      "info": "Delay in seconds. Autoplay is disabled automatically for users who prefer reduced motion.",
      "unit": "s",
      "min": 1,
      "max": 10,
      "step": 1
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Announcement",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "announcement",
          "label": "Announcement Message",
          "default": "Free delivery on all subscriptions",
          "info": "*Required"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "link_opens_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "category": "Header",
      "blocks": [
        {
          "type": "text",
          "name": "Announcement",
          "settings": {
            "announcement": "Free delivery on all subscriptions"
          }
        },
        {
          "type": "text",
          "name": "Announcement",
          "settings": {
            "announcement": "Free returns within 30 days"
          }
        }
      ]
    }
  ]
}
{% endschema %}
