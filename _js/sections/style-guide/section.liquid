                <span class="{# style icons__icon__label #}">
                  {{ 'icons_leaf' | t }}
                </span>
              </div>
              <div class="{# style icons__icon #}">
                <div class="{# style icons__icon__svg #}">
                  {% render 'icon-focus' %}
                </div>
                <span class="{# style icons__icon__label #}">
                  {{ 'icons_focus' | t }}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- [[ BUTTONS ✅ ]] -->
  <div id="buttons" class="{# style section #} js-section">
    <div class="{# style section__header #}">
      <span class="{# style section__tagline #}">
        {{ 'title' | t }}
      </span>
      <h2 class="{# style section__title #}">
        {{ 'buttons_title' | t }}
      </h2>
    </div>
    <div class="{# style section__main #}">
      <div class="{# style section__container #}">
        <div class="{# style section__rows #}">
          <div class="{# style section__row #} {# style buttons__row #}">
            <div class="{# style section__columns #}">
              <div class="{# style section__column #}">
                <div class="{# style section__label #}">
                  {{ 'subtitles_buttons' | t }}
                </div>
              </div>
              <div class="{# style section__column #}">
                <div class="{# style section__label #}">
                  {{ 'subtitles_spec' | t }}
                </div>
              </div>
            </div>
          </div>
          <div class="{# style section__row #} {# style buttons__row #}">
            <div class="{# style section__columns #}">
              <div class="{# style section__column #}">
                <div class="{# style buttons__label #}">
                  <br>
                </div>
              </div>
              <div class="{# style section__column #}">
                <div class="{# style buttons__label #} {# style buttons__label #}">
                  {{ 'states_active' | t }}
                </div>
              </div>
              <div class="{# style section__column #}">
                <div class="{# style buttons__label #} {# style buttons__label #}">
                  {{ 'states_disabled' | t }}
                </div>
              </div>
            </div>
          </div>
          <div class="{# style section__row #} {# style buttons__row #}">
            <div class="{# style section__columns #} {# style buttons__column #}">
              <div class="{# style section__column #}">
                <div class="{# style buttons__label #} {# style buttons__label #}">
                  {{ 'button_primary' | t }}
                </div>
              </div>
              <div class="{# style section__column #}">
                {% render 'core-button', label: 'Primary Button', style: 'primary' %}
              </div>
              <div class="{# style section__column #}">
                {% render 'core-button', label: 'Primary Disabled', is_disabled: true %}
              </div>
            </div>
          </div>
          <div class="{# style section__row #} {# style buttons__row #}">
            <div class="{# style section__columns #} {# style buttons__column #}">
              <div class="{# style section__column #}">
                <div class="{# style buttons__label #} {# style buttons__label #}">
                  {{ 'button_secondary' | t }}
                </div>
              </div>
              <div class="{# style section__column #}">
                {% render 'core-button', label: 'Secondary Button', style: 'secondary' %}
              </div>
              <div class="{# style section__column #}">
                {% render 'core-button', label: 'Secondary Disabled', style: 'secondary', is_disabled: true %}
              </div>
            </div>
          </div>
          <div class="{# style section__row #} {# style buttons__row #}">
            <div class="{# style section__columns #} {# style buttons__column #}">
              <div class="{# style section__column #}">
                <div class="{# style buttons__label #} {# style buttons__label #}">
                  {{ 'button_text_link_large' | t }}
                </div>
              </div>
              <div class="{# style section__column #}">
                {% render 'core-button', label: 'Text Link Large', style: 'text-link-large' %}
              </div>
              <div class="{# style section__column #}">&nbsp;</div>
            </div>
          </div>
          <div class="{# style section__row #} {# style buttons__row #}">
            <div class="{# style section__columns #} {# style buttons__column #}">
              <div class="{# style section__column #}">
                <div class="{# style buttons__label #} {# style buttons__label #}">
                  {{ 'button_text_link' | t }}
                </div>
              </div>
              <div class="{# style section__column #}">
                {% render 'core-button', label: 'text link', style: 'text-link' %}
              </div>
              <div class="{# style section__column #}">&nbsp;</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- [[ FORMS ✅ ]] -->
  <div id="forms" class="{# style section #} js-section">
    <div class="{# style section__header #}">
      <span class="{# style section__tagline #}">
        {{ 'title' | t }}
      </span>
      <h2 class="{# style section__title #}">
        {{ 'forms_title' | t }}
      </h2>
    </div>
    <div class="{# style section__main #}">
      <div class="{# style section__container #} {# style forms #}">
        <div class="{# style section__rows #} {# style forms__rows #}">
          <!-- [[ NOTIFICATIONS ]] -->
          <div class="{# style section__row #}">
            <h3 class="{# style section__subtitle #}">
              {{ 'forms_notifications_subtitle' | t }}
            </h3>
            <div class="{# style section__divider #}"></div>
          </div>
          <div class="{# style section__row #}">
            <div class="{# style forms__successMessage #}">
              {{ 'forms_success' | t }}
              <span class="{# style forms__successMessage__close #}">
                {% render 'icon-close' %}
              </span>
            </div>
          </div>
          <div class="{# style section__row #}">
            <div class="{# style forms__errorMessage #}">
              {{ 'forms_error' | t }}
              <span class="{# style forms__errorMessage__close #}">
                {% render 'icon-close' %}
              </span>
            </div>
          </div>
          <div class="{# style section__row #}">
            <div class="{# style forms__neutralMessage #}">
              {{ 'forms_neutral' | t }}
              <span class="{# style forms__neutralMessage__close #}">
                {% render 'icon-close' %}
              </span>
            </div>
            <br>
          </div>

          <!-- [[ INPUTS ]] -->
          <div class="{# style section__row #}">
            <h3 class="{# style section__subtitle #}">
              {{ 'forms_inputs_subtitle' | t }}
            </h3>
            <div class="{# style section__divider #}"></div>
          </div>
          <div class="{# style section__row #}">
            <div class="{# style forms__inputs-wrapper #}">
              <!-- [[ LABEL ABOVE ]] -->
              <fieldset class="{# style forms__fieldset #}">
                <label class="{# style forms__label #}" for="test-input-1">
                  {{- 'forms_label' | t -}}
                </label>
                <input
                  type="text"
                  name="test-input-1"
                  id="test-input-1"
                  class="{# style forms__input #}"
                  placeholder="{{ 'forms_placeholder' | t }}"
                >
                <div class="{# style forms__message #}">
                  {{ 'forms_message' | t }}
                </div>
                <div class="{# style forms__error #}">
                  {{ 'forms_error' | t }}
                </div>
              </fieldset>

              <!-- [[ LABEL INSIDE ]] -->
              <fieldset class="{# style forms__fieldset #}">
                <label class="{# style forms__label_alt #}" for="test-input-2">
                  {{- 'forms_label' | t -}}
                </label>
                <input
                  type="text"
                  name="test-input-2"
                  id="test-input-2"
                  class="{# style forms__input_alt #}"
                  placeholder="{{ 'forms_placeholder' | t }}"
                >
                <div class="{# style forms__message #}">
                  {{ 'forms_message' | t }}
                </div>
                <div class="{# style forms__error #}">
                  {{ 'forms_error' | t }}
                </div>
              </fieldset>
            </div>
          </div>

          <!-- [[ DROPDOWNS ]] -->
          <div class="{# style section__row #}">
            <br>
            <h3 class="{# style section__subtitle #}">
              {{ 'forms_dropdowns_subtitle' | t }}
            </h3>
            <div class="{# style section__divider #}"></div>
          </div>
          <div class="{# style section__row #}">
            <div class="{# style forms__inputs-wrapper #}">
              <!-- [[ LABEL ABOVE ]] -->
              <fieldset class="{# style forms__fieldset #}">
                <label class="{# style forms__label #}" for="test-input-1">
                  {{- 'forms_label' | t -}}
                </label>
                <select
                  name="test-select-1"
                  id="test-select-1"
                  class="{# style forms__select #}"
                >
                  <option value="" disabled selected>
                    {{ 'forms_selector_placeholder' | t }}
                  </option>
                  <option value="1">
                    {{ 'forms_option' | t }}
                  </option>
                  <option value="2">
                    {{ 'forms_option' | t }}
                  </option>
                  <option value="3">
                    {{ 'forms_option' | t }}
                  </option>
                </select>
                <div class="{# style forms__message #}">
                  {{ 'forms_message' | t }}
                </div>
                <div class="{# style forms__error #}">
                  {{ 'forms_error' | t }}
                </div>
              </fieldset>

              <!-- [[ LABEL INSIDE ]] -->
              <fieldset class="{# style forms__fieldset #}">
                <label class="{# style forms__label_alt #}" for="test-input-2">
                  {{- 'forms_label' | t -}}
                </label>
                <select
                  type="text"
                  name="test-select-2"
                  id="test-select-2"
                  class="{# style forms__select_alt #}"
                >
                  <option value="">
                    {{ 'forms_selector_placeholder' | t }}
                  </option>
                  <option value="1">
                    {{ 'forms_option' | t }}
                  </option>
                  <option value="2">
                    {{ 'forms_option' | t }}
                  </option>
                  <option value="3">
                    {{ 'forms_option' | t }}
                  </option>
                </select>
                <div class="{# style forms__message #}">
                  {{ 'forms_message' | t }}
                </div>
                <div class="{# style forms__error #}">
                  {{ 'forms_error' | t }}
                </div>
              </fieldset>
            </div>
          </div>

          <!-- [[ MULTIPLE OPTIONS ]] -->
          <div class="{# style section__row #}">
            <br>
            <h3 class="{# style section__subtitle #}">
              {{ 'forms_multioptions_subtitle' | t }}
            </h3>
            <div class="{# style section__divider #}"></div>
          </div>
          <div class="{# style section__row #}">
            <fieldset class="{# style forms__fieldset #}">
              <label class="{# style forms__checkbox #}">
                <input type="checkbox" id="option_1" name="options" value="option_1" checked>
                {{ 'forms_option' | t }} 1
              </label>
              <label class="{# style forms__checkbox #}">
                <input type="checkbox" id="option_2" name="options" value="option_2">
                {{ 'forms_option' | t }} 2
              </label>
              <label class="{# style forms__checkbox #}">
                <input type="checkbox" id="option_3" name="options" value="option_3" disabled>
                {{ 'forms_option' | t }} 3 (Disabled)
              </label>
            </fieldset>
          </div>

          <!-- [[ RADIO BUTTONS ]] -->
          <div class="{# style section__row #}">
            <br>
            <h3 class="{# style section__subtitle #}">
              {{ 'forms_radios_subtitle' | t }}
            </h3>
            <div class="{# style section__divider #}"></div>
          </div>
          <div class="{# style section__row #}">
            <fieldset class="{# style forms__fieldset #}">
              <label class="{# style forms__radio #}">
                <input
                  type="radio"
                  id="radio_active"
                  name="radios"
                  value="radio_active"
                  checked
                >
                {{ 'forms_radio_active' | t }}
              </label>
              <label class="{# style forms__radio #}">
                <input
                  type="radio"
                  id="radio_inactive"
                  name="radios"
                  value="radio_inactive"
                >
                {{ 'forms_radio_inactive' | t }}
              </label>
              <label class="{# style forms__radio #}">
                <input
                  type="radio"
                  id="radio_disabled"
                  name="radios"
                  value="radio_disabled"
                  disabled
                >
                {{ 'forms_radio_disabled' | t }}
              </label>
            </fieldset>
          </div>

          <!-- [[ CTA ]] -->
          <div class="{# style section__row #}">
            <br>
            <h3 class="{# style section__subtitle #}">
              {{ 'forms_cta_subtitle' | t }}
            </h3>
            <div class="{# style section__divider #}"></div>
          </div>
          <div class="{# style section__row #} {# style section__columns #}">
            <div class="{# style forms__submit #}">
              {% render 'core-button', label: 'Submit', style: 'primary' %}
            </div>
            <div class="{# style forms__cancel #}">
              {% render 'core-button', label: 'Cancel', style: 'text-link-large' %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- [[ COMPONENTS ✅ ]] -->
  <div id="components" class="{# style section #} js-section">
    <div class="{# style section__header #}">
      <span class="{# style section__tagline #}">
        {{ 'styleguide_first_title' | t }}
      </span>
      <h2 class="{# style section__title #}">
        {{ 'components_title' | t }}
      </h2>
    </div>
    <div class="{# style section__main #}">
      <div class="{# style section__container #}">
        <div class="{# style section__rows #} {# style forms__rows #}">
          <!-- [[ BADGES ]] -->
          <div class="{# style section__row #}">
            <h3 class="{# style section__subtitle #}">
              {{ 'components_badges_subtitle' | t }}
            </h3>
            <div class="{# style section__divider #}"></div>
            <span class="{# style components__badge #} {# style components__badge--var1 #}">
              {{- 'components_badge_var1' | t -}}
            </span>
            <span class="{# style components__badge #} {# style components__badge--var2 #}">
              {{- 'components_badge_var2' | t -}}
            </span>
            <span class="{# style components__badge #} {# style components__badge--var3 #}">
              {{- 'components_badge_var3' | t -}}
            </span>
          </div>

          <!-- [[ VIDEO CONTROLS ]] -->
          <div class="{# style section__row #}">
            <h3 class="{# style section__subtitle #}">
              {{ 'components_video_controls_subtitle' | t }}
            </h3>
            <div class="{# style section__divider #}"></div>
            <div class="{# style section__columns #} {# style section__columns--gap #}">
              <button class="{# style components__video-controls #}">
                {% render 'icon-play' %}
              </button>
              <button class="{# style components__video-controls #}">
                {% render 'icon-pause' %}
              </button>
              <button class="{# style components__video-controls #}">
                {% render 'icon-sound-off' %}
              </button>
              <button class="{# style components__video-controls #}">
                {% render 'icon-sound-on' %}
              </button>
            </div>
          </div>

          <!-- [[ SCROLL BAR ]] -->
          <div class="{# style section__row #}">
            <h3 class="{# style section__subtitle #}">
              {{ 'components_scroll_bar_subtitle' | t }}
            </h3>
            <div class="{# style section__divider #}"></div>
            <br>
            <div class="{# style components__scrollbar #}"></div>
          </div>

          <!-- [[ CAROUSEL NAVIGATION ]] -->
          <div class="{# style section__row #}">
            <h3 class="{# style section__subtitle #}">
              {{ 'components_carousel_navigation_subtitle' | t }}
            </h3>
            <div class="{# style section__divider #}"></div>
            <div class="{# style components__carousel-dots #}">
              <button
                class="{# style components__carousel-dot #} {# style components__carousel-dot--active #}"
              ></button>
              <button class="{# style components__carousel-dot #}"></button>
              <button class="{# style components__carousel-dot #}"></button>
              <button class="{# style components__carousel-dot #}"></button>
            </div>
            <div class="{# style components__carousel-arrows #}">
              <button class="{# style components__carousel-arrow #}">
                {% render 'icon-arrow-left' %}
              </button>
              <button class="{# style components__carousel-arrow #}">
                {% render 'icon-arrow-right' %}
              </button>
            </div>
          </div>
          <!-- [[ FILTERS ]] -->
          <div class="{# style section__row #}">
            <h3 class="{# style section__subtitle #}">
              {{ 'components_filters_subtitle' | t }}
            </h3>
            <div class="{# style section__divider #}"></div>
            <span class="{# style components__filter-badge #}">
              {{- 'components_filter' | t -}}
              <button class="{# style components__filter-badge__close #}">
                {% render 'icon-close' %}
              </button>
            </span>
          </div>

          <!-- [[ QUANTITY SELECTOR ]] -->
          <div class="{# style section__row #}">
            <h3 class="{# style section__subtitle #}">
              {{ 'components_quantity_selector_subtitle' | t }}
            </h3>
            <div class="{# style section__divider #}"></div>
            <div class="{# style components__quantity-selector #}">
              <button>{% render 'icon-minus' %}</button>
              <span>24</span>
              <button>{% render 'icon-plus' %}</button>
            </div>
            <div class="{# style components__quantity-selector #}">
              <button>{% render 'icon-minus' %}</button>
              <span>7</span>
              <button>{% render 'icon-plus' %}</button>
            </div>
            <div class="{# style components__quantity-selector #}">
              <button>{% render 'icon-minus' %}</button>
              <span>186</span>
              <button>{% render 'icon-plus' %}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

