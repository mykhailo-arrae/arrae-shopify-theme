{% comment %}
  Autogenerated assigns (do not remove; gulp overwrites the string values):
  - colors_list_strings — task codegen-style-guide-colors
  - spacing_list_strings — task codegen-style-guide-spacing
{% endcomment %}

{%- liquid
  assign sections_list_string = 'typography,colors,spacing,icons,buttons,forms,components'
  assign sections_list_array = sections_list_string | split: ','

  # MANUALLY ADDED IF NEEDED
  # Split colors by '||'
  # Format: color-handle--#hex, opacity
  # assign colors_brand_strings = 'color-primary--#212121||color-secondary--#FFFFFF'
  assign colors_brand_strings = 'color-primary--#3a3a3a||color-secondary--#6e6e6e'

  # AUTOGENERATED BY GULP TASK codegen-style-guide-colors
  assign colors_list_strings = 'text--#3a3a3a||text-gray--#6e6e6e||dark-gray--#21180e||dark-gray-20--#21180e, 0.20||dark-gray-10--#21180e, 0.10||light-gray--#aaa8a5||lightest-gray--#faf4ef||off-white--#fffef7||off-white-60--#fffef7, 0.60||off-white-80--#fffef7, 0.80||off-white-90--#fffef7, 0.90||on-white--#ececec||background--#fffef7||rose--#ead2c6||brown--#3d2f22||warm-sand--#e9dfcd||light-brown--#efe7da||soft-cream--#f3ede3||lightest-brown--#f8f1eb||light-brown-strong--#d8d0c3||brown-60--#3d2f22, 0.60||mb-1--#f8a28c||mb-1-45-plus--#a12b2d||constipation--#e980a8||sleep--#9c8fa2||calm--#cd9a8e||magnesium--#c5ccd5||tribiotic--#672f45||tone--#e4e0d9||raspberry--#971a3c||greenapple--#d0df66||success--#417b41||success-20--#417b41, 0.20||error--#a72121||error-20--#a72121, 0.20'

  assign colors_brand_array = colors_brand_strings | split: '||'
  assign colors_list_array = colors_list_strings | split: '||'

  # NOT AUTOGENERATED
  assign spacing_list_strings = 'size-0|0|0||size-2|0.125rem|2||size-4|0.25rem|4||size-8|0.5rem|8||size-12|0.75rem|12||size-14|0.875rem|14||size-16|1rem|16||size-20|1.25rem|20||size-24|1.5rem|24||size-32|2rem|32||size-36|2.25rem|36||size-40|2.5rem|40||size-48|3rem|48||size-56|3.5rem|56||size-64|4rem|64||size-72|4.5rem|72||size-80|5rem|80||size-88|5.5rem|88||size-96|6rem|96||size-112|7rem|112||size-120|7.5rem|120'

  assign spacing_list_array = spacing_list_strings | split: '||'
-%}

<aside class="{# style drawer #} js-drawer" data-drawer-names="style-guide">
  <div
    class="{# style drawer__wrapper #} js-drawer-content"
    role="dialog"
    aria-labelledby="drawer-title"
    tabindex="-1"
  >
    <div class="{# style drawer__container #}">
      <div class="{# style drawer__logo #}">
        {% render 'core-brand' %}
      </div>
      <h2 class="{# style drawer__title #}">
        {{ 'styleguide_first_title' | t }}
      </h2>
      <a
        href="#overview"
        class="{# style drawer__nav__action #} js-section-link is-active"
      >
        {{ 'overview_title' | t }}
      </a>
      <h2 class="{# style drawer__title #}">
        {{ 'title' | t }}
      </h2>
      <div class="{# style drawer__main #}">
        <ul class="{# style drawer__nav #}">
          {% liquid
            assign typography_title = 'typography_title' | t
            assign colors_title = 'colors_title' | t
            assign spacing_title = 'spacing_title' | t
            assign icons_title = 'icons_title' | t
            assign buttons_title = 'buttons_title' | t
            assign forms_title = 'forms_title' | t
            assign components_title = 'components_title' | t
          %}
          {% for section in sections_list_array %}
            <li class="{# style drawer__nav__item #}">
              <a
                href="#{{ section }}"
                class="{# style drawer__nav__action #} js-section-link"
              >
                {% case section %}
                  {% when 'typography' -%}
                    {{- typography_title }}
                  {% when 'colors' -%}
                    {{- colors_title }}
                  {% when 'spacing' -%}
                    {{- spacing_title }}
                  {% when 'icons' -%}
                    {{- icons_title }}
                  {% when 'buttons' -%}
                    {{- buttons_title }}
                  {% when 'forms' -%}
                    {{- forms_title }}
                  {% when 'components' -%}
                    {{- components_title }}
                  {% else -%}
                    {{- section }}
                {% endcase %}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</aside>

<div class="{# style drawer__trigger #}">
  <button
    class="{# style nav #} js-drawer-trigger"
    role="button"
    aria-expanded="false"
    aria-controls="drawer-content"
    data-drawer-name="style-guide"
  >
    {% render 'icon-menu' %}
    <span>
      {{ 'nav_label' | t }}
    </span>
  </button>
</div>

<div class="{# style sections #}">
