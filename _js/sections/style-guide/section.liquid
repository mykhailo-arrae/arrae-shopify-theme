  <!-- [[ COLORS ✅ ]] -->
  <div id="colors" class="{# style section #} js-section">
    <div class="{# style section__header #}">
      <span class="{# style section__tagline #}">
        {{ 'title' | t }}
      </span>
      <h2 class="{# style section__title #}">
        {{ 'colors_title' | t }}
      </h2>
    </div>
    <div class="{# style section__main #}">
      <div class="{# style section__container #} {# style colors #}">
        <div class="{# style section__rows #}">
          <div class="{# style section__row #}">
            <div class="{# style section__columns #}">
              <div class="{# style section__column #}">
                <div class="{# style section__label #}">
                  {{ 'colors_header_brand' | t }}
                </div>
              </div>
              <div class="{# style section__column #}">
                <div class="{# style section__label #}">
                  {{ 'colors_header_spec' | t }}
                </div>
              </div>
            </div>
          </div>
          {% for color_string in colors_brand_array %}
            {%- liquid
              assign color_handle = color_string | split: '--' | first
              assign color_title = color_handle | replace: 'color-', '' | replace: '-', ' ' | replace: '_', ' ' | capitalize
              assign color_hex_with_opacity = color_string | split: '--' | last
              if color_hex_with_opacity contains ','
                assign color_hex = color_hex_with_opacity | split: ',' | first
                assign color_opacity = color_hex_with_opacity | split: ',' | last
              else
                assign color_hex = color_hex_with_opacity
                assign color_opacity = '1'
              endif
            -%}
            <div class="{# style section__row #} {# style spacing__row #}">
              <div class="{# style section__columns #}">
                <div class="{# style section__column #}">
                  <div class="{# style section__body #} {# style colors__label #}">
                    <div class="{# style colors__swatch #}">
                      <div
                        class="{# style colors__swatch__inner #}"
                        style="background-color: {{ color_hex }}; opacity: {{ color_opacity }};"
                      ></div>
                    </div>

                    {{ color_title }}
                  </div>
                </div>
                <div class="{# style section__column #}">
                  <div class="{# style section__body #} {# style colors__hex #}">
                    {{ color_hex }}
                    <br>
                    <span class="{# style colors__handle #}">
                      {{ color_handle }}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="{# style section__rows #}">
          <div class="{# style section__row #}">
            <div class="{# style section__columns #}">
              <div class="{# style section__column #}">
                <div class="{# style section__label #}">
                  {{ 'colors_header_basic' | t }}
                </div>
              </div>
              <div class="{# style section__column #}">
                <div class="{# style section__label #}">
                  {{ 'colors_header_spec' | t }}
                </div>
              </div>
            </div>
          </div>

          {% for color_string in colors_list_array %}
            {%- liquid
              assign color_handle = color_string | split: '--' | first
              assign color_title = color_handle | replace: 'color-', '' | replace: '-', ' ' | replace: '_', ' ' | capitalize
              assign color_hex_with_opacity = color_string | split: '--' | last
              if color_hex_with_opacity contains ','
                assign color_hex = color_hex_with_opacity | split: ',' | first
                assign color_opacity = color_hex_with_opacity | split: ',' | last
              else
                assign color_hex = color_hex_with_opacity
                assign color_opacity = '1'
              endif
            -%}
            <div class="{# style section__row #} {# style spacing__row #}">
              <div class="{# style section__columns #}">
                <div class="{# style section__column #}">
                  <div class="{# style section__body #} {# style colors__label #}">
                    <div class="{# style colors__swatch #}">
                      <div
                        class="{# style colors__swatch__inner #}"
                        style="background-color: {{ color_hex }}; opacity: {{ color_opacity }};"
                      ></div>
                    </div>

                    {{ color_title }}
