              </div>
              <div class="{# style section__column #}">
                <div class="{# style section__label #}">
                  {{ 'spacing_header_spec' | t }}
                </div>
              </div>
            </div>
          </div>

          {% for spacing_string in spacing_list_array %}
            {%- liquid
              assign spacing_parts = spacing_string | split: '|'
              assign spacing_size = spacing_parts[0]
              assign spacing_rem_value = spacing_parts[1]
              assign spacing_px_value = spacing_parts[2]
            -%}
            <div class="{# style section__row #} {# style spacing__row #}">
              <div class="{# style section__columns #}">
                <div class="{# style section__column #}">
                  <div class="{# style section__body #}">
                    {{ spacing_size }}
                  </div>
                </div>
                <div class="{# style section__column #}">
                  <div class="{# style section__body #}">
                    {{ spacing_rem_value }}
                  </div>
                </div>
                <div class="{# style section__column #}">
                  <div class="{# style section__body #}">{{ spacing_px_value }}px</div>
                </div>
                <div class="{# style section__column #}">
                  <span
                    class="{# style spacing__unit #}"
                    style="width: {{ spacing_rem_value }};"
                  ></span>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

