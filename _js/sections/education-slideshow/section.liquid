{% if section.blocks.size > 0 %}
  {% liquid
    assign autoplay = section.settings.autoplay | default: false, allow_false: true
    assign autoplay_speed = section.settings.autoplay_speed | default: '6000'
    assign cta_label = section.settings.cta_label | default: blank
    assign cta_url = section.settings.cta_url | default: blank
    assign show_playback_controls = section.settings.show_playback_controls | default: true, allow_false: true
    assign show_cta = false
    if cta_label != blank and cta_url != blank
      assign show_cta = true
    endif

    render 'education-slide-stylesheet'
  %}

  <div
    class="{# style root #}"
    data-education-slideshow
    data-autoplay="{{ autoplay }}"
    data-autoplay-speed="{{ autoplay_speed }}"
    data-slide-count="{{ section.blocks.size }}"
    {% if show_cta %}
      data-has-mobile-cta="true"
    {% endif %}
    data-a11y-play="{{ 'accessibility.education_slideshow.play' | t | escape }}"
    data-a11y-pause="{{ 'accessibility.education_slideshow.pause' | t | escape }}"
    data-a11y-announce-template="{{ 'accessibility.education_slideshow.live_region_announcement' | t | escape }}"
  >
    <p
      class="{# style live-region #}"
      data-education-slideshow-live-region
      aria-live="polite"
      aria-atomic="true"
    ></p>
    <div class="{# style stage #}">
      <div class="{# style viewport #} swiper" data-education-slideshow-viewport>
        <div class="{# style track #} swiper-wrapper" data-education-slideshow-track>
          {% for block in section.blocks %}
            {% render 'education-slide',
              block: block,
              section_id: section.id,
              slide_index: forloop.index0,
              slide_count: section.blocks.size
            %}
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 1 %}
        <div class="{# style slideshow-navigation #}">
          {% render 'education-slide-navigation',
            section_id: section.id,
            blocks: section.blocks,
            autoplay: autoplay,
            show_playback_controls: show_playback_controls,
            cta_label: cta_label,
            cta_url: cta_url
          %}
        </div>
      {% endif %}
    </div>

    {% if show_cta %}
      <div class="{# style mobile-cta #}">
        {% render 'core-button',
          label: cta_label,
          url: cta_url,
          style: 'secondary',
          class: '{# style mobile-cta__button #}'
        %}
      </div>
    {% endif %}
  </div>
{% endif %}

