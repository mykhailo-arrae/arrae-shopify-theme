{% liquid
  assign heading = section.settings.heading
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign section_background = section.settings.section_background
  assign content_contrast_mode = section.settings.content_contrast_mode

  assign tier_cards = section.blocks | where: 'type', 'tier_card'

  assign has_tier_cards = false
  if tier_cards.size > 0
    assign has_tier_cards = true
  endif

  assign show_cta = false
  if cta_label != blank and cta_link != blank
    assign show_cta = true
  endif
%}

{% unless heading == blank and show_cta == false and has_tier_cards == false %}
  <div
    class="{# style inner #}"
    data-content-contrast="{{ content_contrast_mode }}"
  >
    {% if section_background != blank %}
      <div class="{# style background #}" aria-hidden="true">
        {% render 'core-image', image: section_background, image_alt_text: '', mode: 'cover', object_fit: 'cover' %}
      </div>
    {% endif %}

    <div class="{# style content #}">
      {% if heading != blank %}
        <div class="{# style header #}">
          <h2 class="{# style heading #}">{{ heading }}</h2>
        </div>
      {% endif %}

      {% if has_tier_cards %}
        <div class="{# style table #}">
          <div class="{# style grid #}">
            {% for tier_card in tier_cards %}
              <article
                class="{# style col #}"
                {{- tier_card.shopify_attributes -}}
              >
                <div class="{# style col-header #}">
                  {% if tier_card.settings.tier_badge != blank %}
                    <span class="{# style col-badge #}">
                      {{- tier_card.settings.tier_badge -}}
                    </span>
                  {% endif %}

                  {% if tier_card.settings.tier_title != blank %}
                    <h3 class="{# style col-title #}">
                      {{- tier_card.settings.tier_title -}}
                    </h3>
                  {% endif %}
                </div>

                {% if tier_card.settings.tier_features != blank %}
                  <div class="{# style col-features #}">
                    {{ tier_card.settings.tier_features }}
                  </div>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if show_cta %}
        <div class="{# style cta #}">
          <a href="{{ cta_link }}" class="{# style cta-link #}">
            {{- cta_label -}}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
{% endunless %}

{% schema %}
{
  "name": "Tiers Cards",
  "tag": "section",
  "class": "{# style root #}",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "Shop All",
      "info": "Optional - both label and link are required to show the CTA"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link",
      "info": "Optional - both label and link are required to show the CTA"
    },
    {
      "type": "image_picker",
      "id": "section_background",
      "label": "Section Background"
    },
    {
      "type": "select",
      "id": "content_contrast_mode",
      "label": "Content contrast mode",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "light",
      "info": "Choose 'dark' to render the text and cta against a light background and 'light' to render the text and cta against a dark background"
    }
  ],
  "blocks": [
    {
      "type": "tier_card",
      "name": "Tier Card",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "tier_title",
          "label": "Tier Title",
          "default": "Tier Title"
        },
        {
          "type": "text",
          "id": "tier_badge",
          "label": "Tier Badge",
          "default": "Tier Badge"
        },
        {
          "type": "richtext",
          "id": "tier_features",
          "label": "Tier Features",
          "default": "<ul><li>Feature 1</li><li>Feature 2</li><li>Feature 3</li></ul>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tiers Cards",
      "category": "Content",
      "settings": {
        "heading": "Subscriptions Perks",
        "cta_label": "Shop All",
        "cta_link": "shopify://collections/all",
        "content_contrast_mode": "light"
      },
      "blocks": [
        {
          "type": "tier_card",
          "settings": {
            "tier_title": "Essential",
            "tier_badge": "Active Subscription",
            "tier_features": "<ul><li>2% Arrae cash on every recurring order</li><li>FREE USA & CA Shipping</li><li>Exclusive discounts from top brands & partners</li></ul>"
          }
        },
        {
          "type": "tier_card",
          "settings": {
            "tier_title": "Enhanced",
            "tier_badge": "$150 Subscription Spend",
            "tier_features": "<ul><li>5% Arrae cash on every recurring order</li><li>FREE USA & CA Shipping</li><li>Exclusive discounts from top brands & partners</li><li>$5 Arrae cash gift</li></ul>"
          }
        },
        {
          "type": "tier_card",
          "settings": {
            "tier_title": "Elevate",
            "tier_badge": "$300+ Subscription Spend",
            "tier_features": "<ul><li>7% Arrae cash on every recurring order</li><li>FREE USA & CA Shipping</li><li>Exclusive discounts from top brands & partners</li><li>$10 Arrae cash gift</li></ul>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
