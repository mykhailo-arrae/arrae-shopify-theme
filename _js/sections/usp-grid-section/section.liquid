{% doc %}
  USP (Unique Selling Points) Grid Section - Displays promotional items with icons, titles, and subtitles.

  Features:
  - Supports up to 4 configurable blocks with icon and supporting copy
  - Responsive behavior:
    * Mobile (< 768px): 2x2 grid layout
    * Desktop (≥ 768px): 4x1 grid layout

  Block Structure:
  - Settings: text icon handle, text supporting
  - Limit: 4 blocks maximum
{% enddoc %}

{% liquid
  assign blocks = section.blocks | default: null
  assign blocks_count = blocks.size
%}

{% if blocks != blank and blocks_count > 0 %}
  <div class="{# style container #}">
    <ul class="{# style usp-grid #}" data-grid-items-count="{{ blocks_count }}">
      {% for category in blocks %}
        {% liquid
          assign icon_handle = category.settings.icon_handle | default: null
          assign custom_image = category.settings.custom_image | default: null
          assign supporting_copy = category.settings.supporting_copy | default: null
        %}
        {% if icon_handle != blank or supporting_copy != blank or custom_image != blank %}
          <li class="{# style grid-item #}">
            {% if custom_image != blank %}
              <div>
                {{ custom_image | image_url: width: 40, height: 40 | image_tag: loading: 'lazy' }}
              </div>
            {% elsif icon_handle != blank %}
              <div>
                {% render 'dynamic-icon', icon_handle: icon_handle %}
              </div>
            {% endif %}
            <div class="{# style content #}">
              {% if supporting_copy != blank %}
                <h4 class="{# style title #}">
                  {{ supporting_copy }}
                </h4>
              {% endif %}
            </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% schema %}
{
  "name": "USP Grid Section",
  "class": "{# style section #} js-usp-grid-section",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "usp-item",
      "name": "USP Item",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "icon_handle",
          "label": "Icon Handle"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image",
          "info": "Override the icon with a custom image. Use PNG or SVG 40x40px images."
        },
        {
          "type": "text",
          "id": "supporting_copy",
          "label": "Supporting Copy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP Grid Section",
      "category": "Content",
      "blocks": [
        {
          "type": "usp-item"
        }
      ]
    }
  ]
}
{% endschema %}
