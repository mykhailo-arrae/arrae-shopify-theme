[
  {
    "name": "theme_info",
    "theme_author": "The Vaan Group",
    "theme_documentation_url": "https://www.vaangroup.com/",
    "theme_name": "Shiro",
    "theme_support_email": "info@vaangroup.com",
    "theme_version": "1.0.0"
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "id": "favicon",
        "info": "Will be scaled down to 32 x 32px",
        "label": "Favicon image",
        "type": "image_picker"
      },
      {
        "id": "apple_touch_icon",
        "info": "Will be scaled down to 180 x 180px",
        "label": "Apple touch icon",
        "type": "image_picker"
      }
    ]
  },
  {
    "name": "Product",
    "settings": [
      {
        "default": true,
        "id": "enable_quickshop",
        "info": "When enabled, product cards show a Quickshop button that opens the product in a side drawer.",
        "label": "Enable Quickshop",
        "type": "checkbox"
      },
      {
        "id": "subscription_benefits",
        "info": "Separate each benefit with a pipe (|). This will show on all selected product options that are of subscription type.",
        "label": "Subscription Benefits",
        "type": "text"
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "id": "transparent_header_paths",
        "info": "A comma separated list of pages to use transparent header on. Applies to the header and the announcement bar. Example: /pages/about,/collections/all,products/handle. It is applied to the homepage by default.",
        "label": "Transparent Header Pages",
        "type": "text"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "content": "Settings",
        "type": "header"
      },
      {
        "default": false,
        "id": "promo_bar_enabled",
        "info": "The promo bar will be displayed on cart drawer only.",
        "label": "Enable Promo Bar",
        "type": "checkbox"
      },
      {
        "default": "Free Capsule case when you spend over $90",
        "id": "promo_bar_text",
        "label": "Promo Bar Text",
        "type": "text"
      },
      {
        "id": "continue_shopping_link",
        "info": "For the cart page only. If left blank, the continue shopping link will be the home page.",
        "label": "Continue Shopping Link",
        "type": "url"
      },
      {
        "content": "Rewards",
        "type": "header"
      },
      {
        "default": true,
        "id": "cart_rewards_enable",
        "label": "Enable Rewards",
        "type": "checkbox"
      },
      {
        "default": true,
        "id": "include_discounts_in_rewards",
        "label": "Include Discounts in Rewards",
        "type": "checkbox"
      },
      {
        "content": "Free Shipping Rewards",
        "type": "header"
      },
      {
        "default": true,
        "id": "cart_rewards_enable_free_shipping",
        "label": "Enable Free Shipping",
        "type": "checkbox"
      },
      {
        "default": "100",
        "id": "cart_rewards_free_shipping_threshold",
        "info": "Enter the threshold value.",
        "label": "Free Shipping Threshold",
        "type": "text"
      },
      {
        "default": "Free Shipping",
        "id": "cart_rewards_free_shipping_title",
        "label": "Free Shipping Title",
        "type": "text"
      },
      {
        "default": "[amount] Away from Free Shipping",
        "id": "cart_rewards_free_shipping_text_before",
        "info": "Use [amount] to display the amount missing to get the reward.",
        "label": "Free Shipping Text Before",
        "type": "text"
      },
      {
        "default": "You got Free Shipping!",
        "id": "cart_rewards_free_shipping_text_after",
        "label": "Free Shipping Text After",
        "type": "text"
      },
      {
        "content": "Gift with Purchase Rewards",
        "type": "header"
      },
      {
        "default": true,
        "id": "cart_rewards_enable_gwp",
        "label": "Enable Gift with Purchase",
        "type": "checkbox"
      },
      {
        "default": "200",
        "id": "cart_rewards_gwp_threshold",
        "info": "Enter the threshold value.",
        "label": "Gift with Purchase Threshold",
        "type": "text"
      },
      {
        "default": "Free Gift",
        "id": "cart_rewards_gwp_title",
        "label": "Gift with Purchase Title",
        "type": "text"
      },
      {
        "default": "[amount] Away from Free Gift",
        "id": "cart_rewards_gwp_text_before",
        "info": "Use [amount] for dynamic amounts in the cart rewards progress.",
        "label": "Gift with Purchase Text Before",
        "type": "text"
      },
      {
        "default": "You got a Free Gift!",
        "id": "cart_rewards_gwp_text_after",
        "label": "Gift with Purchase Text After",
        "type": "text"
      },
      {
        "default": "You got Free Shipping and a Free Gift!",
        "id": "cart_rewards_all_tiers_met_text",
        "label": "All Tiers Met Text",
        "type": "text"
      },
      {
        "id": "cart_rewards_gwp_products",
        "info": "Select the products that will be eligible for the gift with purchase reward.",
        "label": "Gift with Purchase Products",
        "type": "product_list"
      },
      {
        "default": true,
        "id": "cart_rewards_enable_auto_gwp",
        "info": "When enabled, if only one gift product is eligible, it is added to the cart automatically. If multiple gifts are configured, customers always choose. Turn off to require manual add for every gift.",
        "label": "Automatically add gift when only one product is eligible",
        "type": "checkbox"
      },
      {
        "content": "Upsell",
        "type": "header"
      },
      {
        "default": true,
        "id": "enable_cart_upsell",
        "label": "Enable Upsell",
        "type": "checkbox"
      },
      {
        "default": "theme",
        "id": "upsell_source",
        "label": "Choose Upsell Source",
        "options": [
          {
            "label": "Theme",
            "value": "theme"
          },
          {
            "label": "Rebuy",
            "value": "rebuy"
          }
        ],
        "type": "select"
      },
      {
        "default": "Complete your routine",
        "id": "cart_upsell_title",
        "label": "Upsell Title",
        "type": "text",
        "visible_if": "{{ settings.upsell_source == 'theme' }}"
      },
      {
        "default": 4,
        "id": "cart_upsell_max_quantity",
        "label": "Max quantity of products",
        "max": 8,
        "min": 1,
        "step": 1,
        "type": "range",
        "visible_if": "{{ settings.upsell_source == 'theme' }}"
      },
      {
        "default": "upsell:ignore",
        "id": "cart_upsell_tags_to_ignore",
        "info": "A comma seperated list of product tags to ignore. Products with these tags will be excluded from the upsell recommendations.",
        "label": "Upsell Tags to Ignore",
        "type": "text",
        "visible_if": "{{ settings.upsell_source == 'theme' }}"
      },
      {
        "id": "rebuy_upsell_section_id",
        "label": "Rebuy Upsell Section ID",
        "type": "text",
        "visible_if": "{{ settings.upsell_source == 'rebuy' }}"
      },
      {
        "id": "cart_upsell_collection",
        "info": "Used for Theme Upsell Source.",
        "label": "Upsell Collection",
        "type": "collection"
      },
      {
        "content": "Empty Cart",
        "type": "header"
      },
      {
        "default": "Your cart is empty!",
        "id": "empty_cart_title",
        "label": "Empty Cart Title",
        "type": "text"
      },
      {
        "default": "/",
        "id": "empty_cart_cta_primary_link",
        "label": "Empty Cart Button Primary Link",
        "type": "url"
      },
      {
        "default": "Shop Best Sellers",
        "id": "empty_cart_cta_primary_text",
        "label": "Empty Cart CTA Primary Text",
        "type": "text"
      },
      {
        "content": "Discount Code Input",
        "type": "header"
      },
      {
        "default": true,
        "id": "enable_discount_code_input",
        "label": "Enable Discount Code Input",
        "type": "checkbox"
      }
    ]
  },
  {
    "name": "Klaviyo",
    "settings": [
      {
        "default": false,
        "id": "enable_klaviyo",
        "info": "Master switch for theme Klaviyo integrations (newsletter forms, embedded footer forms, and Notify Me).",
        "label": "Enable Klaviyo",
        "type": "checkbox"
      },
      {
        "default": "VVy3R8",
        "id": "klaviyo_public_api_key",
        "label": "Klaviyo Public API Key",
        "type": "text",
        "visible_if": "{{ settings.enable_klaviyo }}"
      },
      {
        "default": "VLDxbf",
        "id": "klaviyo_list_id",
        "label": "Klaviyo List ID",
        "type": "text",
        "visible_if": "{{ settings.enable_klaviyo }}"
      },
      {
        "content": "Notify Me (Back in Stock)",
        "type": "header",
        "visible_if": "{{ settings.enable_klaviyo }}"
      },
      {
        "default": false,
        "id": "enable_notify_me_globally",
        "info": "When enabled, the Notify Me button appears for variants at or below the quantity trigger.",
        "label": "Enable Notify Me globally",
        "type": "checkbox",
        "visible_if": "{{ settings.enable_klaviyo }}"
      },
      {
        "default": 0,
        "id": "notify_me_quantity_trigger",
        "info": "Show Notify Me when variant inventory is less than or equal to this number.",
        "label": "Notify Me quantity trigger",
        "type": "number",
        "visible_if": "{{ settings.enable_klaviyo }}"
      },
      {
        "default": "Notify Me",
        "id": "notify_me_main_cta_text",
        "label": "Notify Me button text",
        "type": "text",
        "visible_if": "{{ settings.enable_klaviyo }}"
      },
      {
        "default": "#F6F1EA",
        "id": "notify_me_popup_background_color",
        "label": "Notify Me popup background color",
        "type": "color",
        "visible_if": "{{ settings.enable_klaviyo }}"
      },
      {
        "id": "notify_me_popup_image_desktop",
        "label": "Notify Me popup image (desktop)",
        "type": "image_picker",
        "visible_if": "{{ settings.enable_klaviyo }}"
      },
      {
        "id": "notify_me_popup_image_mobile",
        "label": "Notify Me popup image (mobile)",
        "type": "image_picker",
        "visible_if": "{{ settings.enable_klaviyo }}"
      }
    ]
  },
  {
    "name": "Shop Contacts",
    "settings": [
      {
        "id": "shop_contact_email",
        "info": "Email address that customers can use to contact the shop",
        "label": "Contact Email",
        "placeholder": "support@example.com",
        "type": "text"
      }
    ]
  }
]
