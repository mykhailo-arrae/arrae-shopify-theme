[
  {
    "$schema": "https://swc.rs/schema.json",
    "test": [".*.(js|jsx|ts|tsx)$"],
    "module": {
      "type": "commonjs",
      "ignoreDynamic": true
    },
    "env": {
      "targets": "node >= 20"
    },
    "jsc": {
      "parser": {
        "syntax": "typescript",
        "tsx": true,
        "decorators": true,
        "dynamicImport": false
      },
      "transform": {
        "decoratorVersion": "2022-03",
        "react": {
          "runtime": "automatic",
          "throwIfNamespace": true,
          "development": false
        }
      }
    }
  }
]
