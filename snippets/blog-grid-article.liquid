{% # DO NOT EDIT: This file is auto-generated and will be overwritten. [build-fingerprint:assets:source={_js/snippets/blog-grid-article/snippet.liquid}] %}

{% doc %}
  @param {article} article - The article object (required)

  @example
  {% render 'blog-grid-article', article: article %}
{% enddoc %}

{% liquid
  assign article = article | default: null
  assign badge = article.tags | first | default: null
%}

<div class="tvg_blog_grid_article_SONB-W_card">
  <div class="tvg_blog_grid_article_SONB-W_media">
    <a
      class="tvg_blog_grid_article_SONB-W_mediaLink"
      href="{{ article.url }}"
      tabindex="-1"
      aria-label="{{ 'blogs.article.read_more_aria_label' | t: title: article.title }}"
    >
      {% if article.image != blank %}
        {% render 'core-image',
          image: article.image,
          mode: 'cover',
          object_fit: 'cover',
          lazyload: true,
          srcset_print_sizes: '240,320,480,640'
        %}
      {% else %}
        <div class="tvg_blog_grid_article_SONB-W_mediaPlaceholder"></div>
      {% endif %}
    </a>
  </div>

  <div class="tvg_blog_grid_article_SONB-W_content">
    {% if article.title != blank %}
      <a
        class="tvg_blog_grid_article_SONB-W_title"
        href="{{ article.url }}"
      >
        {{ article.title }}
      </a>
    {% endif %}

    <div class="tvg_blog_grid_article_SONB-W_content-bottom">
      {% if article.author != blank %}
        <p class="tvg_blog_grid_article_SONB-W_author">
          {{ article.author }}
        </p>
      {% endif %}

      <time
        class="tvg_blog_grid_article_SONB-W_date"
        datetime="{{ article.published_at | date: '%Y-%m-%d' }}"
      >
        {{ article.published_at | date: format: 'month_day_year' }}
      </time>

      {% if badge != blank %}
        <span class="tvg_blog_grid_article_SONB-W_tag">
          {{ badge }}
        </span>
      {% endif %}
    </div>
  </div>
</div>
