{% doc %}
  Emits comma-separated {"src","alt"} JSON objects for one gallery list entry.
  Expands metaobject list-of-files fields when present; otherwise resolves the
  entry as a single media/metaobject image.

  @param {object} entry - One item from pdp_gallery_images / variant_gallery_set
{% enddoc %}

{% liquid
  assign entry = entry | default: null
  assign media_list = null

  if entry != blank
    if entry.images.value != blank
      assign media_list = entry.images.value
    elsif entry.gallery.value != blank
      assign media_list = entry.gallery.value
    elsif entry.gallery_images.value != blank
      assign media_list = entry.gallery_images.value
    elsif entry.files.value != blank
      assign media_list = entry.files.value
    elsif entry.photos.value != blank
      assign media_list = entry.photos.value
    elsif entry.assets.value != blank
      assign media_list = entry.assets.value
    elsif entry.media_list.value != blank
      assign media_list = entry.media_list.value
    elsif entry.carousel_images.value != blank
      assign media_list = entry.carousel_images.value
    endif
  endif
%}

{%- if media_list != blank -%}
  {%- assign entry_image_first = true -%}
  {%- for media in media_list -%}
    {%- capture item_src -%}
      {%- render 'product-gallery-image-src', image: media, width: 1280 -%}
    {%- endcapture -%}
    {%- assign item_src = item_src | strip -%}
    {%- if item_src != blank -%}
      {%- capture item_alt -%}
        {%- render 'product-gallery-image-alt', image: media -%}
      {%- endcapture -%}
      {%- unless entry_image_first -%},{%- endunless -%}
      {"src":{{ item_src | json }},"alt":{{ item_alt | strip | json }}}
      {%- assign entry_image_first = false -%}
    {%- endif -%}
  {%- endfor -%}
{%- elsif entry != blank -%}
  {%- capture item_src -%}
    {%- render 'product-gallery-image-src', image: entry, width: 1280 -%}
  {%- endcapture -%}
  {%- assign item_src = item_src | strip -%}
