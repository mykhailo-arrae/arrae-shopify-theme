    {% if total_pages <= 1 %}
      hidden
    {% endif %}
  >
    <span class="tvg_collection_load_more_KIHLoG_button__label">{{ load_more_label | truncate: 24 }}</span>
  </button>

  <p class="tvg_collection_load_more_KIHLoG_error js-load-more-error" role="alert" hidden></p>
</div>

