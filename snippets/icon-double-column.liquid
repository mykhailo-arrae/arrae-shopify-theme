{% liquid
  assign width = width | default: 21
  assign height = height | default: 20
  assign fill = fill | default: 'currentColor'

  assign title_fallback = 'accessibility.icons.double_column' | t
  assign title = title | default: title_fallback
%}

<svg
  width="{{ width }}"
  height="{{ height }}"
  viewBox="0 0 21 20"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-labelledby="double-column"
>
  <title id="double-column">{{ title }}</title>
  <path d="M2.5 2.00024H8.5V8.00024H2.5V2.00024Z" stroke="{{ fill }}" stroke-linejoin="round"/>
  <path d="M12.5 2.00024H18.5V8.00024H12.5V2.00024Z" stroke="{{ fill }}" stroke-linejoin="round"/>
  <path d="M2.5 12.0002H8.5V18.0002H2.5V12.0002Z" stroke="{{ fill }}" stroke-linejoin="round"/>
  <path d="M12.5 12.0002H18.5V18.0002H12.5V12.0002Z" stroke="{{ fill }}" stroke-linejoin="round"/>
</svg>
