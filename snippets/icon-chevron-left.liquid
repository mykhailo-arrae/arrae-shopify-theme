{% liquid
  assign width = width | default: 16
  assign height = height | default: 16
  assign stroke = stroke | default: 'currentColor'
%}

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 16 16"
  width="{{ width }}"
  height="{{ height }}"
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M10 12L6 8L10 4"
    stroke="{{ stroke }}"
    fill="none"
    stroke-width="1.25"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
