{% doc %}
  One radio row for the markets/currency selector. Owns the row styling so the
  parent `markets-drawer` only manages the popover, form, and lists. Renders a
  country row (flag + `CURRENCY (symbol)`), the synthetic EUR row (EU flag +
  `EUR (€)`), or a plain language row.

  @param {string} input_name - Radio group name: 'country_code' or 'language_code'.
  @param {string} value - Submitted value (ISO code).
  @param {boolean} checked - Whether this row starts selected.
  @param {object} country - Optional country drop; renders its flag + currency label.
  @param {boolean} eur - Optional. Renders the shared EU flag + EUR label.
  @param {string} eur_symbol - Currency symbol used in the EUR label.
  @param {string} label - Fallback label text (used for languages).

  @example
  {% render 'markets-drawer-option', input_name: 'country_code', value: country.iso_code, checked: true, country: country %}
{% enddoc %}

{% liquid
  assign option_eur = eur | default: false
%}

<li class="tvg_markets_drawer_option_YbniKq_item">
  <label class="tvg_markets_drawer_option_YbniKq_option">
