                  assign option_image = option.swatch_image.value | default: option.swatch_image | default: null
                  if option_image != blank
                    assign option_image_url = option_image | image_url: width: 120
                  endif
                -%}
                {%- unless dimension_option_first -%},{%- endunless -%}
                {
                  "displayLabel": {{ option_display_label | json }},
                  "matchToken": {{ option_match_token | json }},
                  "badge": {{ option_badge | json }},
                  "description": {{ option_description | json }},
                  "swatchHex": {{ option_swatch_hex | json }},
                  "imageUrl": {{ option_image_url | json }},
                  "isDefault": {% if option_is_default %}true{% else %}false{% endif %}
                }
                {%- assign dimension_option_first = false -%}
              {%- endfor -%}
            {%- endif -%}
