                  assign option_badge = option.badge | default: ''
                  assign option_description = option.description | default: ''
                  assign option_swatch_hex = option.swatch_hex.value | default: option.swatch_hex | default: null
                  assign option_is_default = option.is_default.value | default: false, allow_false: true
