                  {{ collection.title }}
                </a>
              </li>
              <li class="tvg_breadcrumbs_bnVWna_item">{{ current_tags.first }}</li>
            {% else %}
              <li class="tvg_breadcrumbs_bnVWna_item js-breadcrumb-current" aria-current="page">{{ collection.title }}</li>
            {% endif %}
          {% endif %}

          {% if template.name == 'product' %}
            <li class="tvg_breadcrumbs_bnVWna_item">{{ product.title }}</li>
          {% endif %}

          {% if template.name == 'blog' %}
            <li class="tvg_breadcrumbs_bnVWna_item">{{ blog.title }}</li>
          {% endif %}

          {% if template.name == 'article' %}
            <li class="tvg_breadcrumbs_bnVWna_item">
              <a href="/blogs/{{ blog.handle }}">
                {{ blog.title }}
              </a>
            </li>
            <li class="tvg_breadcrumbs_bnVWna_item">{{ article.title }}</li>
          {% endif %}

          {% if template.name == 'page' %}
            <li class="tvg_breadcrumbs_bnVWna_item">{{ page.title }}</li>
          {% endif %}

          {% if template.name == 'cart' %}
            <li class="tvg_breadcrumbs_bnVWna_item">Cart</li>
