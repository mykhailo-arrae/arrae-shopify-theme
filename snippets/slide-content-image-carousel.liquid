    for entry in image_carousel_items
      if entry.carousel_images.value != blank
        for desktop_image in entry.carousel_images.value
          assign total_desktop_slides = total_desktop_slides | plus: 1
        endfor
      endif

      if entry.carousel_images_mobile.value != blank
        assign has_mobile_carousel = true
        for mobile_image in entry.carousel_images_mobile.value
          assign total_mobile_slides = total_mobile_slides | plus: 1
        endfor
      elsif entry.carousel_images.value != blank
        for desktop_image in entry.carousel_images.value
