{% doc %}
  @description
  Renders SMP sibling product swatches for product cards. The compact variant shows
  overlapping swatches with the total number of available options.

  The current card product is always rendered first and shows the selected pill
  state. All selectable swatches (including the current flavor) are buttons;
  clicking a swatch selects that sibling on the product card (updates quickshop
  target and card content). Compact swatches are circles only but use the same
  card-select behavior.

  Visible swatch limits:
  - default (1-up mobile / desktop): max 5, then a +X overflow label
  - compact (2-up): max 3, with the full "X Flavors Available" count

  @param {product} product - Product used to determine the active sibling option.
  @param {array} smp_sibling_options - SMP option metaobjects to render.
  @param {string} design_variant - Visual variant. Use "compact" for the count badge.

  @example
  {% render 'product-smp-swatches', product: product, smp_sibling_options: smp_sibling_options, design_variant: 'compact' %}
{% enddoc %}

{% liquid
  assign product = product | default: null
  assign smp_sibling_options = smp_sibling_options | default: null
  assign design_variant = design_variant | default: 'default'
  assign is_compact = false

  if design_variant == 'compact'
    assign is_compact = true
  endif

  assign max_visible = 5
  if is_compact
    assign max_visible = 3
  endif

  assign total_options = 0
  if smp_sibling_options != blank
    for entry in smp_sibling_options
      if entry.product.value != blank
        assign total_options = total_options | plus: 1
      endif
    endfor
  endif

  assign overflow_count = 0
  if total_options > max_visible
    assign overflow_count = total_options | minus: max_visible
  endif

  assign rendered_count = 0
%}

{% if total_options > 0 %}
