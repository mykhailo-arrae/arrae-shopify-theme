          endif

          assign rendered_count = rendered_count | plus: 1
        %}
        {% capture compact_indicator %}
          <div
            class="tvg_product_smp_swatches_gv71da_option-image"
            {% if entry_swatch_hex != blank %}
              style="background-color: {{ entry_swatch_hex | escape }};"
            {% endif %}
            aria-hidden="true"
          >
            {% if show_swatch_image %}
              {% render 'core-image',
                image: entry_image,
                mode: 'contain',
                object_fit: 'cover',
                lazyload: true,
                srcset_print_sizes: '30,60'
              %}
            {% endif %}
          </div>
        {% endcapture %}

        {% if entry_url != blank %}
          <button
            type="button"
            class="js-product-card-smp-swatch tvg_product_smp_swatches_gv71da_option"
            data-product-id="{{ entry_product_id }}"
