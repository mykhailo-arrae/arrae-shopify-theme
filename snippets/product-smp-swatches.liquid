    {% comment %}
      Two passes keep the card's current product first, then remaining siblings
      in metafield order. Compact skips non-current here and renders them below.
    {% endcomment %}
    {% for pass in (1..2) %}
      {% for entry in smp_sibling_options %}
        {% liquid
          if rendered_count >= max_visible
            break
          endif

          assign entry_product = entry.product.value
          if entry_product == blank
            continue
          endif

          assign entry_product_id = entry_product.id | default: 0
          assign entry_is_current = false
          if product.id == entry_product_id
            assign entry_is_current = true
          endif

          assign include_entry = false
          if pass == 1 and entry_is_current
            assign include_entry = true
          elsif pass == 2 and entry_is_current == false
            assign include_entry = true
          endif

          if is_compact and entry_is_current == false
            assign include_entry = false
          endif
        %}

        {% if include_entry %}
          {% liquid
            assign entry_url = entry_product.url | default: ''
            assign entry_handle = entry_product.handle | default: ''
            assign entry_label = entry.display_label | default: entry.display_name | default: ''
            assign entry_image = entry.swatch_image.value | default: entry.swatch_image | default: entry.image
            assign entry_swatch_hex = entry.swatch_hex.value | default: entry.swatch_hex | default: null

            assign show_swatch_image = false
            if entry_swatch_hex == blank and entry_image != blank
              assign show_swatch_image = true
            endif

            # Card / quick-add variant for this sibling (same rules as product-card)
            assign entry_variant = null

            for v in entry_product.variants
              assign hide_on_front_end = v.metafields.custom.hide_on_front_end.value | default: false, allow_false: true
              if hide_on_front_end
                continue
              endif
              if v.available and v.selling_plan_allocations.size > 0
                assign entry_variant = v
                break
              endif
            endfor

            if entry_variant == null
              for v in entry_product.variants
                assign hide_on_front_end = v.metafields.custom.hide_on_front_end.value | default: false, allow_false: true
                unless hide_on_front_end
