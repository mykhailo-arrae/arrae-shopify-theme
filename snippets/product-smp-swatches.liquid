              endfor
            endif

            if entry_variant == null
              assign entry_variant = entry_product.selected_or_first_available_variant
            endif

            assign rendered_count = rendered_count | plus: 1
          %}

          {% capture swatch_indicator %}
            <div
              class="tvg_product_smp_swatches_gv71da_option-image"
              {% if entry_swatch_hex != blank %}
                style="background-color: {{ entry_swatch_hex | escape }};"
              {% endif %}
              aria-hidden="true"
            >
              {% if show_swatch_image %}
                {% render 'core-image',
                  image: entry_image,
                  mode: 'contain',
                  object_fit: 'cover',
                  lazyload: true,
