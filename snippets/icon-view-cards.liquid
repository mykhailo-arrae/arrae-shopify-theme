{% liquid
  assign width = width | default: 22
  assign height = height | default: 22
  assign fill = fill | default: 'currentColor'

  assign title_fallback = 'accessibility.icons.view_cards' | t
  assign title = title | default: title_fallback
%}

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="{{ width }}"
  height="{{ height }}"
  viewBox="0 0 22 22"
  fill="none"
  aria-labelledby="view-cards"
>
  <title id="view-cards">{{ title }}</title>
  <path d="M0 2.66667C0 1.19391 1.19391 0 2.66667 0H18.6667C20.1394 0 21.3333 1.19391 21.3333 2.66667V18.6667C21.3333 20.1394 20.1394 21.3333 18.6667 21.3333H2.66667C1.19391 21.3333 0 20.1394 0 18.6667V2.66667Z" fill="{{ fill }}"/>
</svg>
