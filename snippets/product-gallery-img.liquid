{% # DO NOT EDIT: This file is auto-generated and will be overwritten. [build-fingerprint:assets:source={_js/snippets/product-gallery-img/snippet.liquid}] %}

{% doc %}
  Renders a gallery slide/grid image from an already-resolved URL.
  Avoids core-image/image_url so file_reference metafields cannot emit Liquid errors into src.

  @param {string} src - Absolute or protocol-relative image URL (required)
  @param {string} alt - Alt text
  @param {boolean} lazyload - Defaults to true
{% enddoc %}

{% liquid
  assign src = src | default: '' | strip
  assign alt = alt | default: ''
  assign lazyload = lazyload | default: true, allow_false: true
%}

{% if src != blank and src contains 'Liquid error' %}
  {% assign src = '' %}
{% endif %}

{% if src != blank %}
  <img
    src="{{ src | escape }}"
    alt="{{ alt | escape }}"
    loading="{% if lazyload %}lazy{% else %}eager{% endif %}"
    decoding="async"
    width="1280"
    height="1707"
  >
{% endif %}
