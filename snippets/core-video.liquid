{% doc %}
  @description
  A snippet to display a video
  - Supports separate desktop and mobile videos
  - Accessibility: aria-label is required for the video, with a fallback to video.alt
  - Supports lazy loading and preloading for performance optimization
  - Supports Largest Contentful Paint optimization

  @param {string} video - The video object to render
  @param {string} video_mobile - The mobile video object to render, if different from the main video.
  @param {string} poster - Image placeholder to replace the default video preview image.
  @param {string} poster_mobile - Image placeholder to replace the default video preview image for mobile.
  @param {string} class - Adds a custom class to the video element.
  @param {boolean} controls - If "true", displays video controls. Defaults to "false".
  @param {boolean} loop - If "true", loops the video. Defaults to "false".
  @param {number} loop_count - When looping, the total number of times the video plays before stopping.
  @param {boolean} muted - If "true", mutes the video. Defaults to "false".
  @param {boolean} autoplay - If "true", plays the video automatically. Defaults to "false".
  @param {boolean} lazyload - If "true", lazy loads the video using the Intersection Observer API when scrolled into view.
  @param {boolean} playsinline - Allows inline playback on mobile devices. Defaults to "false".
  @param {string} preload - Controls video preloading behavior ('auto', 'metadata', 'none'). Defaults to 'auto'.
  @param {boolean} preload_poster - If "true", preloads the poster image. Defaults to "false".
  @param {string} fetchpriority - "high" or "low". Defaults to "low" (automatically set to "high" if lazyload is false).
  @param {boolean} largest_contentful_paint - If "true", optimizes the video for Largest Contentful Paint. Defaults to "false".
  @param {boolean} skip_focus - If "true", skips the focus on the video element. Should only be used with the core-video-controls snippet. Defaults to "false".
  @param {boolean} merge_responsive - If "true", renders desktop and mobile sources in one video element. Defaults to "true".

  @example
  {% render 'core-video',
    video: video,
    video_mobile: video_mobile,
    largest_contentful_paint: true,
  %}
{% enddoc %}

{% liquid
  assign video = video | default: null
  assign video_poster = poster | default: video.preview_image | default: null
  assign video_mobile = video_mobile | default: null
  assign video_mobile_poster = poster_mobile | default: video_mobile.preview_image | default: null
  assign class = class | default: ''
  assign preload = preload | default: 'auto'
  assign controls = controls | default: false
  assign loop = loop | default: false
  assign loop_count = loop_count | default: null
  assign muted = muted | default: false
  assign autoplay = autoplay | default: false
  assign playsinline = playsinline | default: false
  assign lazyload = lazyload | default: false
  assign preload_poster = preload_poster | default: false
  assign largest_contentful_paint = largest_contentful_paint | default: false
  assign fetchpriority = fetchpriority | default: 'low'
  assign classes = class
  assign skip_focus = skip_focus | default: false
  assign merge_responsive = merge_responsive | default: true, allow_false: true
  assign preferred_mobile_source = null
  assign preferred_desktop_source = null
  assign core_video_merge_desktop_mobile = false

  if video and video_mobile and merge_responsive
    assign core_video_merge_desktop_mobile = true
  endif

  # A finite loop count opts out of the native `loop` attribute so JS can count
  # play-throughs via the `ended` event (which never fires while `loop` is set).
  assign loop_finite = false
  if loop and loop_count != blank and loop_count > 0
    assign loop_finite = true
  endif

  if lazyload
    assign classes = classes | append: ' js-core-video-lazyload'
  endif

  if largest_contentful_paint
    assign preload = 'metadata'
    assign preload_poster = true
    assign fetchpriority = 'high'
  endif

  if video_mobile
    for source in video_mobile.sources
      assign source_mime_type = source.mime_type | downcase
      if source_mime_type contains 'mpegurl' or source.url contains '.m3u8'
        assign preferred_mobile_source = source
        break
      endif
    endfor
  endif

  if video
    for source in video.sources
      assign source_mime_type = source.mime_type | downcase
      if source_mime_type contains 'mpegurl' or source.url contains '.m3u8'
        assign preferred_desktop_source = source
        break
      endif
    endfor
  endif
%}

