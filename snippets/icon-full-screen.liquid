{% liquid
  assign width = width | default: 21
  assign height = height | default: 20
  assign fill = fill | default: 'currentColor'

  assign title_fallback = 'accessibility.icons.full_screen' | t
  assign title = title | default: title_fallback
%}

<svg
  width="{{ width }}"
  height="{{ height }}"
  viewBox="0 0 21 20"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-labelledby="full-screen"
>
  <title id="full-screen">{{ title }}</title>
  <path d="M13.1667 2.00024H18.5V7.33358M7.83333 2.00024H2.5V7.33358M2.5 12.6669V18.0002H7.83333M13.1667 18.0002H18.5V12.6669" stroke="{{ fill }}" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
