<!-- snippets/component__rating.liquid -->
{% comment %}
  Rating component.

  Accepts:
    - product: {object} Product object

  Visibility is controlled per-product by the `custom.hide_reviews_summary`
  metafield. When it is explicitly set to `true` the summary is omitted;
  when it is missing or false the summary renders.

  Usage:
    {% render 'product-review-ratings', product: product %}
{% endcomment %}

{% liquid
  # `.value` is a rating object (not a number): use `.rating` and optional `.scale_max`.
  # Stars: cap at max; decimal ≥0.5 → extra full; else integer fulls; (0,0.5) decimal → one half.
  assign rating_meta = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | times: 1

  assign hide_ratings = product.metafields.custom.hide_reviews_summary.value

  assign max_stars = 5
  if rating_meta != blank and rating_meta.scale_max != blank
    assign max_stars = rating_meta.scale_max | times: 1 | round
  endif

  assign star_filled_count = 0
  assign star_half_count = 0

  unless rating_meta.rating == blank
    assign score = rating_meta.rating | times: 1
    assign whole = score | floor
    assign frac = score | minus: whole

    if score >= max_stars
      assign star_filled_count = max_stars
    elsif frac >= 0.5
      assign star_filled_count = whole | plus: 1 | at_most: max_stars
    else
      assign star_filled_count = whole
    endif

    if score < max_stars and frac > 0 and frac < 0.5
      assign star_half_count = 1
    endif
  endunless

  assign half_star_slot = star_filled_count | plus: 1

  assign sr_rating_summary = ''
  if rating_meta != blank and rating_meta.rating != blank
    assign sr_rating_summary = 'products.reviews.rating_sr_rated' | t: rating: rating_meta.rating, max_stars: max_stars, count: rating_count
  elsif rating_count > 0
    assign sr_rating_summary = 'products.reviews.rating_sr_reviews_only' | t: count: rating_count
  else
    assign sr_rating_summary = 'products.reviews.rating_sr_none' | t
  endif
%}

{% unless hide_ratings %}
  <div class="tvg_product_review_ratings_kZ8eYW_root">
    <p class="tvg_product_review_ratings_kZ8eYW_sr-summary">{{ sr_rating_summary }}</p>
    <div class="tvg_product_review_ratings_kZ8eYW_rating-stars" aria-hidden="true" data-rating-stars>
      {% for slot in (1..max_stars) %}
        {% if slot <= star_filled_count %}
          {% render 'icon-star-filled' %}
        {% elsif star_half_count == 1 and slot == half_star_slot %}
          {% render 'icon-star-half' %}
        {% else %}
          {% render 'icon-star-empty' %}
        {% endif %}
      {% endfor %}
    </div>
    <span class="tvg_product_review_ratings_kZ8eYW_rating-count" aria-hidden="true" data-rating-count>
      {{- rating_count | escape }}
      {% if rating_count > 1 or rating_count == 0 %}
        {{- 'products.reviews.reviews' | t -}}
      {% else %}
        {{- 'products.reviews.review' | t -}}
      {% endif %}
    </span>
  </div>
{% endunless %}
