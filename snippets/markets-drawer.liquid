          if selected_currency == 'EUR'
            assign markets_selected_in_list = true
          endif
        endif
        continue
      endif

      assign markets_token_country_iso = ''
      for country in localization.available_countries
        if country.iso_code == token
          assign markets_token_country = country
          assign markets_token_country_iso = country.iso_code
          break
        endif
      endfor

      if markets_token_country_iso == ''
        continue
