{% # DO NOT EDIT: This file is auto-generated and will be overwritten. [build-fingerprint:assets:source={_js/snippets/product-accordion/snippet.liquid}] %}

<div class="portable-snippet" data-snippet-name="product-accordion">

{% doc %}
  Product Accordion

  Renders a reusable, single-open accordion. Each item has a label (single
  line text) and a rich-text description. The first item is expanded by default
  and only one item can be open at a time.

  The snippet is data-source agnostic: pass `items` either as a metafield or as an already-unwrapped list.
  Each item is expected to expose a `label` and a `description` field

  Nothing is rendered when there are no valid items.

  @param {metafield|metaobject[]} [items] - A metafield whose `.value` is a list of accordion items, or the list itself.
  @param {string} [id] - Base id used to build unique element ids (default: 'product-accordion').
  @param {boolean} [first_expanded] - Whether the first item is expanded by default (default: true).

  Only one item is open at a time: opening an item closes the others, and clicking the open item collapses it, leaving
  all items closed.

  @example
  {% render 'product-accordion',
    items: product.metafields.custom.pdp_product_accordions
  %}

  {% render 'product-accordion',
    items: product.metafields.custom.pdp_product_accordions.value
  %}
{% enddoc %}

{% liquid
  assign accordion_items = items | default: blank

  if accordion_items.value != blank
    assign accordion_items = accordion_items.value
  endif

  assign base_id = id | default: 'product-accordion'
  assign first_expanded = first_expanded | default: true, allow_false: true

  assign valid_count = 0
  if accordion_items != blank
    for item in accordion_items
      assign item_label = item.label.value | default: item.label
      if item_label != blank and item.description != blank
        assign valid_count = valid_count | plus: 1
      endif
    endfor
  endif
%}

{% if valid_count > 0 %}
  {% render 'product-accordion-stylesheet' %}

  <div class="tvg_product_accordion__FysSG_root">
    <div class="tvg_product_accordion__FysSG_list">
      {% liquid
        assign render_index = 0
        assign expand_next = first_expanded
      %}
      {% for item in accordion_items %}
        {% liquid
          assign label = item.label.value | default: item.label
        %}
        {% if label != blank and item.description != blank %}
          {% liquid
            assign render_index = render_index | plus: 1
            assign is_expanded = false

            if expand_next
              assign is_expanded = true
              assign expand_next = false
            endif

            assign button_id = base_id | append: '-button-' | append: render_index
            assign panel_id = base_id | append: '-panel-' | append: render_index
          %}
          <div class="tvg_product_accordion__FysSG_item">
            <h3 class="tvg_product_accordion__FysSG_itemTitle">
              <button
                id="{{ button_id }}"
                class="tvg_product_accordion__FysSG_trigger js-product-accordion-trigger"
                type="button"
                aria-expanded="{% if is_expanded %}true{% else %}false{% endif %}"
                aria-controls="{{ panel_id }}"
                data-product-accordion-trigger="{{ render_index }}"
              >
                <span class="tvg_product_accordion__FysSG_label">{{ label }}</span>
                <span class="tvg_product_accordion__FysSG_icon" aria-hidden="true">
                  {% render 'svg-accordion-chevron' %}
                </span>
              </button>
            </h3>
            <div
              id="{{ panel_id }}"
              class="tvg_product_accordion__FysSG_panel js-product-accordion-panel"
              role="region"
              aria-labelledby="{{ button_id }}"
              data-product-accordion-panel="{{ render_index }}"
              {% unless is_expanded %}
                hidden
              {% endunless %}
            >
              <div class="tvg_product_accordion__FysSG_description">
                <div class="tvg_product_accordion__FysSG_descriptionBody o-rte">
                  {{ item.description | metafield_tag }}
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

</div>
