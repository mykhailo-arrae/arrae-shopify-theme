

{%- assign block_settings = block.settings -%}
{{ 'yotpo-variants-data.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign filtered_selling_plan_groups = product.selling_plan_groups | where: "app_id", "5284869"
  assign free_shipping_notice_money = shipping_value_left
  assign one_time_price = product.selected_or_first_available_variant.price | times: 0.001 | money | append: "</strong>" | prepend: "<strong>"
  assign one_time_price_message = block.settings.one_time_content | replace: "$0", free_shipping_notice_money
%}
{% if filtered_selling_plan_groups != blank %}
  <div class="product-subscription__block" {{ block.shopify_attributes }}>
    <p class="product-subscription__block-title">Frequency</p>
    {% for group in filtered_selling_plan_groups %}
      <label class="block__element block__element--subscription">
        <span class="subscription__info">
          <span class="subscription__info-top">
            <input
                    type="radio"
                    name="purchase_option"
                    class="purchase_option_subscribe input-subscription"
                    checked
                    value="{{ group.id }}">
            <span class="custom__input-radio">
              <svg
                      width="15"
                      height="15"
                      viewBox="0 0 15 15"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg">
                <rect
                        x="0.0219727"
                        y="0.332153"
                        width="14.4746"
                        height="14.4746"
                        rx="7.2373"
                        fill="rgba(40, 70, 81, 1)"/>
              </svg>
            </span>
            <span class="subscribe__option-title">
              {% if block.settings.subscription_text != blank %}
                <div class="subscribe__option-title__wrapper">{{ block.settings.subscription_text }}
                  <div class="subscribe__option-title-discount">10% off</div>
                </div>
              {% else %}
                {{ group.name }}
              {% endif %}
            </span>

            <span class="subscription-price__wrapper">
              <span
                      id="subscription-price-{{ section.id }}"
                      role="status"
                      class="subscription__price">
                <!-- <span class="original__price">{{ product.selected_or_first_available_variant.selling_plan_allocations[0].compare_at_price | money }}</span> -->
                <span class="sale__price">{{ product.selected_or_first_available_variant.selling_plan_allocations[0].price_adjustments[0].price | money }}</span>
              </span>
            </span>
          </span>

          <span class="subscription__option-content-wrapper">
            {% for i in (1..5) %}
              {%- capture subscription_advantages -%}subscription_advantages_point_{{ i }}{%- endcapture -%}
              {% if block.settings[subscription_advantages] != blank %}
                {%- liquid
                  if block.settings[subscription_advantages] contains '$0'
                    assign one_time_price = product.selected_or_first_available_variant.selling_plan_allocations[0].price_adjustments[0].price | times: 0.001 | append: "</strong>" | prepend: "<strong>"
                    assign one_time_price_message = block.settings[subscription_advantages] | replace: "$0", one_time_price
                  endif
                %}
                <span class="subscription__option-content-item">
                  <svg
                          width="15"
                          height="14"
                          viewBox="0 0 15 14"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.29101 6.44485C2.03213 6.44557 1.77875 6.51958 1.56018 6.6583C1.3416 6.79703 1.16677 6.9948 1.05591 7.22874C0.945044 7.46268 0.90268 7.72323 0.933718 7.98024C0.964756 8.23726 1.06793 8.48023 1.23129 8.68106L4.71389 12.9472C4.83806 13.1014 4.99723 13.2237 5.17817 13.3041C5.35912 13.3844 5.55661 13.4204 5.75425 13.409C6.17697 13.3863 6.5586 13.1602 6.80192 12.7884L14.0362 1.13767C14.0373 1.13574 14.0386 1.13381 14.0399 1.1319C14.1077 1.02768 14.0857 0.821144 13.9456 0.691394C13.9071 0.655763 13.8617 0.628388 13.8123 0.610956C13.7628 0.593524 13.7103 0.586403 13.658 0.590032C13.6057 0.593662 13.5546 0.607964 13.508 0.632059C13.4615 0.656154 13.4203 0.689531 13.3871 0.730134C13.3845 0.733326 13.3818 0.736471 13.3791 0.739567L6.08325 8.98276C6.05548 9.01413 6.02177 9.03967 5.98405 9.05789C5.94634 9.07612 5.90538 9.08667 5.86355 9.08894C5.82172 9.0912 5.77986 9.08513 5.7404 9.07107C5.70094 9.05702 5.66466 9.03527 5.63368 9.00708L3.21233 6.80363C2.96085 6.57311 2.63217 6.44511 2.29101 6.44485Z"
                          fill="#EF5E3C"/>
                  </svg>
                  <span>
                    {% if block.settings[subscription_advantages] contains '$0' %}
                      {{ one_time_price_message }}
                    {% else %}
                      {{ block.settings[subscription_advantages] }}
                    {% endif %}
                  </span>
                </span>
              {% endif %}
            {% endfor %}
          </span>
        </span>
        <span class="subscription__select-wrapper">
          <span class="subscription__select-title">
            Delivery every:
          </span>
          <span class="subscription__select">
            {% for plan in group.selling_plans %}
              {% unless plan.name contains "{{H}}" %}
                {% unless plan.options[0].value contains "{{H}}" %}
                  {% liquid
                    assign plan_name = plan.name
                    if plan.name == 'Every 1 week'
                      assign plan_name = 'Weekly'
                    elsif plan.name == 'Every 2 weeks'
                      assign plan_name = 'Bi-weekly'
                    elsif plan.name == 'Every 1 month'
                      assign plan_name = 'Monthly'
                    else
                      assign plan_name = plan.name
                    endif
                  %}
                  <button
                          type="button"
                          class="subscription__plan-button {% if forloop.index0 == 0 %}active{% endif %}"
                          data-plan-id="{{ plan.id }}"
                          data-seilling-plan-count="{{ plan.price_adjustments[0].value }}"
                          data-option-position="{{ forloop.index0 }}">{{ plan_name }}</button>
                {% endunless %}
              {% endunless %}
            {% endfor %}
          </span>
        </span>
      </label>

                            <label class="block__element">
        <span class="subscription__info">

          <span class="subscription__info-top">
            <input
                    type="radio"
                    name="purchase_option"
                    class="purchase_option_one-time input-subscription"
                    value="">
            <span class="custom__input-radio">
              <svg
                      width="15"
                      height="15"
                      viewBox="0 0 15 15"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg">
                <rect
                        x="0.0219727"
                        y="0.332153"
                        width="14.4746"
                        height="14.4746"
                        rx="7.2373"
                        fill="rgba(40, 70, 81, 1)"/>
              </svg>
            </span>
            <span class="one-time__option-title">
              {{ block.settings.one_time_text }}
            </span>

            <span class="one-time-price__wrapper">
              <span
                      id="one-time-price-{{ section.id }}"
                      role="status"
                      class="subscription__price">
                <span class="sale__price">{{ product.selected_or_first_available_variant.price | money }}</span>
              </span>
            </span>
          </span>

          {% if block.settings.one_time_content != blank %}
            {%- liquid
              if block.settings.one_time_content contains '$0'
                assign one_time_price = product.selected_or_first_available_variant.price | times: 0.001 | append: "</strong>" | prepend: "<strong>"
                assign one_time_price_message = block.settings.one_time_content | replace: "$0", one_time_price
              endif
            %}
            <span class="subscription__option-content-wrapper">
              <span class="subscription__option-content-item">
                {% comment %}<svg width="13" height="10" viewBox="0 0 13 10" fill="none" xmlns="http://www.w3.org/2000/svg">{% endcomment %}
                {% comment %}<path d="M11.833 1.53009L5.07099 8.38671L1.89301 5.02718" stroke="#151414" stroke-width="2" stroke-linecap="round"/>{% endcomment %}
                {% comment %}</svg>{% endcomment %}
                <span>
                  {% if block.settings.one_time_content contains '$0' %}
                    {{ one_time_price_message }}
                  {% else %}
                    {{ block.settings.one_time_content }}
                  {% endif %}
                </span>
              </span>
            </span>
          {% endif %}
        </span>
      </label>
    {% endfor %}
  </div>

  <script>
      document.addEventListener('DOMContentLoaded', function () {
          const subscribeOption = document.querySelector('.purchase_option_subscribe');
          const oneTimeOption = document.querySelector('.purchase_option_one-time');
          const sellingPlanInput = document.querySelector('.selling_plan_input');
          const planButtons = document.querySelectorAll('.subscription__plan-button');

          function updateWidgetContent() {
              let currentVariant = JSON.parse(document.querySelector('.product [data-selected-variant]').innerHTML);
              let activePlanPosition = Number(document.querySelector('.subscription__plan-button.active').dataset.optionPosition);
              // if (currentVariant.price < currentVariant.compare_at_price) {
              //     document.querySelector('.one-time-price__wrapper .original__price').style.display = 'block';
              // } else {
              //     document.querySelector('.one-time-price__wrapper .original__price').style.display = 'none';
              // }
              // document.querySelector('.one-time-price__wrapper .sale__price').innerHTML = Shopify.formatMoney(currentVariant.price);
              // document.querySelector('.one-time-price__wrapper .original__price').innerHTML = Shopify.formatMoney(currentVariant.compare_at_price);
              // document.querySelector('.subscription-price__wrapper .sale__price').innerHTML = Shopify.formatMoney(currentVariant.selling_plan_allocations[activePlanPosition].price);
              // document.querySelector('.subscription-price__wrapper .original__price').innerHTML = Shopify.formatMoney(currentVariant.selling_plan_allocations[activePlanPosition].compare_at_price);
          }


          planButtons.forEach(button => {
              button.addEventListener('click', function () {
                  planButtons.forEach((btn) => btn.classList.remove('active'));
                  subscribeOption.checked = true;
                  button.classList.add('active');
                  sellingPlanInput.value = button.dataset.planId;
                  checkActiveOption();
              });
          });

          function checkActiveOption() {
              if (subscribeOption.checked) {
                  sellingPlanInput.value = document.querySelector('.subscription__plan-button.active').dataset.planId;
              } else if (oneTimeOption.checked) {
                  sellingPlanInput.value = '';
              }
              updateWidgetContent();
          }


          subscribeOption.addEventListener('change', checkActiveOption);
          oneTimeOption.addEventListener('change', checkActiveOption);
          window.addEventListener('variant:change', updateWidgetContent);
          window.addEventListener('load', checkActiveOption);

          // Initialize on load
          checkActiveOption();
      });
  </script>

  <script type="application/json" data-selected-variant>{{ product.selected_or_first_available_variant | json }}</script>
{% endif %}
<div
  id="ProductInformation-{{ section.id }}"
  class="
    product-details
    {% if block_settings.sticky_details_desktop %} sticky-content--desktop{% endif %}
    {% if block_settings.height == 'fill' -%} full-height--desktop{% endif -%}
  "
  style="--details-position: {{ block_settings.details_position }};"
  data-testid="product-information-details"
  {% if settings.transition_to_main_product %}
    data-view-transition-type="product-details"
  {% endif %}
>
  {% capture children %}
    <div class="view-product-title">
      <a
        href="{{ product.selected_or_first_available_variant.url }}"
        class="link"
      >
        {{- product.title }}
      </a>
    </div>
    {% content_for 'blocks' %}
  {% endcapture %}

  {% render 'group', children: children, settings: block_settings, shopify_attributes: block.shopify_attributes %}
</div>

{% stylesheet %}
  /* Clear padding on mobile, if not full-width */
  @media screen and (max-width: 749px) {
    .product-information.section--page-width .product-details > .group-block {
      padding-inline: 0;
    }
  }

  .view-product-title {
    display: none;
  }

  /* Container styles */
  .product-details {
    display: flex;
    align-self: start;
    justify-content: center;
  }

  @media screen and (min-width: 750px) {
    .product-details > .group-block {
      height: min-content;
    }

    .full-height--desktop {
      height: 100%;
      max-height: calc(100vh - var(--header-group-height, 0));
      min-height: fit-content;
    }

    .full-height--desktop .group-block {
      align-self: var(--details-position, 'flex-start');
    }
  }
{% endstylesheet %}

