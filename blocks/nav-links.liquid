{% liquid
  assign heading = block.settings.heading
  assign menu_handle = block.settings.menu
  assign links = linklists[menu_handle].links | default: empty
  assign total_links = links.size
  assign multi_column_threshold = 5
  assign use_multi_column = false
  if total_links > multi_column_threshold
    assign use_multi_column = true
    assign split_at = total_links | divided_by: 2.0 | ceil
  endif

  assign mobile_trigger_id = 'nav-links-trigger-' | append: block.id
  assign mobile_content_id = 'nav-links-content-' | append: block.id

  assign has_heading = false
  if heading != blank
    assign has_heading = true
  endif
%}

<div class="tvg_nav_links_C5T6DG_root" data-multi-column="{{ use_multi_column }}">
  {% if has_heading %}
    {% comment %}
      Desktop: visible heading above the list(s). CSS hides this on
      mobile, where the heading turns into an accordion trigger below.
    {% endcomment %}
    <h3 class="tvg_nav_links_C5T6DG_heading">{{ heading }}</h3>

    {% comment %}
      Mobile: accordion trigger when a heading is configured. Lists
      without a heading render flat (no trigger).
    {% endcomment %}
    <button
      type="button"
      id="{{ mobile_trigger_id }}"
      class="tvg_nav_links_C5T6DG_mobile-trigger js-mobile-accordion-trigger"
      aria-expanded="false"
      aria-controls="{{ mobile_content_id }}"
    >
      <span class="tvg_nav_links_C5T6DG_mobile-trigger__label">{{ heading }}</span>
      <span class="tvg_nav_links_C5T6DG_mobile-trigger__icon" aria-hidden="true">
        {% render 'icon-chevron-bottom', width: 24, height: 24 %}
      </span>
    </button>
  {% endif %}

  {% if links.size > 0 %}
    <div
      class="tvg_nav_links_C5T6DG_content"
      {% if has_heading %}
        id="{{ mobile_content_id }}"
        aria-labelledby="{{ mobile_trigger_id }}"
        aria-hidden="true"
      {% endif %}
    >
      <div class="tvg_nav_links_C5T6DG_lists">
        {% if use_multi_column %}
          {% comment %}
            Two balanced columns on desktop preserve original ordering:
            items 1..split_at in the first list, the remainder in the
            second. On mobile the column rule is overridden so all
            links flow in a single vertical list.
          {% endcomment %}
          <ul class="tvg_nav_links_C5T6DG_list" role="list">
            {% for link in links limit: split_at %}
              <li class="">
                <a
                  href="{{ link.url }}"
                  class="tvg_nav_links_C5T6DG_link"
                  {% if link.active %}
                    aria-current="page"
                  {% endif %}
                >
                  <span class="tvg_nav_links_C5T6DG_link__text">{{ link.title }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
          <ul class="tvg_nav_links_C5T6DG_list" role="list">
            {% for link in links offset: split_at %}
              <li class="">
                <a
                  href="{{ link.url }}"
                  class="tvg_nav_links_C5T6DG_link"
                  {% if link.active %}
                    aria-current="page"
                  {% endif %}
                >
                  <span class="tvg_nav_links_C5T6DG_link__text">{{ link.title }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <ul class="tvg_nav_links_C5T6DG_list" role="list">
            {% for link in links %}
              <li class="">
                <a
                  href="{{ link.url }}"
                  class="tvg_nav_links_C5T6DG_link"
                  {% if link.active %}
                    aria-current="page"
                  {% endif %}
                >
                  <span class="tvg_nav_links_C5T6DG_link__text">{{ link.title }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  {% endif %}
</div>

