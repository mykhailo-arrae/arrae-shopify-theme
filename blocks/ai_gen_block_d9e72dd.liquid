{% doc %}
  @prompt
    subscription block to handle subscription, pls turn this into a theme blocks + use selling plans for this instead of cutstom ones

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-subscription-block-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;}

  .ai-subscription-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-subscription-header-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-subscription-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 12px 0;
    font-weight: 600;
  }

  .ai-subscription-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    opacity: 0.8;
    margin: 0;
  }

  .ai-subscription-plans-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .ai-subscription-plan-{{ ai_gen_id }} {
    background-color: {{ block.settings.plan_background_color }};
    border: 2px solid {{ block.settings.plan_border_color }};
    border-radius: {{ block.settings.plan_border_radius }}px;
    padding: 24px;
    text-align: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
  }

  .ai-subscription-plan-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
  }

  .ai-subscription-plan-{{ ai_gen_id }}.featured {
    border-color: {{ block.settings.featured_border_color }};
    background-color: {{ block.settings.featured_background_color }};
  }

  .ai-subscription-plan-badge-{{ ai_gen_id }} {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.featured_border_color }};
    color: {{ block.settings.featured_badge_text_color }};
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .ai-subscription-plan-name-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 8px 0;
  }

  .ai-subscription-plan-price-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 4px 0;
  }

  .ai-subscription-plan-period-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    opacity: 0.7;
    margin: 0 0 16px 0;
  }

  .ai-subscription-plan-features-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
  }

  .ai-subscription-plan-feature-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    padding: 8px 0;
    border-bottom: 1px solid {{ block.settings.plan_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .ai-subscription-plan-feature-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-subscription-plan-feature-icon-{{ ai_gen_id }} {
    color: {{ block.settings.feature_icon_color }};
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .ai-subscription-plan-button-{{ ai_gen_id }} {
    width: 100%;
    padding:12px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-decoration: none;
    display: inline-block;
    text-align: center;
  }

  .ai-subscription-plan-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-subscription-plan-{{ ai_gen_id }}.featured .ai-subscription-plan-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.featured_button_color }};
    color: {{ block.settings.featured_button_text_color }};
  }

  .ai-subscription-plan-{{ ai_gen_id }}.featured .ai-subscription-plan-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.featured_button_hover_color }};
  }

  .ai-subscription-footer-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 24px;
  }

  .ai-subscription-footer-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    opacity: 0.7;
    margin: 0;
  }

  .ai-subscription-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  .ai-subscription-empty-state-{{ ai_gen_id }} h3 {
    margin: 0 0 8px 0;
    font-size: 18px;
  }

  .ai-subscription-empty-state-{{ ai_gen_id }} p {
    margin: 0;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-subscription-plans-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
    .ai-subscription-block-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }
  }
{% endstyle %}

<subscription-plans-{{ ai_gen_id }}
  class="ai-subscription-block-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-subscription-content-{{ ai_gen_id }}">
    <div class="ai-subscription-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-subscription-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <p class="ai-subscription-description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
      {% endif %}
    </div>

    {% if block.settings.product != blank and block.settings.product.selling_plan_groups.size > 0 %}
      <div class="ai-subscription-plans-{{ ai_gen_id }}">
        {% for selling_plan_group in block.settings.product.selling_plan_groups %}
          {% for selling_plan in selling_plan_group.selling_plans %}
            {% assign is_featured = false %}
            {% if block.settings.featured_plan_id != blank and selling_plan.id == block.settings.featured_plan_id %}
              {% assign is_featured = true %}
            {% endif %}

            <div class="ai-subscription-plan-{{ ai_gen_id }} {% if is_featured %}featured{% endif %}">
              {% if is_featured %}
                <div class="ai-subscription-plan-badge-{{ ai_gen_id }}">
                  {{ block.settings.featured_badge_text }}
                </div>
              {% endif %}

              <h3 class="ai-subscription-plan-name-{{ ai_gen_id }}">{{ selling_plan.name }}</h3>

              {% assign plan_price = block.settings.product.price | times: selling_plan.price_adjustments.first.value | divided_by: 100.0 %}
              <div class="ai-subscription-plan-price-{{ ai_gen_id }}">
                {{ plan_price | money }}
              </div>

              <div class="ai-subscription-plan-period-{{ ai_gen_id }}">
                {% case selling_plan.options.first.value %}
                  {% when 'week' %}
                    per week
                  {% when 'month' %}
                    per month
                  {% when 'year' %}
                    per year
                  {% else %}
                    {{ selling_plan.options.first.value }}
                {% endcase %}
              </div>

              {% if selling_plan.description != blank %}
                <ul class="ai-subscription-plan-features-{{ ai_gen_id }}">
                  {% assign features = selling_plan.description | split: ',' %}
                  {% for feature in features %}
                    <li class="ai-subscription-plan-feature-{{ ai_gen_id }}"><svg class="ai-subscription-plan-feature-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20,6 9,17 4,12"></polyline>
                      </svg>
                      {{ feature | strip }}
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}

              <button
                class="ai-subscription-plan-button-{{ ai_gen_id }}"
                data-selling-plan-id="{{ selling_plan.id }}"
                data-product-id="{{ block.settings.product.id }}"
                data-variant-id="{{ block.settings.product.selected_or_first_available_variant.id }}"
              >
                {{ block.settings.button_text }}
              </button>
            </div>
          {% endfor %}
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-subscription-empty-state-{{ ai_gen_id }}">
        <h3>No subscription plans available</h3>
        <p>Select a product with selling plans to display subscription options</p>
      </div>
    {% endif %}

    {% if block.settings.footer_text != blank %}
      <div class="ai-subscription-footer-{{ ai_gen_id }}">
        <p class="ai-subscription-footer-text-{{ ai_gen_id }}">{{ block.settings.footer_text }}</p>
      </div>
    {% endif %}
  </div>
</subscription-plans-{{ ai_gen_id }}><script>
  (function() {
    classSubscriptionPlans{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.planButtons = this.querySelectorAll('.ai-subscription-plan-button-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.planButtons.forEach((button) => {
          button.addEventListener('click', (event) => {
            event.preventDefault();
            
            const sellingPlanId = button.getAttribute('data-selling-plan-id');
            const productId = button.getAttribute('data-product-id');
            const variantId = button.getAttribute('data-variant-id');
            
            this.addToCart(productId, variantId, sellingPlanId);
          });
        });
      }

      addToCart(productId, variantId, sellingPlanId) {
        const formData = {
          'items': [{
            'id': variantId,
            'quantity': 1,
            'selling_plan': sellingPlanId
          }]
        };

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(formData)
        })
        .then(response => response.json())
        .then(data => {
          const customEvent = new CustomEvent('subscription-added-to-cart', {
            detail: { 
              sellingPlanId: sellingPlanId,
              productId: productId,
              variantId: variantId,
              cartData: data
            },
            bubbles: true
          });
          this.dispatchEvent(customEvent);

          if (window.theme && window.theme.cart && window.theme.cart.refresh) {
            window.theme.cart.refresh();
          } else {
            window.location.href = '/cart';
          }
        })
        .catch((error) => {
          console.error('Error adding subscription to cart:', error);
        });
      }
    }

    customElements.define('subscription-plans-{{ ai_gen_id }}', SubscriptionPlans{{ ai_gen_id }});
  })();
</script>

